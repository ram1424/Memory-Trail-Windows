<Window x:Class="MemoryLane.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Trail"
        Width="540" Height="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        FontFamily="Segoe UI Variable Text">
  <Window.Resources>
    <Storyboard x:Key="EntranceStoryboard">
      <DoubleAnimation Storyboard.TargetName="Shell"
                       Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.22"/>
      <DoubleAnimation Storyboard.TargetName="ShellScale"
                       Storyboard.TargetProperty="ScaleX"
                       From="0.985" To="1" Duration="0:0:0.28">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="ShellScale"
                       Storyboard.TargetProperty="ScaleY"
                       From="0.985" To="1" Duration="0:0:0.28">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="LoadingTranslate"
                       Storyboard.TargetProperty="X"
                       From="-92" To="310"
                       Duration="0:0:1.45"
                       RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </Window.Resources>

  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Storyboard="{StaticResource EntranceStoryboard}"/>
    </EventTrigger>
  </Window.Triggers>

  <Border x:Name="Shell"
          Opacity="0"
          Background="#F9FBFE"
          BorderBrush="#D6E0EC"
          BorderThickness="1"
          CornerRadius="30"
          SnapsToDevicePixels="True">
    <Border.RenderTransform>
      <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1" CenterX="260" CenterY="180"/>
    </Border.RenderTransform>
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.18" Color="#20304A"/>
    </Border.Effect>

    <Grid ClipToBounds="True">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FBFDFF" Offset="0"/>
          <GradientStop Color="#F0F5FD" Offset="0.52"/>
          <GradientStop Color="#E4ECF9" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>

      <Ellipse Width="300" Height="300"
               Fill="#D9E8FF"
               Opacity="0.38"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,-170,-120,0"/>
      <Ellipse Width="230" Height="230"
               Fill="#DFF5F4"
               Opacity="0.36"
               HorizontalAlignment="Left"
               VerticalAlignment="Bottom"
               Margin="-125,0,0,-125"/>

      <Grid Margin="44,34,44,32">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Width="112" Height="112"
                  Background="#FFFFFF"
                  BorderBrush="#DFE7F1"
                  BorderThickness="1"
                  CornerRadius="28"
                  Padding="7">
            <Border.Effect>
              <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.16" Color="#304664"/>
            </Border.Effect>
            <Image x:Name="BrandLogo"
                   Width="98" Height="98"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>

          <TextBlock Text="Memory Trail"
                     FontSize="29"
                     FontWeight="Bold"
                     Foreground="#1A2438"
                     HorizontalAlignment="Center"
                     Margin="0,20,0,0"/>

          <TextBlock Text="Your workday, remembered locally."
                     FontSize="12.5"
                     Foreground="#66778F"
                     HorizontalAlignment="Center"
                     Margin="0,6,0,0"/>

          <Border Background="#EEF8F4"
                  BorderBrush="#D7ECE2"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="10,5"
                  Margin="0,17,0,0"
                  HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBlock Text="Private • Local • On-device"
                         FontSize="10.5"
                         FontWeight="SemiBold"
                         Foreground="#39725B"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <TextBlock x:Name="StatusText"
                     Text="Starting Memory Trail…"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="#40506A"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,10"/>

          <Border Width="300"
                  Height="5"
                  Background="#DFE7F1"
                  CornerRadius="3"
                  HorizontalAlignment="Center"
                  ClipToBounds="True">
            <Canvas Width="300" Height="5" ClipToBounds="True">
              <Border Width="92"
                      Height="5"
                      CornerRadius="3">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2AA8F8" Offset="0"/>
                    <GradientStop Color="#1680FF" Offset="0.48"/>
                    <GradientStop Color="#6A7BFA" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                  <TranslateTransform x:Name="LoadingTranslate" X="-92"/>
                </Border.RenderTransform>
              </Border>
            </Canvas>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>