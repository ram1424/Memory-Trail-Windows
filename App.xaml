<Application x:Class="MemoryLane.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- Exact Windows translation of MemoryTrailPalette from macOS RootView.swift -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#E8EEF9"/>
    <SolidColorBrush x:Key="BackgroundBottomBrush" Color="#DBE6F4"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#E3EBF7"/>
    <SolidColorBrush x:Key="SidebarBottomBrush" Color="#D1DEF0"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#EBF1F9"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#F6F9FC"/>
    <SolidColorBrush x:Key="ElevatedStrongBrush" Color="#FBFCFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A2438"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#40506A"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#66778F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1680FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEBFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8E1EC"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#D0DAE7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D84A5A"/>

    <Style x:Key="ModernButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#26364E"/>
      <Setter Property="Background" Value="#F6F9FC"/>
      <Setter Property="BorderBrush" Value="#D8E1EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FBFCFF"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#C8D7E8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#E9F0F9"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
      <Setter Property="Background" Value="#1680FF"/>
      <Setter Property="BorderBrush" Value="#1680FF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#1A2438"/>
      <Setter Property="Padding" Value="13,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#E8EFF9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#F6F9FC"/>
      <Setter Property="BorderBrush" Value="#D8E1EC"/>
      <Setter Property="Foreground" Value="#40506A"/>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
      <Setter Property="Padding" Value="7"/>
      <Setter Property="MinWidth" Value="30"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#66778F"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}"/>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FBFCFF"/>
      <Setter Property="Foreground" Value="#1A2438"/>
      <Setter Property="BorderBrush" Value="#D8E1EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CaretBrush" Value="#1680FF"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#FBFCFF"/>
      <Setter Property="Foreground" Value="#1A2438"/>
      <Setter Property="BorderBrush" Value="#D8E1EC"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#40506A"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </Application.Resources>
</Application>