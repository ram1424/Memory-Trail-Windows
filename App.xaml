<Application x:Class="MemoryLane.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F6F8FC"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#EEF3F9"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#182235"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#607087"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D9E1EC"/>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#EDF3FF"/>
      <Setter Property="Foreground" Value="#1F4FAE"/>
      <Setter Property="BorderBrush" Value="#CBD9F4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182235"/>
      <Setter Property="BorderBrush" Value="#D5DEE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182235"/>
      <Setter Property="BorderBrush" Value="#D5DEE9"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#26364D"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </Application.Resources>
</Application>