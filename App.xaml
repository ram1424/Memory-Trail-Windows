<Application x:Class="MemoryLane.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF8F2"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F8EEE5"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFDFC"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#F5E7DA"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#2D241F"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6F6259"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#C76645"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E7D7C9"/>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#F6E3D8"/>
      <Setter Property="Foreground" Value="#8A412C"/>
      <Setter Property="BorderBrush" Value="#E5C5B5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182235"/>
      <Setter Property="BorderBrush" Value="#E7D7C9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182235"/>
      <Setter Property="BorderBrush" Value="#E7D7C9"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#3A302A"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </Application.Resources>
</Application>