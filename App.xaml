<Application x:Class="MemoryLane.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0F16"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#141A24"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#1B2330"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A6B0BF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5AA9FF"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
  </Application.Resources>
</Application>
