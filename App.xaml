<Application x:Class="MemoryLane.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#EAF4FF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0C1E46"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F8FBFF"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#DDEEFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#10203B"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A6D86"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="AccentAltBrush" Color="#2CC9FF"/>
    <SolidColorBrush x:Key="WarmAccentBrush" Color="#FFB65C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#C9DCF2"/>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#DCEEFF"/>
      <Setter Property="Foreground" Value="#0D4E9A"/>
      <Setter Property="BorderBrush" Value="#B8D6F6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#10203B"/>
      <Setter Property="BorderBrush" Value="#C9DCF2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#10203B"/>
      <Setter Property="BorderBrush" Value="#C9DCF2"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#20334E"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </Application.Resources>
</Application>