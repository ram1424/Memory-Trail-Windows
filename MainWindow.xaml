<Window x:Class="MemoryLane.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemoryLane.Windows"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Memory Trail v0.7.2"
        Width="1540" Height="900"
        MinWidth="1240" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
  <Window.Resources>
    <local:AppIconConverter x:Key="AppIconConverter"/>

    <Style x:Key="MetricCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#303846"/>
      <Setter Property="BorderBrush" Value="#4A5566"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <Style x:Key="FilterNavStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="TimelineChipStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="SummaryProgressStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Background" Value="#1F2630"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
              <Border x:Name="PART_Indicator"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="5"
                      HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="268"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- LEFT SIDEBAR -->
    <Border Grid.Column="0" Background="#202732" BorderBrush="#3D4655" BorderThickness="0,0,1,0">
      <Grid Margin="16,18,14,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,24">
          <Border Width="52" Height="52" Background="Transparent" Padding="4" ClipToBounds="False">
            <Image x:Name="BrandLogo" Width="42" Height="42" Stretch="Uniform"
                   SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Memory Trail" FontSize="20" FontWeight="SemiBold" Foreground="#FAF7F2"/>
            <TextBlock Text="v0.7.2" FontSize="10" Foreground="#AFA59B" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="TimelineNavButton" Tag="Timeline" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Background="#2C5E96" Foreground="White" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="30" FontSize="18"/>
              <TextBlock Text="Today" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
          <Button x:Name="SearchNavButton" Tag="Search" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Width="30"/>
              <TextBlock Text="Search"/>
            </StackPanel>
          </Button>
          <Button x:Name="FavoritesNavButton" Tag="Favorites" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" Width="30"/>
              <TextBlock Text="Favorites"/>
            </StackPanel>
          </Button>
          <Button x:Name="ClipboardNavButton" Tag="Clipboard" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" Width="30"/>
              <TextBlock Text="Clipboard"/>
            </StackPanel>
          </Button>
          <Button x:Name="NotesNavButton" Tag="Notes" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" Width="30"/>
              <TextBlock Text="Notes"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,18,0,12">
          <StackPanel>
            <Border Height="1" Background="#3D4655" Margin="6,0,6,16"/>
            <TextBlock Text="Filters" Foreground="#BFB6AD" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,8"/>

            <Button x:Name="AllAppsFilter" Content="▦   All Apps" Tag="All"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click"
                    Background="#343E4D"/>
            <Button x:Name="BrowserFilter" Content="◎   Web Browsers" Tag="Browser"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click"/>
            <Button x:Name="EmailFilter" Content="✉   Email" Tag="Email"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click"/>
            <Button x:Name="ChatFilter" Content="●   Chat &amp; Meetings" Tag="Chat"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click"/>
            <Button x:Name="FilesFilter" Content="▤   Files &amp; Documents" Tag="Files"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click"/>
            <Button x:Name="OfficeFilter" Content="▥   Productivity" Tag="Office"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click"/>

            <Border Height="1" Background="#3D4655" Margin="6,16"/>
            <Button x:Name="PrivacyNavButton" Tag="Privacy" Click="NavButton_Click"
                    Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Width="30"/>
                <TextBlock Text="Privacy"/>
              </StackPanel>
            </Button>
            <Button x:Name="SettingsNavButton" Tag="Settings" Click="NavButton_Click"
                    Style="{StaticResource NavButtonStyle}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="30"/>
                <TextBlock Text="Settings"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#303846" BorderBrush="#4A5566" BorderThickness="1"
                CornerRadius="14" Padding="12">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,8,0"/>
              <TextBlock x:Name="StatusText" FontSize="12" Foreground="#D0C8BF" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="PauseButton" Click="PauseButton_Click" Style="{StaticResource NavButtonStyle}"
                    Margin="0,7,0,0" Padding="0,7" HorizontalContentAlignment="Left"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- MAIN CONTENT -->
    <Grid Grid.Column="1" Margin="20">
      <Grid x:Name="ActivityShell">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Background="#2A313D" BorderBrush="#515D6D" BorderThickness="1"
                  CornerRadius="18" Padding="13,10" MaxWidth="700" HorizontalAlignment="Left">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#C7BDB4"
                         FontSize="17" VerticalAlignment="Center" Margin="2,0,10,0"/>
              <TextBox x:Name="SearchBox" Grid.Column="1"
                       BorderThickness="0" Background="Transparent"
                       Padding="0" FontSize="14"
                       TextChanged="SearchBox_TextChanged"
                       ToolTip="Search apps, websites, files, or keywords"/>
              <Border Grid.Column="2" Background="#3B4553" CornerRadius="7" Padding="8,4" Margin="10,0,0,0">
                <TextBlock Text="Ctrl + K" Foreground="#CFC6BD" FontSize="11"/>
              </Border>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="#4ADE80" Margin="0,0,7,0"/>
            <TextBlock Text="Capturing" Foreground="#F4EEE8" Margin="0,0,18,0"/>
            <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}}" Visibility="Collapsed"/>
            <TextBlock Text="Today" Foreground="#D8D0C8"/>
          </StackPanel>
        </Grid>

        <!-- HEADER -->
        <Grid Grid.Row="1" Margin="4,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Today" FontSize="32" FontWeight="SemiBold" Foreground="#FAF7F2"/>
            <TextBlock Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat={}{0:dddd, MMMM d, yyyy}}"
                       Foreground="#B7ADA3" FontSize="14" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Items.Count, ElementName=TimelineList}" Foreground="#D2C8BE"
                       FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text=" activities" Foreground="#AFA59B" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition x:Name="DetailsSpacerColumn" Width="16"/>
            <ColumnDefinition x:Name="DetailsColumn" Width="0.9*"/>
          </Grid.ColumnDefinitions>

          <!-- TIMELINE -->
          <Border Grid.Column="0" Background="#242B35" BorderBrush="#414B5B" BorderThickness="1"
                  CornerRadius="18" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                <TextBlock Text="☀" FontSize="25" Foreground="#FFB347" Margin="0,0,10,0"/>
                <StackPanel>
                  <TextBlock Text="Your activity timeline" Foreground="#F7F2EC" FontWeight="SemiBold" FontSize="17"/>
                  <TextBlock Text="Everything you touched, in order" Foreground="#AFA69D" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>

              <ListView x:Name="TimelineList" Grid.Row="1"
                        Background="Transparent" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="TimelineList_SelectionChanged"
                        MouseDoubleClick="TimelineList_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                          <Border x:Name="Row" Background="{TemplateBinding Background}"
                                  CornerRadius="14" Margin="1,3" Padding="0"
                                  BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="#303946"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="#2D4664"/>
                              <Setter TargetName="Row" Property="BorderBrush" Value="#4E9CF1"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid Height="66" Margin="10,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                      </Grid.ColumnDefinitions>

                      <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}"
                                 Foreground="#C2B8AE" FontSize="12" VerticalAlignment="Center"/>

                      <Border Grid.Column="1" Width="44" Height="44" Background="#1F2630" CornerRadius="11"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                               Width="36" Height="36" Stretch="Uniform"
                               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                      </Border>

                      <StackPanel Grid.Column="2" Margin="10,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceApp}" Foreground="#F7F2EC" FontWeight="SemiBold"
                                   FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Title}" Foreground="#B9B0A7" FontSize="12"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>

                      <Border Grid.Column="3" Style="{StaticResource TimelineChipStyle}"
                              Background="#34577E" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceKind}" Foreground="#EDF4FA" FontSize="11"/>
                      </Border>

                      <Button Grid.Column="4" Width="34" Height="34" Content="☆" FontSize="17"
                              Style="{StaticResource IconButtonStyle}" Tag="{Binding}"
                              Click="Favorite_Click" ToolTip="Favorite"
                              VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>

          <!-- RIGHT RAIL: SUMMARY + DETAILS -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition x:Name="DetailsGapRow" Height="12"/>
              <RowDefinition x:Name="DetailsRow" Height="*"/>
            </Grid.RowDefinitions>

            <!-- TODAY SUMMARY -->
            <Border Background="#242B35" BorderBrush="#414B5B" BorderThickness="1"
                    CornerRadius="18" Padding="16">
              <StackPanel>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="10" Background="#3A2F28" Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Border Width="4" Height="13" Background="#FF8A34" CornerRadius="2" Margin="0,0,3,0"/>
                      <Border Width="4" Height="21" Background="#FFA446" CornerRadius="2" Margin="0,0,3,0"/>
                      <Border Width="4" Height="16" Background="#FFB95E" CornerRadius="2"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Column="1" Text="Today Summary" Foreground="#F8F4EF"
                             FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="ShowDetailsButton" Grid.Column="2" Content="Details"
                          Style="{StaticResource ChipButtonStyle}" Click="ShowDetailsPane_Click"
                          Visibility="Collapsed" Padding="10,6" Margin="8,0,0,0"/>
                </Grid>

                <UniformGrid Columns="2" Margin="0,0,0,12">
                  <Border Style="{StaticResource MetricCardStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="10" Background="#234B72" VerticalAlignment="Center">
                        <TextBlock Text="▥" Foreground="#5CC8FF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalActivitiesText" Text="0" Foreground="#FAF7F2" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Total Activities" Foreground="#AAA097" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Style="{StaticResource MetricCardStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="10" Background="#244C77" VerticalAlignment="Center">
                        <TextBlock Text="▦" Foreground="#4E8FFF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AppsUsedText" Text="0" Foreground="#FAF7F2" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Apps Used" Foreground="#AAA097" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Style="{StaticResource MetricCardStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="18" Background="#20C5D6" VerticalAlignment="Center">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#10232A"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ActiveTimeText" Text="0m" Foreground="#FAF7F2" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Active Time" Foreground="#AAA097" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Style="{StaticResource MetricCardStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="10" Background="#D98A38" VerticalAlignment="Center">
                        <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" Foreground="#FFF2DF"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ClipboardItemsText" Text="0" Foreground="#FAF7F2" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Clipboard Items" Foreground="#AAA097" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </UniformGrid>

                <Grid Margin="2,2,2,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Top Apps" Foreground="#F4EFE9" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock Grid.Column="1" Text="Today" Foreground="#8CB9F1" FontSize="11"/>
                </Grid>

                <Grid Margin="2,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <Image x:Name="TopApp1Icon" Width="23" Height="23" Stretch="Uniform"/>
                  <TextBlock x:Name="TopApp1Name" Grid.Column="1" Foreground="#D8D0C8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="TopApp1Bar" Grid.Column="2" Style="{StaticResource SummaryProgressStyle}" Foreground="#249CFF" Margin="8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TopApp1Count" Grid.Column="3" Foreground="#C9C0B7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="2,5,2,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <Image x:Name="TopApp2Icon" Width="23" Height="23" Stretch="Uniform"/>
                  <TextBlock x:Name="TopApp2Name" Grid.Column="1" Foreground="#D8D0C8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="TopApp2Bar" Grid.Column="2" Style="{StaticResource SummaryProgressStyle}" Foreground="#37D39D" Margin="8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TopApp2Count" Grid.Column="3" Foreground="#C9C0B7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="2,5,2,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <Image x:Name="TopApp3Icon" Width="23" Height="23" Stretch="Uniform"/>
                  <TextBlock x:Name="TopApp3Name" Grid.Column="1" Foreground="#D8D0C8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="TopApp3Bar" Grid.Column="2" Style="{StaticResource SummaryProgressStyle}" Foreground="#7562F4" Margin="8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TopApp3Count" Grid.Column="3" Foreground="#C9C0B7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="2,5,2,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <Image x:Name="TopApp4Icon" Width="23" Height="23" Stretch="Uniform"/>
                  <TextBlock x:Name="TopApp4Name" Grid.Column="1" Foreground="#D8D0C8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="TopApp4Bar" Grid.Column="2" Style="{StaticResource SummaryProgressStyle}" Foreground="#FF9B48" Margin="8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TopApp4Count" Grid.Column="3" Foreground="#C9C0B7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="2,5,2,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <Image x:Name="TopApp5Icon" Width="23" Height="23" Stretch="Uniform"/>
                  <TextBlock x:Name="TopApp5Name" Grid.Column="1" Foreground="#D8D0C8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="TopApp5Bar" Grid.Column="2" Style="{StaticResource SummaryProgressStyle}" Foreground="#7A67F0" Margin="8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TopApp5Count" Grid.Column="3" Foreground="#C9C0B7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- DETAILS -->
            <Border x:Name="DetailsPanel" Grid.Row="2" Background="#242B35"
                    BorderBrush="#414B5B" BorderThickness="1" CornerRadius="18" Padding="16">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" Background="#1F2630" CornerRadius="12">
                      <Image Source="{Binding SelectedItem, ElementName=TimelineList, Converter={StaticResource AppIconConverter}}"
                             Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SelectedItem.SourceApp, ElementName=TimelineList, TargetNullValue=Select an activity}"
                                 Foreground="#F7F2EC" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SelectedItem.CreatedAt, ElementName=TimelineList, StringFormat={}{0:h:mm tt}}"
                                 Foreground="#AFA69D" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Width="38" Height="38" Padding="0"
                            Style="{StaticResource IconButtonStyle}" Click="HideDetailsPane_Click"
                            ToolTip="Close details" HorizontalAlignment="Right">
                      <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EFE9E2"/>
                    </Button>
                  </Grid>

                  <TextBlock Text="{Binding SelectedItem.Title, ElementName=TimelineList, TargetNullValue=Details appear here}"
                             Foreground="#FAF7F2" FontSize="16" FontWeight="SemiBold"
                             TextWrapping="Wrap" Margin="0,0,0,16"/>

                  <Border Height="1" Background="#3E4856" Margin="0,0,0,14"/>

                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="App" Foreground="#A89E94" FontSize="11" Margin="0,0,0,9"/>
                      <TextBlock Text="Time" Foreground="#A89E94" FontSize="11" Margin="0,0,0,9"/>
                      <TextBlock Text="Source" Foreground="#A89E94" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding SelectedItem.SourceApp, ElementName=TimelineList, TargetNullValue=—}" Foreground="#DDD5CD" FontSize="12" Margin="0,0,0,9"/>
                      <TextBlock Text="{Binding SelectedItem.CreatedAt, ElementName=TimelineList, StringFormat={}{0:MMM d, yyyy • h:mm:ss tt}}" Foreground="#DDD5CD" FontSize="12" Margin="0,0,0,9"/>
                      <TextBlock Text="{Binding SelectedItem.SourceUrl, ElementName=TimelineList, TargetNullValue=Local activity}" Foreground="#8CC5FF" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>

                  <Button Content="↗  Open Again" Click="OpenSelected_Click"
                          Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                  <Button Content="▣  Copy Title" Click="CopySelectedTitle_Click"
                          HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                  <Button Content="☆  Add to Favorites" Click="FavoriteSelected_Click"
                          HorizontalAlignment="Stretch"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- PRIVACY -->
      <ScrollViewer x:Name="PrivacyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="Privacy" FontSize="30" FontWeight="SemiBold" Foreground="#FAF7F2"/>
          <TextBlock Text="Memory Trail is local-first and gives you direct control over what is captured."
                     Margin="0,7,0,22" FontSize="14" Foreground="#B6ADA4"/>
          <Border Background="#2B3340" BorderBrush="#4A5566" BorderThickness="1"
                  CornerRadius="16" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Local-only timeline" FontSize="17" FontWeight="SemiBold" Foreground="#FAF7F2"/>
              <TextBlock Text="Your activity history is stored on this PC. Memory Trail does not require a cloud account."
                         Margin="0,6,0,0" Foreground="#C5BBB1" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Background="#2B3340" BorderBrush="#4A5566" BorderThickness="1"
                  CornerRadius="16" Padding="20">
            <StackPanel>
              <TextBlock Text="Capture controls" FontSize="17" FontWeight="SemiBold" Foreground="#FAF7F2"/>
              <TextBlock Text="Pause capture at any time, disable clipboard capture, or exclude applications and services."
                         Margin="0,6,0,13" Foreground="#C5BBB1" TextWrapping="Wrap"/>
              <Button Content="Open Settings" Tag="Settings" Click="NavButton_Click" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- SETTINGS -->
      <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
          <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Foreground="#FAF7F2"/>
          <TextBlock Text="Control what Memory Trail remembers and how it behaves."
                     Margin="0,7,0,22" FontSize="14" Foreground="#B6ADA4"/>

          <Border Background="#2B3340" BorderBrush="#4A5566" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Capture" FontSize="18" FontWeight="SemiBold" Foreground="#FAF7F2"/>
              <TextBlock Text="Choose what Memory Trail remembers." Margin="0,5,0,16" Foreground="#B6ADA4"/>
              <CheckBox x:Name="PauseCaptureCheckBox" Content="Pause all capture" Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="AppCaptureCheckBox" Content="Remember app switches and focused windows" Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="ClipboardCaptureCheckBox" Content="Remember copied text" Checked="SettingChanged" Unchecked="SettingChanged"/>
            </StackPanel>
          </Border>

          <Border Background="#2B3340" BorderBrush="#4A5566" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Privacy exclusions" FontSize="18" FontWeight="SemiBold" Foreground="#FAF7F2"/>
              <TextBlock Text="One Windows process name per line. Excluded apps are not intentionally recorded."
                         Margin="0,5,0,14" Foreground="#B6ADA4" TextWrapping="Wrap"/>
              <TextBox x:Name="ExclusionsBox" AcceptsReturn="True" MinHeight="110"/>
              <Button Content="Apply exclusions" Margin="0,12,0,0" HorizontalAlignment="Left" Click="ApplyExclusions_Click"/>
            </StackPanel>
          </Border>

          <Border Background="#2B3340" BorderBrush="#4A5566" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold" Foreground="#FAF7F2"/>
              <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Memory Trail when I sign in to Windows"
                        Margin="0,14,0,0" Checked="StartWithWindowsChanged" Unchecked="StartWithWindowsChanged"/>
            </StackPanel>
          </Border>

          <Border Background="#2B3340" BorderBrush="#4A5566" BorderThickness="1" CornerRadius="16" Padding="22">
            <StackPanel>
              <TextBlock Text="Maintenance" FontSize="18" FontWeight="SemiBold" Foreground="#FAF7F2"/>
              <TextBlock Text="Tutorial, reset, and history controls." Margin="0,5,0,14" Foreground="#B6ADA4"/>
              <WrapPanel>
                <Button Content="Show tutorial" Click="ShowTutorial_Click" Margin="0,0,8,8"/>
                <Button Content="Reset preferences" Click="ClearCache_Click" Margin="0,0,8,8"/>
                <Button x:Name="ClearTimelineButton" Content="Clear history" Click="ClearTimeline_Click" Margin="0,0,8,8"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>