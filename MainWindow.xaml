<Window x:Class="MemoryLane.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Lane"
        Icon="Assets/MemoryLaneIcon.png"
        Width="1240" Height="800"
        MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#163A72" BorderThickness="0,0,1,0" Padding="20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
            <Image Source="Assets/MemoryLaneIcon.png"
                   Width="36" Height="36"
                   Stretch="Uniform"
                   Margin="0,0,10,0"/>
            <TextBlock Text="Memory Lane"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <Button Content="Timeline" Tag="Timeline" Click="NavButton_Click" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>
          <Button Content="Search" Tag="Search" Click="NavButton_Click" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>
          <Button Content="Favorites" Tag="Favorites" Click="NavButton_Click" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>
          <Button Content="Settings" Tag="Settings" Click="NavButton_Click" Margin="0,0,0,10" HorizontalContentAlignment="Left"/>

          <Separator Margin="0,12"/>

          <Button x:Name="PauseButton" Click="PauseButton_Click" Margin="0,0,0,8"/>
          <Button Content="+ Add Memory" Click="AddMemory_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" Foreground="#AFC8EB" FontSize="12"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Timeline"
                     FontSize="32" FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryTextBrush}"/>
          <TextBlock x:Name="PageSubtitle" Text="Your recent activity"
                     Margin="0,6,0,0"
                     Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <Button x:Name="ClearTimelineButton"
                Grid.Column="1"
                Content="Clear Timeline"
                Click="ClearTimeline_Click"
                VerticalAlignment="Center"/>
      </Grid>

      <TextBox x:Name="SearchBox"
               Grid.Row="1"
               Visibility="Collapsed"
               Margin="0,0,0,16"
               Padding="14,11"
               FontSize="15"
               Background="{StaticResource PanelBrush}"
               Foreground="{StaticResource PrimaryTextBrush}"
               BorderBrush="{StaticResource BorderBrush}"
               TextChanged="SearchBox_TextChanged"/>

      <Grid Grid.Row="2">
        <ListView x:Name="TimelineList"
                  Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource PanelBrush}"
                      CornerRadius="16"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      Padding="20"
                      Margin="0,0,0,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel>
                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MMM d}}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding SourceApp}"
                               Margin="0,10,0,0"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Body}"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               MaxHeight="105"/>
                    <TextBlock Text="{Binding SourceKind}"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Margin="16,0,0,0">
                    <Button Content="★" Tag="{Binding}" Click="Favorite_Click" Margin="0,0,0,8"/>
                    <Button Content="Delete" Tag="{Binding}" Click="Delete_Click"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Capture"
                           FontSize="19" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <CheckBox x:Name="PauseCaptureCheckBox"
                          Content="Pause all capture"
                          Margin="0,14,0,8"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          Checked="SettingChanged" Unchecked="SettingChanged"/>
                <CheckBox x:Name="AppCaptureCheckBox"
                          Content="Remember app switches and focused windows"
                          Margin="0,0,0,8"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          Checked="SettingChanged" Unchecked="SettingChanged"/>
                <CheckBox x:Name="ClipboardCaptureCheckBox"
                          Content="Remember copied text"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          Checked="SettingChanged" Unchecked="SettingChanged"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Excluded Apps &amp; Services"
                           FontSize="19" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Enter Windows process names, one per line. Memory Lane will not intentionally log activity or clipboard content while an excluded process is active."
                           Margin="0,8,0,10"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
                <TextBox x:Name="ExclusionsBox"
                         AcceptsReturn="True"
                         MinHeight="120"
                         Padding="10"
                         Background="#FFFFFF"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="Apply Exclusions" Margin="0,10,0,0" Click="ApplyExclusions_Click"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Windows"
                           FontSize="19" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Start Memory Lane when I sign in to Windows"
                          Margin="0,14,0,0"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          Checked="StartWithWindowsChanged" Unchecked="StartWithWindowsChanged"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22">
              <StackPanel>
                <TextBlock Text="Data &amp; Privacy"
                           FontSize="19" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Memory Lane stores your activity timeline locally on this PC. No cloud account, analytics SDK, or advertising SDK is required."
                           Margin="0,8,0,12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="Show Welcome Tutorial" Click="ShowTutorial_Click"/>
                  <Button Content="Clear App Cache" Click="ClearCache_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
