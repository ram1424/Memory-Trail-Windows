<Window x:Class="MemoryLane.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemoryLane.Windows"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Memory Trail v1.0.1"
        Width="1580" Height="920"
        MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text"
        Background="#E8EEF9">
  <Window.Resources>
    <local:AppIconConverter x:Key="AppIconConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <Style x:Key="MetricCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#F6F9FC"/>
      <Setter Property="BorderBrush" Value="#D8E1EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <Style x:Key="FilterNavStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="TimelineChipStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="SummaryProgressStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Background" Value="#F3F7FB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
              <Border x:Name="PART_Indicator"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="5"
                      HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  
    <Style x:Key="MacCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="MacQuickFilterStyle" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="13,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#F6F9FC"/>
      <Setter Property="BorderBrush" Value="#D8E1EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#1A2438"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="QuickChrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="17" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="QuickChrome" Property="Background" Value="#FBFCFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="238"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- LEFT SIDEBAR: mirrors macOS MemoryTrailSidebar -->
    <Border Grid.Column="0" BorderBrush="#D0DAE7" BorderThickness="0,0,1,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#E3EBF7" Offset="0"/>
          <GradientStop Color="#D1DEF0" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,16">
          <Image x:Name="BrandLogo" Width="64" Height="64" Stretch="Uniform"
                 SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Memory Trail" FontSize="20" FontWeight="Bold" Foreground="#1A2438"
                     HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="TimelineNavButton" Tag="Timeline" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="28"/>
              <TextBlock Text="Today"/>
            </StackPanel>
          </Button>
          <Button x:Name="AskMemoryTrailNavButton" Tag="Ask" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Width="28"/>
              <TextBlock Text="Ask Memory Trail"/>
            </StackPanel>
          </Button>
          <Button x:Name="FavoritesNavButton" Tag="Favorites" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" Width="28"/>
              <TextBlock Text="Favorites"/>
            </StackPanel>
          </Button>
          <Button x:Name="ClipboardNavButton" Tag="Clipboard" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" Width="28"/>
              <TextBlock Text="Clipboard History"/>
            </StackPanel>
          </Button>
          <Button x:Name="InsightsNavButton" Tag="Insights" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Width="28"/>
              <TextBlock Text="Insights"/>
            </StackPanel>
          </Button>
          <Button x:Name="SettingsNavButton" Tag="Settings" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="28"/>
              <TextBlock Text="Settings"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,10">
          <StackPanel>
            <Border Height="1" Background="#D0DAE7" Margin="6,0,6,16"/>
            <Grid Margin="8,0,8,7">
              <TextBlock Text="Filters" FontSize="12" FontWeight="SemiBold" Foreground="#66778F"/>
              <TextBlock Text="⌃" HorizontalAlignment="Right" FontSize="11" Foreground="#8795A8"/>
            </Grid>

            <Button x:Name="AllAppsFilter" Tag="All" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="▦" Foreground="#1680FF" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="All Apps" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="AllAppsCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="BrowserFilter" Tag="Browser" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="◎" Foreground="#16AFC8" FontSize="15"/><TextBlock Grid.Column="1" Text="Web Browsers"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="BrowserCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="EmailFilter" Tag="Email" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="✉" Foreground="#E88A20" FontSize="14"/><TextBlock Grid.Column="1" Text="Email"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="EmailCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="ChatFilter" Tag="Chat" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="●" Foreground="#8A57DE" FontSize="14"/><TextBlock Grid.Column="1" Text="Chat &amp; Meetings"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="ChatCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="FilesFilter" Tag="Files" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="▰" Foreground="#D5A516" FontSize="14"/><TextBlock Grid.Column="1" Text="Files &amp; Documents"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="FilesCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="OfficeFilter" Tag="Office" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="▥" Foreground="#16A6A1" FontSize="14"/><TextBlock Grid.Column="1" Text="Productivity"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="OfficeCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="DevelopmentFilter" Tag="Development" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&lt;/&gt;" Foreground="#E88A20" FontSize="11"/><TextBlock Grid.Column="1" Text="Development"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="DevelopmentCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="MediaFilter" Tag="Media" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="▶" Foreground="#EB4D55" FontSize="12"/><TextBlock Grid.Column="1" Text="Media"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="MediaCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="DesignFilter" Tag="Design" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="✦" Foreground="#6257D9" FontSize="13"/><TextBlock Grid.Column="1" Text="Design"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="DesignCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="RemoteFilter" Tag="Remote" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="▣" Foreground="#16AFC8" FontSize="13"/><TextBlock Grid.Column="1" Text="Remote Access"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="RemoteCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="SystemFilter" Tag="System" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="⚙" Foreground="#7B8798" FontSize="13"/><TextBlock Grid.Column="1" Text="System"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="SystemCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
            <Button x:Name="OtherFilter" Tag="Other" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="•••" Foreground="#7B8798" FontSize="11"/><TextBlock Grid.Column="1" Text="Other"/><Border Grid.Column="2" Background="#F6F9FC" CornerRadius="10" Padding="7,3"><TextBlock x:Name="OtherCountText" Text="0" FontSize="10" Foreground="#66778F"/></Border>
              </Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Button x:Name="PauseButton" Grid.Row="3" Click="PauseButton_Click"
                Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1"
                Padding="11" HorizontalContentAlignment="Stretch">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#22C55E" Margin="0,0,9,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="StatusText" Text="Capturing" FontSize="11" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock x:Name="CaptureSubtext" Text="Your activity is stored locally" FontSize="10" Foreground="#66778F" Margin="0,1,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="›" Foreground="#8795A8" FontSize="16" VerticalAlignment="Center"/>
          </Grid>
        </Button>
      </Grid>
    </Border>

    <!-- MAIN CONTENT -->
    <Grid Grid.Column="1">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#E8EEF9" Offset="0"/>
          <GradientStop Color="#DBE6F4" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Grid x:Name="ActivityShell">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="DetailsSpacerColumn" Width="1"/>
          <ColumnDefinition x:Name="DetailsColumn" Width="365"/>
        </Grid.ColumnDefinitions>

        <!-- macOS TimelineView: toolbar, filters, heading and timeline are one left column -->
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="20,14,20,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Width="34" Height="34" Margin="0,0,8,0" Padding="0"
                      Background="#FBFCFF" BorderBrush="#D8E1EC" BorderThickness="1"
                      ToolTip="Add Memory" Click="AddMemory_Click">
                <TextBlock Text="+" FontSize="19" Foreground="#40506A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <Button Width="34" Height="34" Margin="0,0,8,0" Padding="0"
                      Background="#FBFCFF" BorderBrush="#D8E1EC" BorderThickness="1"
                      ToolTip="Clear Timeline" Click="ClearTimeline_Click">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#D84A5A"/>
              </Button>
              <Button x:Name="RightSidebarToggleButton" Click="RightSidebarToggle_Click"
                      Background="#FBFCFF" BorderBrush="#D8E1EC" BorderThickness="1"
                      Padding="14,0" Height="42">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="RightSidebarToggleIcon" Text="▥" FontSize="14" Margin="0,0,7,0" Foreground="#40506A"/>
                  <TextBlock x:Name="PanelToggleText" Text="Hide Panels" FontSize="13" FontWeight="SemiBold" Foreground="#1A2438"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Grid x:Name="QuickFiltersBar" Grid.Row="1" Margin="20,0,20,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="QuickAllFilter" Tag="All" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="All"/><TextBlock x:Name="QuickAllCountText" Text=" (0)" Foreground="#66778F"/></StackPanel>
              </Button>
              <Button x:Name="QuickBrowserFilter" Tag="Browser" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Web"/><TextBlock x:Name="QuickBrowserCountText" Text=" (0)" Foreground="#66778F"/></StackPanel>
              </Button>
              <Button x:Name="QuickEmailFilter" Tag="Email" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Email"/><TextBlock x:Name="QuickEmailCountText" Text=" (0)" Foreground="#66778F"/></StackPanel>
              </Button>
              <Button x:Name="QuickChatFilter" Tag="Chat" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Chat"/><TextBlock x:Name="QuickChatCountText" Text=" (0)" Foreground="#66778F"/></StackPanel>
              </Button>
              <Button x:Name="QuickFilesFilter" Tag="Files" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Files"/><TextBlock x:Name="QuickFilesCountText" Text=" (0)" Foreground="#66778F"/></StackPanel>
              </Button>
              <Button x:Name="QuickOfficeFilter" Tag="Office" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Apps"/><TextBlock x:Name="QuickOfficeCountText" Text=" (0)" Foreground="#66778F"/></StackPanel>
              </Button>
              <Button x:Name="MoreFiltersButton" Content="•••" Width="34" Height="34" Padding="0"
                      Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" Click="MoreFilters_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="QuickCaptureDot" Width="9" Height="9" Fill="#22C55E" Margin="0,0,7,0"/>
              <TextBlock x:Name="QuickCaptureText" Text="Capturing" Foreground="#66778F" FontSize="11"
                         Margin="0,0,14,0" VerticalAlignment="Center"/>
              <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="11">
                <StackPanel Orientation="Horizontal">
                  <Button Content="‹" Width="34" Height="34" Padding="0" BorderThickness="0" Background="Transparent" Click="PreviousDay_Click"/>
                  <TextBlock x:Name="DayLabelText" Text="Today" MinWidth="76" TextAlignment="Center"
                             VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#1A2438"/>
                  <Button x:Name="NextDayButton" Content="›" Width="34" Height="34" Padding="0"
                          BorderThickness="0" Background="Transparent" Click="NextDay_Click"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Border Grid.Row="2" Height="1" Background="#D0DAE7"/>

          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,20">
              <Grid Margin="2,0,2,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="PageTitleText" Text="Today" FontSize="27" FontWeight="Bold" Foreground="#1A2438"/>
                  <TextBlock x:Name="PageSubtitleText"
                             Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat={}{0:dddd, MMMM d, yyyy}}"
                             FontSize="12" Foreground="#66778F" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ActivityCountText" Grid.Column="1" Text="0 activities" Foreground="#1680FF"
                           FontSize="12" FontWeight="Medium" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
              </Grid>

              <Border Background="#EBF1F9" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="18" Padding="10">
                <ListView x:Name="TimelineList" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          SelectionChanged="TimelineList_SelectionChanged">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0,0,0,1"/>
                      <Setter Property="Background" Value="#F6F9FC"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="13"
                                    BorderBrush="#E4EAF2" BorderThickness="1">
                              <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#FBFCFF"/></Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#EAF3FF"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#55A0FF"/>
                                <Setter TargetName="Row" Property="BorderThickness" Value="1.5"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="62" Margin="10,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="70"/>
                          <ColumnDefinition Width="16"/>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="30"/>
                          <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}" Foreground="#66778F" FontSize="12"
                                   FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <Grid Grid.Column="1" Height="58">
                          <Border Width="2" Background="#7DB8FA" HorizontalAlignment="Center"/>
                          <Ellipse Width="10" Height="10" Fill="#1680FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Image Grid.Column="2" Source="{Binding Converter={StaticResource AppIconConverter}}" Width="34" Height="34"
                               Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="3" Margin="8,0,10,0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Foreground="#1A2438" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding IsLiveActivity, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="#E7F8ED" CornerRadius="10" Padding="7,2" Margin="7,0,0,0">
                              <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,4,0"/>
                                <TextBlock Text="Live Activity" Foreground="#168A48" FontSize="10" FontWeight="SemiBold"/>
                              </StackPanel>
                            </Border>
                            <Border Visibility="{Binding IsLatestActivity, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="#E8F2FF" CornerRadius="10" Padding="7,2" Margin="7,0,0,0">
                              <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#1680FF" Margin="0,0,4,0"/>
                                <TextBlock Text="Latest" Foreground="#176EC7" FontSize="10" FontWeight="SemiBold"/>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding SourceApp}" Foreground="#66778F" FontSize="12" Margin="0,3,0,0"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="4" Background="#EEF3F9" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ActivityLabel}" Foreground="#40506A" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <Button Grid.Column="5" Content="☆" FontSize="16" Width="30" Height="30" Padding="0"
                                Background="Transparent" BorderThickness="0" Tag="{Binding}" Click="Favorite_Click"/>
                        <Button Grid.Column="6" Content="•••" Width="28" Height="30" Padding="0"
                                Background="Transparent" BorderThickness="0" Tag="{Binding}" Click="MoreRow_Click"/>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Border x:Name="RightDivider" Grid.Column="1" Width="1" Background="#D0DAE7"/>

        <!-- macOS TimelineSummaryColumn: full-height independent right column -->
        <Border x:Name="RightSidebar" Grid.Column="2" Background="#EBF1F9">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
              <Grid Margin="4,0,4,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="RightStatusDot" Width="10" Height="10" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="RightStatusText" Grid.Column="1" Text="Capturing" FontSize="11" FontWeight="Medium"
                           Foreground="#66778F" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#66778F"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="RightDateText" Grid.Column="3" Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat={}{0:ddd, MMM d, yyyy}}"
                           Foreground="#66778F" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
              </Grid>

              <Border Background="#FBFCFF" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="19" Padding="16">
                <StackPanel>
                  <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#1A2438" Margin="0,0,9,0"/>
                    <TextBlock Grid.Column="1" Text="Today Summary" FontSize="18" FontWeight="Bold" Foreground="#1A2438"/>
                    <Button x:Name="ShowDetailsButton" Grid.Column="2" Visibility="Collapsed"/>
                  </Grid>
                  <UniformGrid Columns="2">
                    <Border Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock x:Name="TotalActivitiesText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Total Activities" FontSize="10" Foreground="#66778F"/></StackPanel></Border>
                    <Border Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock x:Name="AppsUsedText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Apps Used" FontSize="10" Foreground="#66778F"/></StackPanel></Border>
                    <Border Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock x:Name="ActiveTimeText" Text="0m" FontSize="22" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Active Time" FontSize="10" Foreground="#66778F"/></StackPanel></Border>
                    <Border Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock x:Name="ClipboardItemsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Clipboard Items" FontSize="10" Foreground="#66778F"/></StackPanel></Border>
                  </UniformGrid>
                </StackPanel>
              </Border>

              <Grid Height="14"/>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition x:Name="DetailsGapRow" Height="0"/>
                  <RowDefinition x:Name="DetailsRow" Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="DetailsPanel" Grid.Row="1" Background="#FBFCFF" BorderBrush="#E1E7EF"
                        BorderThickness="1" CornerRadius="19" Padding="16">
                  <StackPanel>
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                      <Image Source="{Binding SelectedItem, ElementName=TimelineList, Converter={StaticResource AppIconConverter}}"
                             Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedItem.Title, ElementName=TimelineList, TargetNullValue=Select an activity}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#1A2438" TextWrapping="Wrap" MaxHeight="38"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                          <TextBlock Text="{Binding SelectedItem.SourceApp, ElementName=TimelineList}" FontSize="10" Foreground="#66778F"/>
                          <TextBlock Text="  •  " FontSize="10" Foreground="#66778F"/>
                          <TextBlock Text="{Binding SelectedItem.ActivityLabel, ElementName=TimelineList}" FontSize="10" Foreground="#66778F"/>
                          <TextBlock Text="  •  " FontSize="10" Foreground="#66778F"/>
                          <TextBlock Text="{Binding SelectedItem.CreatedAt, ElementName=TimelineList, StringFormat={}{0:h:mm tt}}" FontSize="10" Foreground="#66778F"/>
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="2" Content="☆" Width="30" Height="30" Padding="0"
                              Background="Transparent" BorderThickness="0" Click="FavoriteSelected_Click"/>
                      <Button Grid.Column="3" Content="•••" Width="28" Height="30" Padding="0"
                              Background="Transparent" BorderThickness="0"/>
                    </Grid>

                    <Border Height="1" Background="#D8E1EC" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="App" FontSize="10" Foreground="#66778F"/>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedItem.SourceApp, ElementName=TimelineList}" FontSize="10" Foreground="#1A2438" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Type" FontSize="10" Foreground="#66778F"/>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedItem.ActivityLabel, ElementName=TimelineList}" FontSize="10" Foreground="#1A2438"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Time" FontSize="10" Foreground="#66778F"/>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedItem.CreatedAt, ElementName=TimelineList, StringFormat={}{0:MMM d, yyyy h:mm tt}}" FontSize="10" Foreground="#1A2438"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Window" FontSize="10" Foreground="#66778F"/>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedItem.Title, ElementName=TimelineList}" FontSize="10" Foreground="#1A2438" TextWrapping="Wrap"/>
                    </Grid>

                    <Border Height="1" Background="#D8E1EC" Margin="0,4,0,12"/>

                    <Button Content="Open Source" Height="42" Style="{StaticResource PrimaryButtonStyle}" Click="OpenSelected_Click"/>
                    <Button Content="Copy Subject" Height="38" Margin="0,8,0,0" Click="CopySelectedTitle_Click"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- PRIVACY -->
            <ScrollViewer x:Name="InsightsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel Margin="4,4,20,30">
          <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Insights" FontSize="28" FontWeight="Bold" Foreground="#1A2438"/>
            <TextBlock Text="A quick view of how your day is distributed." FontSize="13" Foreground="#66778F" Margin="0,6,0,0"/>
          </StackPanel>
          <UniformGrid Columns="2" Margin="0,0,0,18">
            <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,14,14"><StackPanel><TextBlock x:Name="InsightsTotalActivitiesText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Total Activities" Foreground="#66778F"/></StackPanel></Border>
            <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="InsightsAppsUsedText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Apps Used" Foreground="#66778F"/></StackPanel></Border>
            <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,14,0"><StackPanel><TextBlock x:Name="InsightsFavoritesText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Favorites" Foreground="#66778F"/></StackPanel></Border>
            <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="18" Padding="18"><StackPanel><TextBlock x:Name="InsightsClipboardText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Clipboard Items" Foreground="#66778F"/></StackPanel></Border>
          </UniformGrid>
          <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="18" Padding="18">
            <StackPanel>
              <TextBlock Text="Activity by Category" FontSize="16" FontWeight="SemiBold" Foreground="#1A2438" Margin="0,0,0,12"/>
              <TextBlock x:Name="InsightsCategoryText" Text="Open a few apps to build today's category distribution." Foreground="#40506A" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

<ScrollViewer x:Name="PrivacyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="Privacy" FontSize="30" FontWeight="SemiBold" Foreground="#1A2438"/>
          <TextBlock Text="Memory Trail is privacy-first by design and gives you direct control over what is captured."
                     Margin="0,7,0,22" FontSize="14" Foreground="#66778F"/>
          <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1"
                  CornerRadius="16" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Local processing and storage" FontSize="17" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="Your activity history is sourced, processed, and stored locally on this PC. Memory Trail does not require a cloud account for its timeline."
                         Margin="0,6,0,0" Foreground="#40506A" TextWrapping="Wrap"/>
              <Border Background="#EAF7F0" BorderBrush="#CDE9D8" BorderThickness="1"
                      CornerRadius="12" Padding="11" Margin="0,12,0,0">
                <TextBlock Text="No timeline data is designed to be sent outside this computer."
                           Foreground="#247553" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </Border>
          <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1"
                  CornerRadius="16" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="No outside connectors" FontSize="17" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="Memory Trail's timeline is designed to operate locally and does not depend on external connectors or cloud services to capture, search, or display your activity."
                         Margin="0,6,0,12" Foreground="#40506A" TextWrapping="Wrap"/>
              <TextBlock Text="Open source transparency" FontSize="15" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="The source code is available for review so users and administrators can inspect and verify how capture, storage, and privacy controls are implemented."
                         Margin="0,5,0,0" Foreground="#40506A" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1"
                  CornerRadius="16" Padding="20">
            <StackPanel>
              <TextBlock Text="Capture controls" FontSize="17" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="Pause capture at any time, disable clipboard capture, or exclude applications and services."
                         Margin="0,6,0,13" Foreground="#40506A" TextWrapping="Wrap"/>
              <Button Content="Open Settings" Tag="Settings" Click="NavButton_Click" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- SETTINGS -->
      <!-- ASK MEMORY TRAIL -->
      <Grid x:Name="AskMemoryTrailPanel" Visibility="Collapsed" Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,2,4,18">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="✦" Foreground="#1680FF" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Ask Memory Trail" FontSize="32" FontWeight="SemiBold" Foreground="#1A2438"/>
          </StackPanel>
          <TextBlock Text="Ask about a time, app, page, email, chat, file, or project. Answers are generated locally from your captured timeline."
                     Foreground="#66778F" FontSize="13" Margin="1,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
          <Border Background="#F6F9FC" BorderBrush="#D4E0ED" BorderThickness="1"
                  CornerRadius="20" Padding="14,11">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#66778F"
                         FontSize="17" VerticalAlignment="Center" Margin="2,0,10,0"/>
              <TextBox x:Name="AskMemoryTrailBox" Grid.Column="1"
                       BorderThickness="0" Background="Transparent"
                       Foreground="#1A2438" CaretBrush="#1A2438"
                       Padding="0" FontSize="14"
                       KeyDown="AskMemoryTrailBox_KeyDown"
                       ToolTip="Ask Memory Trail"/>
              <Button x:Name="AskMemoryTrailButton" Grid.Column="2"
                      Click="AskMemoryTrail_Click"
                      Background="#1680FF" Foreground="White"
                      BorderThickness="0" Padding="14,6" Margin="10,0,0,0"
                      Content="Ask →"/>
            </Grid>
          </Border>

          <WrapPanel Margin="0,12,0,0">
            <Button Content="◷  What was I doing earlier today?" Tag="What was I doing earlier today?"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="▣  Show my activity from this week" Tag="Show my activity from this week"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="▤  Find files I worked on recently" Tag="Find files I worked on recently"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="✉  What emails did I view recently?" Tag="What emails did I view recently?"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="◉  What conversations did I have today?" Tag="What conversations did I have today?"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="◎  What websites did I visit?" Tag="What websites did I visit?"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="⌁  Show my most recent activity" Tag="Show my most recent activity"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="⌕  Find a project I worked on" Tag="Find a project I worked on"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
          </WrapPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1"
                CornerRadius="20" Padding="20">
          <Grid>
            <Grid x:Name="AskEmptyState">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <Border Width="82" Height="82" CornerRadius="20" Background="#F6F9FC"
                        BorderBrush="#D7E2EE" BorderThickness="1"
                        Padding="7" HorizontalAlignment="Center" Margin="0,0,0,18">
                  <Image Source="{Binding Source={x:Static local:Branding.IconSource}}"
                         Width="66" Height="66" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="Your workday is searchable"
                           Foreground="#1A2438" FontWeight="SemiBold" FontSize="25"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Memory Trail can reason over captured timestamps, application names, window titles, URLs, filenames, and local file paths without sending your history to a cloud service."
                           Foreground="#66778F" FontSize="13" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,10,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="◷  Time-aware" Foreground="#66778F" Margin="0,0,18,0"/>
                  <TextBlock Text="▣  App-aware" Foreground="#66778F" Margin="0,0,18,0"/>
                  <TextBlock Text="▤  File-aware" Foreground="#66778F" Margin="0,0,18,0"/>
                  <TextBlock Text="◉  Local" Foreground="#66778F"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <Grid x:Name="AskResultsState" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Background="#F6F9FC" BorderBrush="#D5E1ED" BorderThickness="1"
                      CornerRadius="16" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Memory Trail" Foreground="#6CAEFF" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="AskAnswerText" Foreground="#1A2438" FontSize="15"
                             TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>

              <ListView x:Name="AskResultsList" Grid.Row="1"
                        Background="Transparent" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1"
                            CornerRadius="13" Padding="13">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="50"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#EEF3F9">
                          <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                                 Width="32" Height="32" Stretch="Uniform"
                                 RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding SourceApp}" Foreground="#1A2438" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Title}" Foreground="#66778F" FontSize="12"
                                     TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat={}{0:MMM d · h:mm tt}}"
                                   Foreground="#9F978F" FontSize="11" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
          <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Foreground="#1A2438"/>
          <TextBlock Text="Control what Memory Trail remembers, how it behaves, and review its privacy-first design."
                     Margin="0,7,0,22" FontSize="14" Foreground="#66778F"/>

          <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Capture" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="Choose what Memory Trail remembers." Margin="0,5,0,16" Foreground="#66778F"/>
              <CheckBox x:Name="PauseCaptureCheckBox" Content="Pause all capture" Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="AppCaptureCheckBox" Content="Remember app switches and focused windows" Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="ClipboardCaptureCheckBox" Content="Remember copied text" Checked="SettingChanged" Unchecked="SettingChanged"/>
            </StackPanel>
          </Border>

          <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1"
                  CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="36" Height="36" Background="#EAF7F0" CornerRadius="10" Margin="0,0,10,0">
                  <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#218A57"
                             FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Privacy &amp; Transparency" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
                  <TextBlock Text="Privacy first by design" Foreground="#66778F" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>

              <TextBlock Text="Memory Trail is designed as a private, locally run application. Activity used by the timeline is sourced, processed, and stored on this computer."
                         Foreground="#40506A" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"/>

              <Border Background="#F6F9FC" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⌂" FontSize="17" Foreground="#1E78F0" Width="28"/>
                  <StackPanel>
                    <TextBlock Text="Local data only" Foreground="#1A2438" FontWeight="SemiBold"/>
                    <TextBlock Text="Captured timeline data remains stored locally on this PC." Foreground="#66778F" FontSize="12" Margin="0,3,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="#F6F9FC" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⊘" FontSize="17" Foreground="#1E78F0" Width="28"/>
                  <StackPanel>
                    <TextBlock Text="No external connectors" Foreground="#1A2438" FontWeight="SemiBold"/>
                    <TextBlock Text="The timeline does not require external connectors or cloud services to capture, search, or display activity." Foreground="#66778F" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="#F6F9FC" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="✓" FontSize="17" Foreground="#1E78F0" Width="28"/>
                  <StackPanel>
                    <TextBlock Text="Source available for verification" Foreground="#1A2438" FontWeight="SemiBold"/>
                    <TextBlock Text="The source code is available for review so you can inspect how Memory Trail captures, stores, and protects data." Foreground="#66778F" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Privacy exclusions" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="One Windows process name per line. Excluded apps are not intentionally recorded."
                         Margin="0,5,0,14" Foreground="#66778F" TextWrapping="Wrap"/>
              <TextBox x:Name="ExclusionsBox" AcceptsReturn="True" MinHeight="110"/>
              <Button Content="Apply exclusions" Margin="0,12,0,0" HorizontalAlignment="Left" Click="ApplyExclusions_Click"/>
            </StackPanel>
          </Border>

          <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
              <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Memory Trail when I sign in to Windows"
                        Margin="0,14,0,0" Checked="StartWithWindowsChanged" Unchecked="StartWithWindowsChanged"/>
            </StackPanel>
          </Border>

          <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="16" Padding="22">
            <StackPanel>
              <TextBlock Text="Maintenance" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="Tutorial, reset, and history controls." Margin="0,5,0,14" Foreground="#66778F"/>
              <WrapPanel>
                <Button Content="Show tutorial" Click="ShowTutorial_Click" Margin="0,0,8,8"/>
                <Button Content="Reset preferences" Click="ClearCache_Click" Margin="0,0,8,8"/>
                <Button x:Name="ClearTimelineButton" Content="Clear history" Click="ClearTimeline_Click" Margin="0,0,8,8"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>