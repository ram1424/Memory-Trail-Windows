<Window x:Class="MemoryLane.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemoryLane.Windows"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Memory Trail 1.0 (Build 1)"
        Width="1560" Height="860"
        MinWidth="1240" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text"
        Background="#DCE6F2">
  <Window.Resources>
    <local:AppIconConverter x:Key="AppIconConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <Style x:Key="MetricCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#E8EFF6"/>
      <Setter Property="BorderBrush" Value="#C4D1E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="11"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="MinHeight" Value="72"/>
    </Style>

    <Style x:Key="MetricIconTileStyle" TargetType="Border">
      <Setter Property="Width" Value="31"/>
      <Setter Property="Height" Value="31"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
    </Style>

    <Style x:Key="SummaryMetricValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#1A2438"/>
    </Style>

    <Style x:Key="SummaryMetricLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="Foreground" Value="#66778F"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="FilterNavStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="TimelineChipStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="PanelToggleButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D7DEE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#1A2438"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="PanelToggleChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PanelToggleChrome" Property="Background" Value="#FAFBFD"/>
                <Setter TargetName="PanelToggleChrome" Property="BorderBrush" Value="#C9D2DE"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PanelToggleChrome" Property="Background" Value="#F3F6F9"/>
                <Setter TargetName="PanelToggleChrome" Property="BorderBrush" Value="#C1CBD8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SummaryProgressStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Background" Value="#F3F7FB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
              <Border x:Name="PART_Indicator"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="5"
                      HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  
    <Style x:Key="MacCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Height" Value="41"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style x:Key="MacQuickFilterStyle" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#E4EBF3"/>
      <Setter Property="BorderBrush" Value="#D8E1EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#1A2438"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="QuickChrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="QuickChrome" Property="Background" Value="#EDF3F8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- LEFT SIDEBAR: mirrors macOS MemoryTrailSidebar -->
    <Border Grid.Column="0" BorderBrush="#D0DAE7" BorderThickness="0,0,1,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#DFE7F1" Offset="0"/>
          <GradientStop Color="#C8D6E7" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid Margin="10,12,10,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,16">
          <Border Width="66" Height="66" CornerRadius="18" Background="#FFFFFF"
                  BorderBrush="#DDE6F0" BorderThickness="1" Padding="4">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.14" Color="#39506E"/>
            </Border.Effect>
            <Image x:Name="BrandLogo" Width="58" Height="58" Stretch="Uniform"
                   SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Text="Memory Trail" FontSize="17" FontWeight="Bold" Foreground="#172238"
                     HorizontalAlignment="Center" Margin="0,8,0,0"/>
          <Border Background="#E9F7F1" BorderBrush="#D2ECDD" BorderThickness="1"
                  CornerRadius="10" Padding="7,3" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="#20C56A" Margin="0,0,5,0" VerticalAlignment="Center"/>
              <TextBlock Text="Private • Local" FontSize="9.5" FontWeight="SemiBold" Foreground="#34705A"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="TimelineNavButton" Tag="Timeline" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="9" Background="#DCEAFF" Margin="0,0,9,0"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="#176DFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Today"/>
            </StackPanel>
          </Button>
          <Button x:Name="AskMemoryTrailNavButton" Tag="Ask" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="9" Background="#E4ECFF" Margin="0,0,9,0"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#5573ED" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Ask Memory Trail"/>
            </StackPanel>
          </Button>
          <Button x:Name="FavoritesNavButton" Tag="Favorites" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="9" Background="#E8F2FF" Margin="0,0,9,0"><TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" Foreground="#3B8EF0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Favorites"/>
            </StackPanel>
          </Button>
          <Button x:Name="ClipboardNavButton" Tag="Clipboard" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="9" Background="#E5F1FF" Margin="0,0,9,0"><TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" Foreground="#3388ED" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Clipboard History"/>
            </StackPanel>
          </Button>
          <Button x:Name="InsightsNavButton" Tag="Insights" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="9" Background="#DDF5FA" Margin="0,0,9,0"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="#17A9C7" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Insights"/>
            </StackPanel>
          </Button>
          <Button x:Name="SettingsNavButton" Tag="Settings" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="9" Background="#E9F0F8" Margin="0,0,9,0"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#6F86A6" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Settings"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,8">
          <StackPanel>
            <Border Height="1" Background="#D0DAE7" Margin="6,0,6,16"/>
            <Grid Margin="8,0,8,7">
              <TextBlock Text="Filters" FontSize="12" FontWeight="SemiBold" Foreground="#66778F"/>
              <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" FontSize="10" Foreground="#8795A8"/>
            </Grid>

            <Button x:Name="AllAppsFilter" Tag="All" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="All" Width="32" Height="32" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="All Apps" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E8F1FF" BorderBrush="#D8E6FA" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="AllAppsCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="BrowserFilter" Tag="Browser" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Browser" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Web Browsers" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="BrowserCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="EmailFilter" Tag="Email" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Email" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Email" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="EmailCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="ChatFilter" Tag="Chat" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Chat" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Chat &amp; Meetings" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="ChatCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="FilesFilter" Tag="Files" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Files" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Files &amp; Documents" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="FilesCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="OfficeFilter" Tag="Office" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Productivity" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Productivity" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="OfficeCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="DevelopmentFilter" Tag="Development" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Development" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Development" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="DevelopmentCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="MediaFilter" Tag="Media" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Media" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Media" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="MediaCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="DesignFilter" Tag="Design" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Design" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Design" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="DesignCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="RemoteFilter" Tag="Remote" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Remote" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Remote Access" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="RemoteCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="SystemFilter" Tag="System" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="System" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="System" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="SystemCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="OtherFilter" Tag="Other" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Other" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Other" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF4FB" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="OtherCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Button x:Name="PauseButton" Grid.Row="3" Click="PauseButton_Click"
                Background="#E7EEF5" BorderBrush="#C3D0DE" BorderThickness="1"
                Padding="11,9" HorizontalContentAlignment="Stretch">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,9,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="StatusText" Text="Capturing" FontSize="11" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock x:Name="CaptureSubtext" Text="Your activity is stored locally" FontSize="10" Foreground="#66778F" Margin="0,1,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="#8795A8" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
        </Button>
      </Grid>
    </Border>

    <!-- MAIN CONTENT -->
    <Grid Grid.Column="1">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#E3EAF3" Offset="0"/>
          <GradientStop Color="#CCD9E8" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Grid x:Name="ActivityShell">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="DetailsSpacerColumn" Width="1"/>
          <ColumnDefinition x:Name="DetailsColumn" Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- macOS TimelineView: toolbar, filters, heading and timeline are one left column -->
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="18,12,18,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="RightSidebarToggleButton"
                      Click="RightSidebarToggle_Click"
                      Style="{StaticResource PanelToggleButtonStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Grid x:Name="RightSidebarToggleIcon" Width="16" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Border BorderBrush="#27313F" BorderThickness="1.35" CornerRadius="2.5"/>
                    <Border Width="1.35" Background="#27313F" HorizontalAlignment="Left" Margin="5,2,0,2"/>
                  </Grid>
                  <TextBlock x:Name="PanelToggleText"
                             Text="Hide Panels"
                             FontSize="13"
                             FontWeight="Bold"
                             Foreground="#1C2430"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Grid x:Name="QuickFiltersBar" Grid.Row="1" Margin="18,0,18,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="QuickAllFilter" Tag="All" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal">
                  <local:CategoryIcon Category="All" Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="All" VerticalAlignment="Center"/>
                  <TextBlock x:Name="QuickAllCountText" Text=" (0)" Foreground="#66778F" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="QuickBrowserFilter" Tag="Browser" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal">
                  <local:CategoryIcon Category="Browser" Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Web" VerticalAlignment="Center"/>
                  <TextBlock x:Name="QuickBrowserCountText" Text=" (0)" Foreground="#66778F" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="QuickEmailFilter" Tag="Email" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal">
                  <local:CategoryIcon Category="Email" Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Email" VerticalAlignment="Center"/>
                  <TextBlock x:Name="QuickEmailCountText" Text=" (0)" Foreground="#66778F" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="QuickChatFilter" Tag="Chat" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal">
                  <local:CategoryIcon Category="Chat" Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Chat" VerticalAlignment="Center"/>
                  <TextBlock x:Name="QuickChatCountText" Text=" (0)" Foreground="#66778F" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="QuickFilesFilter" Tag="Files" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal">
                  <local:CategoryIcon Category="Files" Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Files" VerticalAlignment="Center"/>
                  <TextBlock x:Name="QuickFilesCountText" Text=" (0)" Foreground="#66778F" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="QuickOfficeFilter" Tag="Office" Click="Category_Click" Style="{StaticResource MacQuickFilterStyle}">
                <StackPanel Orientation="Horizontal">
                  <local:CategoryIcon Category="Productivity" Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Apps" VerticalAlignment="Center"/>
                  <TextBlock x:Name="QuickOfficeCountText" Text=" (0)" Foreground="#66778F" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="MoreFiltersButton" Width="32" Height="32" Padding="0"
                      Background="#E3EBF3" BorderBrush="#C3D0DE" BorderThickness="1" Click="MoreFilters_Click" ToolTip="More filters">
                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#66778F"/>
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="QuickCaptureDot" Width="9" Height="9" Fill="#22C55E" Margin="0,0,7,0"/>
              <TextBlock x:Name="QuickCaptureText" Text="Capturing" Foreground="#66778F" FontSize="11"
                         Margin="0,0,14,0" VerticalAlignment="Center"/>
              <Border Background="#E3EBF3" BorderBrush="#C3D0DE" BorderThickness="1" CornerRadius="11">
                <StackPanel Orientation="Horizontal">
                  <Button Width="32" Height="32" Padding="0" BorderThickness="0" Background="Transparent" Click="PreviousDay_Click" ToolTip="Previous day">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#40506A"/>
                  </Button>
                  <TextBlock x:Name="DayLabelText" Text="Today" MinWidth="76" TextAlignment="Center"
                             VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#1A2438"/>
                  <Button x:Name="NextDayButton" Width="32" Height="32" Padding="0"
                          BorderThickness="0" Background="Transparent" Click="NextDay_Click" ToolTip="Next day">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#40506A"/>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Border Grid.Row="2" Height="1" Background="#D0DAE7"/>

          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14,18,18">
              <Grid Margin="2,0,2,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="PageTitleText" Text="Today" FontSize="24" FontWeight="Bold" Foreground="#1A2438"/>
                  <TextBlock x:Name="PageSubtitleText"
                             Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat={}{0:dddd, MMMM d, yyyy}}"
                             FontSize="12" Foreground="#66778F" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ActivityCountText" Grid.Column="1" Text="0 activities" Foreground="#1680FF"
                           FontSize="12" FontWeight="Medium" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
              </Grid>

              <Border Background="#CEDAE7" BorderBrush="#B9C8D9" BorderThickness="1" CornerRadius="11" Padding="8">
                <ListView x:Name="TimelineList" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          SelectionChanged="TimelineList_SelectionChanged">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0,0,0,2"/>
                      <Setter Property="Background" Value="#E4EBF3"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="13"
                                    BorderBrush="#E3EAF2" BorderThickness="1">
                              <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#EEF3F8"/></Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#D8E8FA"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#55A0FF"/>
                                <Setter TargetName="Row" Property="BorderThickness" Value="1.5"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="56" Margin="10,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="70"/>
                          <ColumnDefinition Width="16"/>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="30"/>
                          <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}" Foreground="#66778F" FontSize="12"
                                   FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <Grid Grid.Column="1" Height="52">
                          <Border Width="2" Background="#7DB8FA" HorizontalAlignment="Center"/>
                          <Ellipse Width="10" Height="10" Fill="#1680FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Column="2" Width="34" Height="34" CornerRadius="8" Background="#EAF0F6"
                                BorderBrush="#E1E7EF" BorderThickness="1" VerticalAlignment="Center">
                          <Image Source="{Binding Converter={StaticResource AppIconConverter}}" Width="27" Height="27"
                                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="3" Margin="8,0,10,0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Foreground="#1A2438" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding IsLiveActivity, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="#E7F8ED" CornerRadius="10" Padding="7,2" Margin="7,0,0,0">
                              <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,4,0"/>
                                <TextBlock Text="Live Activity" Foreground="#168A48" FontSize="10" FontWeight="SemiBold"/>
                              </StackPanel>
                            </Border>
                            <Border Visibility="{Binding IsLatestActivity, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="#E8F2FF" CornerRadius="10" Padding="7,2" Margin="7,0,0,0">
                              <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#1680FF" Margin="0,0,4,0"/>
                                <TextBlock Text="Latest" Foreground="#176EC7" FontSize="10" FontWeight="SemiBold"/>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding SourceApp}" Foreground="#66778F" FontSize="12" Margin="0,3,0,0"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border x:Name="CategoryChip" Grid.Column="4" Background="#EEF3F9" CornerRadius="13" Padding="7,3" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <local:CategoryIcon Category="{Binding ActivityLabel}" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CategoryChipText" Text="{Binding ActivityLabel}" Foreground="#40506A" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                        <Button Grid.Column="5" Width="30" Height="30" Padding="0"
                                Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="Favorite_Click" ToolTip="Favorite">
                          <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7A8798"/>
                        </Button>
                        <Button Grid.Column="6" Width="28" Height="30" Padding="0"
                                Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="MoreRow_Click" ToolTip="More">
                          <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7A8798"/>
                        </Button>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="Web">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#E8F3FF"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#2777C9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="Email">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#ECF4FF"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#347ED1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="Chat">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#EEF0FF"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#6473D4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="File">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#E9F5FF"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#3188C8"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="Spreadsheet">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#E6F7FB"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#178DA9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="Document">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#E8F2FF"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#176EC7"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="Presentation">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#EDF2FF"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#5877CC"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="Development">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#ECEFFF"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#5A6FD4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="Notes">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#EEF2FF"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#6277C7"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="Clipboard">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#ECF4FF"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#3D80CC"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActivityLabel}" Value="System">
                          <Setter TargetName="CategoryChip" Property="Background" Value="#EEF1F5"/>
                          <Setter TargetName="CategoryChipText" Property="Foreground" Value="#6F7987"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Border x:Name="RightDivider" Grid.Column="1" Width="1" Background="#D0DAE7"/>

        <!-- macOS TimelineSummaryColumn: full-height independent right column -->
        <Border x:Name="RightSidebar" Grid.Column="2">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#DEE7F1" Offset="0"/>
              <GradientStop Color="#CFDCEA" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
              <Grid Margin="4,1,4,11">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="RightStatusDot" Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="RightStatusText" Grid.Column="1" Text="Capturing" FontSize="10.5" FontWeight="Medium"
                           Foreground="#66778F" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#66778F"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="RightDateText" Grid.Column="3" Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat={}{0:ddd, MMM d, yyyy}}"
                           Foreground="#66778F" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
              </Grid>

              <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="19" Padding="14" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                  <Grid Margin="1,0,1,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="9" Background="#EEF4FA" Margin="0,0,9,0">
                      <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#2A3445"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Today Summary" FontSize="16.5" FontWeight="Bold" Foreground="#1A2438"
                               VerticalAlignment="Center"/>
                    <Button x:Name="ShowDetailsButton" Grid.Column="2" Visibility="Collapsed"/>
                  </Grid>

                  <UniformGrid Columns="2">
                    <Border Style="{StaticResource MetricCardStyle}" Background="#F0F7FF" BorderBrush="#DAE9FA">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <local:CategoryIcon Category="Productivity" Width="34" Height="34" Margin="0,0,9,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock x:Name="TotalActivitiesText" Text="0" Style="{StaticResource SummaryMetricValueStyle}"/>
                          <TextBlock Text="Total Activities" Style="{StaticResource SummaryMetricLabelStyle}"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}" Background="#EEF5FF" BorderBrush="#D9E6F8">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <local:CategoryIcon Category="All" Width="34" Height="34" Margin="0,0,9,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock x:Name="AppsUsedText" Text="0" Style="{StaticResource SummaryMetricValueStyle}"/>
                          <TextBlock Text="Apps Used" Style="{StaticResource SummaryMetricLabelStyle}"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}" Background="#EFF9FC" BorderBrush="#D9EEF3">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource MetricIconTileStyle}" Background="#DDF6F2">
                          <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.13" Color="#139E9D"/></Border.Effect>
                          <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#14A9A4"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock x:Name="ActiveTimeText" Text="0m" Style="{StaticResource SummaryMetricValueStyle}"/>
                          <TextBlock Text="Active Time" Style="{StaticResource SummaryMetricLabelStyle}"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}" Background="#F2F7FF" BorderBrush="#DFE9F7">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <local:CategoryIcon Category="Clipboard" Width="34" Height="34" Margin="0,0,9,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock x:Name="ClipboardItemsText" Text="0" Style="{StaticResource SummaryMetricValueStyle}"/>
                          <TextBlock Text="Clipboard Items" Style="{StaticResource SummaryMetricLabelStyle}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </UniformGrid>
                </StackPanel>
              </Border>

              <Grid Height="12"/>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition x:Name="DetailsGapRow" Height="0"/>
                  <RowDefinition x:Name="DetailsRow" Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="DetailsPanel" Grid.Row="1" Background="#EDF3F8" BorderBrush="#C5D3E1"
                        BorderThickness="1" CornerRadius="19" Padding="15" Effect="{StaticResource SoftShadow}">
                  <StackPanel>
                    <Grid Margin="0,0,0,14">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                      <Border Width="44" Height="44" CornerRadius="10" Background="#E1E8F0"
                              BorderBrush="#E1E7EF" BorderThickness="1">
                        <Image Source="{Binding SelectedItem, ElementName=TimelineList, Converter={StaticResource AppIconConverter}}"
                               Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedItem.Title, ElementName=TimelineList, TargetNullValue=Select an activity}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#1A2438" TextWrapping="Wrap" MaxHeight="38"/>
                        <WrapPanel Margin="0,3,0,0">
                          <TextBlock Text="{Binding SelectedItem.SourceApp, ElementName=TimelineList}" FontSize="10" Foreground="#66778F"/>
                          <TextBlock Text="  •  " FontSize="10" Foreground="#66778F"/>
                          <TextBlock Text="{Binding SelectedItem.ActivityLabel, ElementName=TimelineList}" FontSize="10" Foreground="#66778F"/>
                          <TextBlock Text="  •  " FontSize="10" Foreground="#66778F"/>
                          <TextBlock Text="{Binding SelectedItem.CreatedAt, ElementName=TimelineList, StringFormat={}{0:h:mm tt}}" FontSize="10" Foreground="#66778F" TextWrapping="NoWrap"/>
                        </WrapPanel>
                      </StackPanel>
                      <Button Grid.Column="2" Width="30" Height="30" Padding="0"
                              Style="{StaticResource IconButtonStyle}" Click="FavoriteSelected_Click" ToolTip="Favorite">
                        <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7A8798"/>
                      </Button>
                      <Button Grid.Column="3" Width="28" Height="30" Padding="0"
                              Style="{StaticResource IconButtonStyle}" ToolTip="More">
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7A8798"/>
                      </Button>
                    </Grid>

                    <Border Height="1" Background="#D8E1EC" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="App" FontSize="10" Foreground="#66778F"/>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedItem.SourceApp, ElementName=TimelineList}" FontSize="10" Foreground="#1A2438" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Type" FontSize="10" Foreground="#66778F"/>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedItem.ActivityLabel, ElementName=TimelineList}" FontSize="10" Foreground="#1A2438"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Time" FontSize="10" Foreground="#66778F"/>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedItem.CreatedAt, ElementName=TimelineList, StringFormat={}{0:MMM d, yyyy h:mm tt}}" FontSize="10" Foreground="#1A2438" TextWrapping="Wrap" LineHeight="15" MinHeight="16"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Window" FontSize="10" Foreground="#66778F"/>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedItem.Title, ElementName=TimelineList}" FontSize="10" Foreground="#1A2438" TextWrapping="Wrap"/>
                    </Grid>

                    <Border Height="1" Background="#D8E1EC" Margin="0,4,0,12"/>

                    <Button Height="40" Style="{StaticResource PrimaryButtonStyle}" Click="OpenSelected_Click">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock Text="Open Source"/>
                      </StackPanel>
                    </Button>
                    <Button Height="36" Margin="0,8,0,0" Click="CopySelectedTitle_Click">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock Text="Copy Subject"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- PRIVACY -->
            <ScrollViewer x:Name="InsightsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel Margin="4,4,20,30">
          <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Insights" FontSize="28" FontWeight="Bold" Foreground="#1A2438"/>
            <TextBlock Text="A quick view of how your day is distributed." FontSize="13" Foreground="#66778F" Margin="0,6,0,0"/>
          </StackPanel>
          <UniformGrid Columns="2" Margin="0,0,0,18">
            <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,12,12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="All" Width="42" Height="42"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="InsightsTotalActivitiesText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Total Activities" Foreground="#66778F" FontSize="12"/></StackPanel>
              </Grid>
            </Border>
            <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Productivity" Width="42" Height="42"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="InsightsAppsUsedText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Apps Used" Foreground="#66778F" FontSize="12"/></StackPanel>
              </Grid>
            </Border>
            <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,12,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Favorites" Width="42" Height="42"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="InsightsFavoritesText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Favorites" Foreground="#66778F" FontSize="12"/></StackPanel>
              </Grid>
            </Border>
            <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="18" Padding="16">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Clipboard" Width="42" Height="42"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="InsightsClipboardText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1A2438"/><TextBlock Text="Clipboard Items" Foreground="#66778F" FontSize="12"/></StackPanel>
              </Grid>
            </Border>
          </UniformGrid>
          <Border Background="#E6EDF5" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="16" Padding="18">
            <StackPanel>
              <TextBlock Text="Activity by Category" FontSize="16" FontWeight="SemiBold" Foreground="#1A2438" Margin="0,0,0,12"/>
              <TextBlock x:Name="InsightsCategoryText" Text="Open a few apps to build today's category distribution." Foreground="#40506A" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

<ScrollViewer x:Name="PrivacyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="Privacy" FontSize="31" FontWeight="Bold" Foreground="#1A2438"/>
          <TextBlock Text="Memory Trail is privacy-first by design and gives you direct control over what is captured."
                     Margin="0,7,0,22" FontSize="14" Foreground="#66778F"/>
          <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1"
                  CornerRadius="19" Padding="21" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Local processing and storage" FontSize="17" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="Your activity history is sourced, processed, and stored locally on this PC. Memory Trail does not require a cloud account for its timeline."
                         Margin="0,6,0,0" Foreground="#40506A" TextWrapping="Wrap"/>
              <Border Background="#EAF7F0" BorderBrush="#CDE9D8" BorderThickness="1"
                      CornerRadius="12" Padding="11" Margin="0,12,0,0">
                <TextBlock Text="No timeline data is designed to be sent outside this computer."
                           Foreground="#247553" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </Border>
          <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1"
                  CornerRadius="19" Padding="21" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="No outside connectors" FontSize="17" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="Memory Trail's timeline is designed to operate locally and does not depend on external connectors or cloud services to capture, search, or display your activity."
                         Margin="0,6,0,12" Foreground="#40506A" TextWrapping="Wrap"/>
              <TextBlock Text="Open source transparency" FontSize="15" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="The source code is available for review so users and administrators can inspect and verify how capture, storage, and privacy controls are implemented."
                         Margin="0,5,0,0" Foreground="#40506A" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1"
                  CornerRadius="19" Padding="21">
            <StackPanel>
              <TextBlock Text="Capture controls" FontSize="17" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="Pause capture at any time, disable clipboard capture, or exclude applications and services."
                         Margin="0,6,0,13" Foreground="#40506A" TextWrapping="Wrap"/>
              <Button Content="Open Settings" Tag="Settings" Click="NavButton_Click" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- SETTINGS -->
      <!-- ASK MEMORY TRAIL -->
      <Grid x:Name="AskMemoryTrailPanel" Visibility="Collapsed" Margin="28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,2,4,18">
          <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="14" Background="#E5EAFF" Margin="0,0,12,0">
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#1680FF" FontSize="17"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Ask Memory Trail" FontSize="31" FontWeight="SemiBold" Foreground="#1A2438" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Ask about a time, app, page, email, chat, file, or project. Answers are generated locally from your captured timeline."
                     Foreground="#66778F" FontSize="13" Margin="1,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
          <Border Background="#E9F0F6" BorderBrush="#C4D1E0" BorderThickness="1"
                  CornerRadius="22" Padding="15,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#66778F"
                         FontSize="17" VerticalAlignment="Center" Margin="2,0,10,0"/>
              <TextBox x:Name="AskMemoryTrailBox" Grid.Column="1"
                       BorderThickness="0" Background="Transparent"
                       Foreground="#1A2438" CaretBrush="#1A2438"
                       Padding="0" FontSize="14"
                       KeyDown="AskMemoryTrailBox_KeyDown"
                       ToolTip="Ask Memory Trail"/>
              <Button x:Name="AskMemoryTrailButton" Grid.Column="2"
                      Click="AskMemoryTrail_Click"
                      Background="#1680FF" Foreground="White"
                      BorderThickness="0" Padding="14,6" Margin="10,0,0,0"
                      Content="Ask →"/>
            </Grid>
          </Border>

          <WrapPanel Margin="0,12,0,0">
            <Button Tag="What was I doing earlier today?" Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="10,7">
              <StackPanel Orientation="Horizontal">
                <local:CategoryIcon Category="Productivity" Width="22" Height="22" Margin="0,0,7,0"/>
                <TextBlock Text="Earlier today" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Tag="Show my activity from this week" Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="10,7">
              <StackPanel Orientation="Horizontal">
                <local:CategoryIcon Category="All" Width="22" Height="22" Margin="0,0,7,0"/>
                <TextBlock Text="This week" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Tag="Find files I worked on recently" Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="10,7">
              <StackPanel Orientation="Horizontal">
                <local:CategoryIcon Category="Files" Width="22" Height="22" Margin="0,0,7,0"/>
                <TextBlock Text="Recent files" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Tag="What emails did I view recently?" Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="10,7">
              <StackPanel Orientation="Horizontal">
                <local:CategoryIcon Category="Email" Width="22" Height="22" Margin="0,0,7,0"/>
                <TextBlock Text="Recent email" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Tag="What conversations did I have today?" Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="10,7">
              <StackPanel Orientation="Horizontal">
                <local:CategoryIcon Category="Chat" Width="22" Height="22" Margin="0,0,7,0"/>
                <TextBlock Text="Today’s chats" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Tag="What websites did I visit?" Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="10,7">
              <StackPanel Orientation="Horizontal">
                <local:CategoryIcon Category="Browser" Width="22" Height="22" Margin="0,0,7,0"/>
                <TextBlock Text="Visited websites" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Tag="Show my most recent activity" Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="10,7">
              <StackPanel Orientation="Horizontal">
                <local:CategoryIcon Category="Productivity" Width="22" Height="22" Margin="0,0,7,0"/>
                <TextBlock Text="Recent activity" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Tag="Find a project I worked on" Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="10,7">
              <StackPanel Orientation="Horizontal">
                <local:CategoryIcon Category="Development" Width="22" Height="22" Margin="0,0,7,0"/>
                <TextBlock Text="Find a project" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1"
                CornerRadius="22" Padding="22">
          <Grid>
            <Grid x:Name="AskEmptyState">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <Border Width="82" Height="82" CornerRadius="20" Background="#F6F9FC"
                        BorderBrush="#D7E2EE" BorderThickness="1"
                        Padding="7" HorizontalAlignment="Center" Margin="0,0,0,18">
                  <Image Source="{Binding Source={x:Static local:Branding.IconSource}}"
                         Width="66" Height="66" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="Your workday is searchable"
                           Foreground="#1A2438" FontWeight="SemiBold" FontSize="25"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Memory Trail can reason over captured timestamps, application names, window titles, URLs, filenames, and local file paths without sending your history to a cloud service."
                           Foreground="#66778F" FontSize="13" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,10,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Border Background="#F0F5FC" CornerRadius="12" Padding="9,5" Margin="0,0,8,0"><TextBlock Text="Time-aware" Foreground="#5D6C82" FontSize="11" FontWeight="SemiBold"/></Border>
                  <Border Background="#EEF4FF" CornerRadius="12" Padding="9,5" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="All" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="App-aware" Foreground="#5D6C82" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
                  <Border Background="#EAF4FF" CornerRadius="12" Padding="9,5" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Files" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="File-aware" Foreground="#5D6C82" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
                  <Border Background="#E8F5FF" CornerRadius="12" Padding="9,5"><TextBlock Text="Local only" Foreground="#3B78B8" FontSize="11" FontWeight="SemiBold"/></Border>
                </StackPanel>
              </StackPanel>
            </Grid>

            <Grid x:Name="AskResultsState" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Background="#F6F9FC" BorderBrush="#D5E1ED" BorderThickness="1"
                      CornerRadius="16" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Memory Trail" Foreground="#6CAEFF" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="AskAnswerText" Foreground="#1A2438" FontSize="15"
                             TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>

              <ListView x:Name="AskResultsList" Grid.Row="1"
                        Background="Transparent" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#E3EBF3" BorderBrush="#C3D0DE" BorderThickness="1"
                            CornerRadius="13" Padding="13">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="50"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#EEF3F9">
                          <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                                 Width="32" Height="32" Stretch="Uniform"
                                 RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding SourceApp}" Foreground="#1A2438" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Title}" Foreground="#66778F" FontSize="12"
                                     TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat={}{0:MMM d · h:mm tt}}"
                                   Foreground="#9F978F" FontSize="11" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
          <TextBlock Text="Settings" FontSize="31" FontWeight="Bold" Foreground="#1A2438"/>
          <TextBlock Text="Control what Memory Trail remembers, how it behaves, and review its privacy-first design."
                     Margin="0,7,0,22" FontSize="14" Foreground="#66778F"/>

          <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="19" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Capture" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="Choose what Memory Trail remembers." Margin="0,5,0,16" Foreground="#66778F"/>
              <CheckBox x:Name="PauseCaptureCheckBox" Content="Pause all capture" Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="AppCaptureCheckBox" Content="Remember app switches and focused windows" Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="ClipboardCaptureCheckBox" Content="Remember copied text" Checked="SettingChanged" Unchecked="SettingChanged"/>
            </StackPanel>
          </Border>

          <Border Background="#E3EBF3" BorderBrush="#C3D0DE" BorderThickness="1"
                  CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="36" Height="36" Background="#E5F1FF" CornerRadius="10" Margin="0,0,10,0">
                  <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#347FD1"
                             FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Privacy &amp; Transparency" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
                  <TextBlock Text="Privacy first by design" Foreground="#66778F" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>

              <TextBlock Text="Memory Trail is designed as a private, locally run application. Activity used by the timeline is sourced, processed, and stored on this computer."
                         Foreground="#40506A" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"/>

              <Border Background="#F8FBFF" BorderBrush="#DDE7F2" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#347FD1" Width="28"/>
                  <StackPanel>
                    <TextBlock Text="Local data only" Foreground="#1A2438" FontWeight="SemiBold"/>
                    <TextBlock Text="Captured timeline data remains stored locally on this PC." Foreground="#66778F" FontSize="12" Margin="0,3,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="#F6F9FC" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#4F78D7" Width="28"/>
                  <StackPanel>
                    <TextBlock Text="No external connectors" Foreground="#1A2438" FontWeight="SemiBold"/>
                    <TextBlock Text="The timeline does not require external connectors or cloud services to capture, search, or display activity." Foreground="#66778F" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="#F6F9FC" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2F8BCB" Width="28"/>
                  <StackPanel>
                    <TextBlock Text="Source available for verification" Foreground="#1A2438" FontWeight="SemiBold"/>
                    <TextBlock Text="The source code is available for review so you can inspect how Memory Trail captures, stores, and protects data." Foreground="#66778F" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="19" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Privacy exclusions" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="One Windows process name per line. Excluded apps are not intentionally recorded."
                         Margin="0,5,0,14" Foreground="#66778F" TextWrapping="Wrap"/>
              <TextBox x:Name="ExclusionsBox" AcceptsReturn="True" MinHeight="110"/>
              <Button Content="Apply exclusions" Margin="0,12,0,0" HorizontalAlignment="Left" Click="ApplyExclusions_Click"/>
            </StackPanel>
          </Border>

          <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="19" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
              <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Memory Trail when I sign in to Windows"
                        Margin="0,14,0,0" Checked="StartWithWindowsChanged" Unchecked="StartWithWindowsChanged"/>
            </StackPanel>
          </Border>

          <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="19" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="40" Height="40" CornerRadius="12" Background="#E5F1FF" Margin="0,0,11,0">
                  <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#347FD1"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="About Memory Trail" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
                  <TextBlock Text="Version 1.0 (Build 1)" FontSize="12" Foreground="#66778F" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="Memory Trail is a private, local-first, open-source Windows activity timeline. Review the source code, privacy implementation, release information, and project history on GitHub."
                         Foreground="#40506A" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"/>
              <Button Click="OpenGitHub_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                  <TextBlock Text="View Memory Trail on GitHub" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1" CornerRadius="19" Padding="22">
            <StackPanel>
              <TextBlock Text="Maintenance" FontSize="18" FontWeight="SemiBold" Foreground="#1A2438"/>
              <TextBlock Text="Tutorial, reset, and history controls." Margin="0,5,0,14" Foreground="#66778F"/>
              <WrapPanel>
                <Button Content="Show tutorial" Click="ShowTutorial_Click" Margin="0,0,8,8"/>
                <Button Content="Reset preferences" Click="ClearCache_Click" Margin="0,0,8,8"/>
                <Button x:Name="ClearTimelineButton" Content="Clear history" Click="ClearTimeline_Click" Margin="0,0,8,8"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>