<Window x:Class="MemoryLane.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemoryLane.Windows"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Memory Trail v0.8.2"
        Width="1540" Height="900"
        MinWidth="1240" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F8FC">
  <Window.Resources>
    <local:AppIconConverter x:Key="AppIconConverter"/>

    <Style x:Key="MetricCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D5E1EE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <Style x:Key="FilterNavStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="TimelineChipStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="SummaryProgressStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Background" Value="#F3F7FB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
              <Border x:Name="PART_Indicator"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="5"
                      HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="268"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- LEFT SIDEBAR -->
    <Border Grid.Column="0" Background="#EEF4FB" BorderBrush="#D8E4F1" BorderThickness="0,0,1,0">
      <Grid Margin="16,18,14,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,24">
          <Border Width="58" Height="58" Background="#FFFFFF"
                  BorderBrush="#D7E2EE" BorderThickness="1" CornerRadius="16"
                  Padding="5" ClipToBounds="False">
            <Image x:Name="BrandLogo" Width="46" Height="46"
                   Stretch="Uniform" StretchDirection="DownOnly"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Memory Trail" FontSize="20" FontWeight="SemiBold" Foreground="#17233A"/>
            <TextBlock Text="v0.8.2" FontSize="10" Foreground="#66768B" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="TimelineNavButton" Tag="Timeline" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Background="#DCEBFF" Foreground="White" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="30" FontSize="18"/>
              <TextBlock Text="Today" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
          <Button x:Name="AskMemoryTrailNavButton" Tag="Ask" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Width="30" FontSize="17"/>
              <TextBlock Text="Ask Memory Trail"/>
            </StackPanel>
          </Button>
          <Button x:Name="FavoritesNavButton" Tag="Favorites" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" Width="30"/>
              <TextBlock Text="Favorites"/>
            </StackPanel>
          </Button>
          <Button x:Name="ClipboardNavButton" Tag="Clipboard" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" Width="30"/>
              <TextBlock Text="Clipboard"/>
            </StackPanel>
          </Button>
          <Button x:Name="NotesNavButton" Tag="Notes" Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" Width="30"/>
              <TextBlock Text="Notes"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,18,0,12">
          <StackPanel>
            <Border Height="1" Background="#D8E4F1" Margin="6,0,6,16"/>
            <TextBlock Text="Filters" Foreground="#66768B" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,8"/>

            <Button x:Name="AllAppsFilter" Tag="All"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click"
                    Background="#F1F5FA">
              <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="8" Background="#E4F0FF" Margin="0,0,10,0">
                  <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="#2478E8"
                             FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="All Activity" VerticalAlignment="Center" Foreground="#40516A"/>
              </StackPanel>
            </Button>
            <Button x:Name="BrowserFilter" Tag="Browser"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click">
              <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="8" Background="#E3F8F2" Margin="0,0,10,0">
                  <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="#169B77"
                             FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Web Browsers" VerticalAlignment="Center" Foreground="#40516A"/>
              </StackPanel>
            </Button>
            <Button x:Name="EmailFilter" Tag="Email"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click">
              <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="8" Background="#FFF1D9" Margin="0,0,10,0">
                  <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" Foreground="#D98213"
                             FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Email" VerticalAlignment="Center" Foreground="#40516A"/>
              </StackPanel>
            </Button>
            <Button x:Name="ChatFilter" Tag="Chat"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click">
              <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="8" Background="#EEE8FF" Margin="0,0,10,0">
                  <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" Foreground="#7357DA"
                             FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Chat &amp; Meetings" VerticalAlignment="Center" Foreground="#40516A"/>
              </StackPanel>
            </Button>
            <Button x:Name="FilesFilter" Tag="Files"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click">
              <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="8" Background="#FFF4CF" Margin="0,0,10,0">
                  <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#C58A14"
                             FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Files &amp; Documents" VerticalAlignment="Center" Foreground="#40516A"/>
              </StackPanel>
            </Button>
            <Button x:Name="OfficeFilter" Tag="Office"
                    Style="{StaticResource FilterNavStyle}" Click="Category_Click">
              <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="8" Background="#E7F0FF" Margin="0,0,10,0">
                  <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#4E68D8"
                             FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Productivity" VerticalAlignment="Center" Foreground="#40516A"/>
              </StackPanel>
            </Button>

            <Border Height="1" Background="#D8E4F1" Margin="6,16"/>
            <Button x:Name="PrivacyNavButton" Tag="Privacy" Click="NavButton_Click"
                    Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Width="30"/>
                <TextBlock Text="Privacy"/>
              </StackPanel>
            </Button>
            <Button x:Name="SettingsNavButton" Tag="Settings" Click="NavButton_Click"
                    Style="{StaticResource NavButtonStyle}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="30"/>
                <TextBlock Text="Settings"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#D5E1EE" BorderThickness="1"
                CornerRadius="14" Padding="12">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,8,0"/>
              <TextBlock x:Name="StatusText" FontSize="12" Foreground="#66768B" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="PauseButton" Click="PauseButton_Click" Style="{StaticResource NavButtonStyle}"
                    Margin="0,7,0,0" Padding="0,7" HorizontalContentAlignment="Left"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- MAIN CONTENT -->
    <Grid Grid.Column="1" Margin="20">
      <Grid x:Name="ActivityShell">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Your day, at a glance" Foreground="#66768B" FontSize="13"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="#4ADE80" Margin="0,0,7,0"/>
            <TextBlock Text="Capturing" Foreground="#17233A" Margin="0,0,18,0"/>
            <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}}" Visibility="Collapsed"/>
            <TextBlock Text="Today" Foreground="#40516A"/>
          </StackPanel>
        </Grid>

        <!-- HEADER -->
        <Grid Grid.Row="1" Margin="4,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Today" FontSize="32" FontWeight="SemiBold" Foreground="#17233A"/>
            <TextBlock Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat={}{0:dddd, MMMM d, yyyy}}"
                       Foreground="#66768B" FontSize="14" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Items.Count, ElementName=TimelineList}" Foreground="#40516A"
                       FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text=" activities" Foreground="#66768B" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition x:Name="DetailsSpacerColumn" Width="16"/>
            <ColumnDefinition x:Name="DetailsColumn" Width="0.9*"/>
          </Grid.ColumnDefinitions>

          <!-- TIMELINE -->
          <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D7E2EE" BorderThickness="1"
                  CornerRadius="18" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                <TextBlock Text="☀" FontSize="25" Foreground="#FFB347" Margin="0,0,10,0"/>
                <StackPanel>
                  <TextBlock Text="Your activity timeline" Foreground="#17233A" FontWeight="SemiBold" FontSize="17"/>
                  <TextBlock Text="Newest activity first — live context stays at the top" Foreground="#66768B" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>

              <ListView x:Name="TimelineList" Grid.Row="1"
                        AlternationCount="100000"
                        Background="Transparent" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="TimelineList_SelectionChanged"
                        MouseDoubleClick="TimelineList_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                          <Border x:Name="Row" Background="{TemplateBinding Background}"
                                  CornerRadius="14" Margin="1,3" Padding="0"
                                  BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="#F1F5FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="#E7F1FF"/>
                              <Setter TargetName="Row" Property="BorderBrush" Value="#4E9CF1"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid Height="66" Margin="10,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                      </Grid.ColumnDefinitions>

                      <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}"
                                 Foreground="#66768B" FontSize="12" VerticalAlignment="Center"/>

                      <Border Grid.Column="1" Width="44" Height="44" Background="#F3F7FB" CornerRadius="11"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                               Width="36" Height="36" Stretch="Uniform"
                               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                      </Border>

                      <StackPanel Grid.Column="2" Margin="10,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding SourceApp}" Foreground="#17233A" FontWeight="SemiBold"
                                     FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                          <Border x:Name="LiveActivityBadge" Visibility="Collapsed"
                                  Background="#E5F8ED" BorderBrush="#BDE9CD" BorderThickness="1"
                                  CornerRadius="10" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <Ellipse Width="7" Height="7" Fill="#22B85C" Margin="0,0,5,0"/>
                              <TextBlock Text="LIVE ACTIVITY" Foreground="#178445" FontSize="9" FontWeight="SemiBold"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="#66768B" FontSize="12"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>

                      <Border Grid.Column="3" Style="{StaticResource TimelineChipStyle}"
                              Background="#34577E" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceKind}" Foreground="#EDF4FA" FontSize="11"/>
                      </Border>

                      <Button Grid.Column="4" Width="34" Height="34" Content="☆" FontSize="17"
                              Style="{StaticResource IconButtonStyle}" Tag="{Binding}"
                              Click="Favorite_Click" ToolTip="Favorite"
                              VerticalAlignment="Center"/>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                        <Setter TargetName="LiveActivityBadge" Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>

          <!-- RIGHT RAIL: SUMMARY + DETAILS -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition x:Name="DetailsGapRow" Height="12"/>
              <RowDefinition x:Name="DetailsRow" Height="*"/>
            </Grid.RowDefinitions>

            <!-- TODAY SUMMARY -->
            <Border Background="#FFFFFF" BorderBrush="#D7E2EE" BorderThickness="1"
                    CornerRadius="18" Padding="16">
              <StackPanel>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="10" Background="#3A2F28" Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Border Width="4" Height="13" Background="#FF8A34" CornerRadius="2" Margin="0,0,3,0"/>
                      <Border Width="4" Height="21" Background="#FFA446" CornerRadius="2" Margin="0,0,3,0"/>
                      <Border Width="4" Height="16" Background="#FFB95E" CornerRadius="2"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Column="1" Text="Today Summary" Foreground="#17233A"
                             FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="ShowDetailsButton" Grid.Column="2" Content="Details"
                          Style="{StaticResource ChipButtonStyle}" Click="ShowDetailsPane_Click"
                          Visibility="Collapsed" Padding="10,6" Margin="8,0,0,0"/>
                </Grid>

                <UniformGrid Columns="2" Margin="0,0,0,12">
                  <Border Style="{StaticResource MetricCardStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="10" Background="#234B72" VerticalAlignment="Center">
                        <TextBlock Text="▥" Foreground="#5CC8FF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalActivitiesText" Text="0" Foreground="#17233A" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Total Activities" Foreground="#66768B" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Style="{StaticResource MetricCardStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="10" Background="#244C77" VerticalAlignment="Center">
                        <TextBlock Text="▦" Foreground="#4E8FFF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AppsUsedText" Text="0" Foreground="#17233A" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Apps Used" Foreground="#66768B" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Style="{StaticResource MetricCardStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="18" Background="#20C5D6" VerticalAlignment="Center">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#10232A"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ActiveTimeText" Text="0m" Foreground="#17233A" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Active Time" Foreground="#66768B" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Style="{StaticResource MetricCardStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="10" Background="#D98A38" VerticalAlignment="Center">
                        <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" Foreground="#FFF2DF"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ClipboardItemsText" Text="0" Foreground="#17233A" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Clipboard Items" Foreground="#66768B" FontSize="11"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </UniformGrid>

                <Grid Margin="2,2,2,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Top Apps" Foreground="#17233A" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock Grid.Column="1" Text="Today" Foreground="#8CB9F1" FontSize="11"/>
                </Grid>

                <Grid Margin="2,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <Image x:Name="TopApp1Icon" Width="23" Height="23" Stretch="Uniform"/>
                  <TextBlock x:Name="TopApp1Name" Grid.Column="1" Foreground="#40516A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="TopApp1Bar" Grid.Column="2" Style="{StaticResource SummaryProgressStyle}" Foreground="#249CFF" Margin="8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TopApp1Count" Grid.Column="3" Foreground="#53647A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="2,5,2,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <Image x:Name="TopApp2Icon" Width="23" Height="23" Stretch="Uniform"/>
                  <TextBlock x:Name="TopApp2Name" Grid.Column="1" Foreground="#40516A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="TopApp2Bar" Grid.Column="2" Style="{StaticResource SummaryProgressStyle}" Foreground="#37D39D" Margin="8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TopApp2Count" Grid.Column="3" Foreground="#53647A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="2,5,2,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <Image x:Name="TopApp3Icon" Width="23" Height="23" Stretch="Uniform"/>
                  <TextBlock x:Name="TopApp3Name" Grid.Column="1" Foreground="#40516A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="TopApp3Bar" Grid.Column="2" Style="{StaticResource SummaryProgressStyle}" Foreground="#7562F4" Margin="8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TopApp3Count" Grid.Column="3" Foreground="#53647A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="2,5,2,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <Image x:Name="TopApp4Icon" Width="23" Height="23" Stretch="Uniform"/>
                  <TextBlock x:Name="TopApp4Name" Grid.Column="1" Foreground="#40516A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="TopApp4Bar" Grid.Column="2" Style="{StaticResource SummaryProgressStyle}" Foreground="#FF9B48" Margin="8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TopApp4Count" Grid.Column="3" Foreground="#53647A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="2,5,2,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                  <Image x:Name="TopApp5Icon" Width="23" Height="23" Stretch="Uniform"/>
                  <TextBlock x:Name="TopApp5Name" Grid.Column="1" Foreground="#40516A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar x:Name="TopApp5Bar" Grid.Column="2" Style="{StaticResource SummaryProgressStyle}" Foreground="#7A67F0" Margin="8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TopApp5Count" Grid.Column="3" Foreground="#53647A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- DETAILS -->
            <Border x:Name="DetailsPanel" Grid.Row="2" Background="#FFFFFF"
                    BorderBrush="#D7E2EE" BorderThickness="1" CornerRadius="18" Padding="16">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" Background="#F3F7FB" CornerRadius="12">
                      <Image Source="{Binding SelectedItem, ElementName=TimelineList, Converter={StaticResource AppIconConverter}}"
                             Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SelectedItem.SourceApp, ElementName=TimelineList, TargetNullValue=Select an activity}"
                                 Foreground="#17233A" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding SelectedItem.CreatedAt, ElementName=TimelineList, StringFormat={}{0:h:mm tt}}"
                                 Foreground="#66768B" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Width="38" Height="38" Padding="0"
                            Style="{StaticResource IconButtonStyle}" Click="HideDetailsPane_Click"
                            ToolTip="Close details" HorizontalAlignment="Right">
                      <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#40516A"/>
                    </Button>
                  </Grid>

                  <TextBlock Text="{Binding SelectedItem.Title, ElementName=TimelineList, TargetNullValue=Details appear here}"
                             Foreground="#17233A" FontSize="16" FontWeight="SemiBold"
                             TextWrapping="Wrap" Margin="0,0,0,16"/>

                  <Border Height="1" Background="#DCE5EF" Margin="0,0,0,14"/>

                  <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="App" Foreground="#7A889B" FontSize="11" Margin="0,0,0,9"/>
                      <TextBlock Text="Time" Foreground="#7A889B" FontSize="11" Margin="0,0,0,9"/>
                      <TextBlock Text="Source" Foreground="#7A889B" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding SelectedItem.SourceApp, ElementName=TimelineList, TargetNullValue=—}" Foreground="#40516A" FontSize="12" Margin="0,0,0,9"/>
                      <TextBlock Text="{Binding SelectedItem.CreatedAt, ElementName=TimelineList, StringFormat={}{0:MMM d, yyyy • h:mm:ss tt}}" Foreground="#40516A" FontSize="12" Margin="0,0,0,9"/>
                      <TextBlock Text="{Binding SelectedItem.SourceUrl, ElementName=TimelineList, TargetNullValue=Local activity}" Foreground="#8CC5FF" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>

                  <Button Content="↗  Open Again" Click="OpenSelected_Click"
                          Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                  <Button Content="▣  Copy Title" Click="CopySelectedTitle_Click"
                          HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                  <Button Content="☆  Add to Favorites" Click="FavoriteSelected_Click"
                          HorizontalAlignment="Stretch"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- PRIVACY -->
      <ScrollViewer x:Name="PrivacyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="Privacy" FontSize="30" FontWeight="SemiBold" Foreground="#17233A"/>
          <TextBlock Text="Memory Trail is local-first and gives you direct control over what is captured."
                     Margin="0,7,0,22" FontSize="14" Foreground="#66768B"/>
          <Border Background="#FFFFFF" BorderBrush="#D5E1EE" BorderThickness="1"
                  CornerRadius="16" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Local-only timeline" FontSize="17" FontWeight="SemiBold" Foreground="#17233A"/>
              <TextBlock Text="Your activity history is stored on this PC. Memory Trail does not require a cloud account."
                         Margin="0,6,0,0" Foreground="#53647A" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Background="#FFFFFF" BorderBrush="#D5E1EE" BorderThickness="1"
                  CornerRadius="16" Padding="20">
            <StackPanel>
              <TextBlock Text="Capture controls" FontSize="17" FontWeight="SemiBold" Foreground="#17233A"/>
              <TextBlock Text="Pause capture at any time, disable clipboard capture, or exclude applications and services."
                         Margin="0,6,0,13" Foreground="#53647A" TextWrapping="Wrap"/>
              <Button Content="Open Settings" Tag="Settings" Click="NavButton_Click" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- SETTINGS -->
      <!-- ASK MEMORY TRAIL -->
      <Grid x:Name="AskMemoryTrailPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,2,4,18">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="✦" Foreground="#2F8CFF" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Ask Memory Trail" FontSize="32" FontWeight="SemiBold" Foreground="#17233A"/>
          </StackPanel>
          <TextBlock Text="Ask about a time, app, page, email, chat, file, or project. Answers are generated locally from your captured timeline."
                     Foreground="#66768B" FontSize="13" Margin="1,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
          <Border Background="#FFFFFF" BorderBrush="#D4E0ED" BorderThickness="1"
                  CornerRadius="18" Padding="14,11">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#66768B"
                         FontSize="17" VerticalAlignment="Center" Margin="2,0,10,0"/>
              <TextBox x:Name="AskMemoryTrailBox" Grid.Column="1"
                       BorderThickness="0" Background="Transparent"
                       Foreground="#17233A" CaretBrush="#17233A"
                       Padding="0" FontSize="14"
                       KeyDown="AskMemoryTrailBox_KeyDown"
                       ToolTip="Ask Memory Trail"/>
              <Button x:Name="AskMemoryTrailButton" Grid.Column="2"
                      Click="AskMemoryTrail_Click"
                      Background="#2F8CFF" Foreground="White"
                      BorderThickness="0" Padding="14,6" Margin="10,0,0,0"
                      Content="Ask →"/>
            </Grid>
          </Border>

          <WrapPanel Margin="0,12,0,0">
            <Button Content="◷  What was I doing earlier today?" Tag="What was I doing earlier today?"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="▣  Show my activity from this week" Tag="Show my activity from this week"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="▤  Find files I worked on recently" Tag="Find files I worked on recently"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="✉  What emails did I view recently?" Tag="What emails did I view recently?"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="◉  What conversations did I have today?" Tag="What conversations did I have today?"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="◎  What websites did I visit?" Tag="What websites did I visit?"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="⌁  Show my most recent activity" Tag="Show my most recent activity"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
            <Button Content="⌕  Find a project I worked on" Tag="Find a project I worked on"
                    Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="13,8"/>
          </WrapPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D7E2EE" BorderThickness="1"
                CornerRadius="18" Padding="20">
          <Grid>
            <Grid x:Name="AskEmptyState">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <Border Width="82" Height="82" CornerRadius="20" Background="#FFFFFF"
                        BorderBrush="#D7E2EE" BorderThickness="1"
                        Padding="7" HorizontalAlignment="Center" Margin="0,0,0,18">
                  <Image Source="{Binding Source={x:Static local:Branding.IconSource}}"
                         Width="66" Height="66" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="Your workday is searchable"
                           Foreground="#17233A" FontWeight="SemiBold" FontSize="25"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Memory Trail can reason over captured timestamps, application names, window titles, URLs, filenames, and local file paths without sending your history to a cloud service."
                           Foreground="#66768B" FontSize="13" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,10,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="◷  Time-aware" Foreground="#66768B" Margin="0,0,18,0"/>
                  <TextBlock Text="▣  App-aware" Foreground="#66768B" Margin="0,0,18,0"/>
                  <TextBlock Text="▤  File-aware" Foreground="#66768B" Margin="0,0,18,0"/>
                  <TextBlock Text="◉  Local" Foreground="#66768B"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <Grid x:Name="AskResultsState" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Background="#F7FAFD" BorderBrush="#D5E1ED" BorderThickness="1"
                      CornerRadius="14" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Memory Trail" Foreground="#6CAEFF" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="AskAnswerText" Foreground="#17233A" FontSize="15"
                             TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>

              <ListView x:Name="AskResultsList" Grid.Row="1"
                        Background="Transparent" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#FFFFFF" BorderBrush="#D7E2EE" BorderThickness="1"
                            CornerRadius="13" Padding="13">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="50"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#F3F7FB">
                          <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                                 Width="32" Height="32" Stretch="Uniform"
                                 RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding SourceApp}" Foreground="#17233A" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Title}" Foreground="#66768B" FontSize="12"
                                     TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat={}{0:MMM d · h:mm tt}}"
                                   Foreground="#9F978F" FontSize="11" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
          <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Foreground="#17233A"/>
          <TextBlock Text="Control what Memory Trail remembers and how it behaves."
                     Margin="0,7,0,22" FontSize="14" Foreground="#66768B"/>

          <Border Background="#FFFFFF" BorderBrush="#D5E1EE" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Capture" FontSize="18" FontWeight="SemiBold" Foreground="#17233A"/>
              <TextBlock Text="Choose what Memory Trail remembers." Margin="0,5,0,16" Foreground="#66768B"/>
              <CheckBox x:Name="PauseCaptureCheckBox" Content="Pause all capture" Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="AppCaptureCheckBox" Content="Remember app switches and focused windows" Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="ClipboardCaptureCheckBox" Content="Remember copied text" Checked="SettingChanged" Unchecked="SettingChanged"/>
            </StackPanel>
          </Border>

          <Border Background="#FFFFFF" BorderBrush="#D5E1EE" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Privacy exclusions" FontSize="18" FontWeight="SemiBold" Foreground="#17233A"/>
              <TextBlock Text="One Windows process name per line. Excluded apps are not intentionally recorded."
                         Margin="0,5,0,14" Foreground="#66768B" TextWrapping="Wrap"/>
              <TextBox x:Name="ExclusionsBox" AcceptsReturn="True" MinHeight="110"/>
              <Button Content="Apply exclusions" Margin="0,12,0,0" HorizontalAlignment="Left" Click="ApplyExclusions_Click"/>
            </StackPanel>
          </Border>

          <Border Background="#FFFFFF" BorderBrush="#D5E1EE" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold" Foreground="#17233A"/>
              <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Memory Trail when I sign in to Windows"
                        Margin="0,14,0,0" Checked="StartWithWindowsChanged" Unchecked="StartWithWindowsChanged"/>
            </StackPanel>
          </Border>

          <Border Background="#FFFFFF" BorderBrush="#D5E1EE" BorderThickness="1" CornerRadius="16" Padding="22">
            <StackPanel>
              <TextBlock Text="Maintenance" FontSize="18" FontWeight="SemiBold" Foreground="#17233A"/>
              <TextBlock Text="Tutorial, reset, and history controls." Margin="0,5,0,14" Foreground="#66768B"/>
              <WrapPanel>
                <Button Content="Show tutorial" Click="ShowTutorial_Click" Margin="0,0,8,8"/>
                <Button Content="Reset preferences" Click="ClearCache_Click" Margin="0,0,8,8"/>
                <Button x:Name="ClearTimelineButton" Content="Clear history" Click="ClearTimeline_Click" Margin="0,0,8,8"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>