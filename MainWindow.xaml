<Window x:Class="MemoryLane.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemoryLane.Windows"
        Title="Memory Lane v0.1.14"
        Icon="{StaticResource MemoryLaneBrandIcon}"
        Width="1260" Height="800"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#EEF6FF">
  <Window.Resources>
    <local:AppIconConverter x:Key="AppIconConverter"/>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0"
            Background="#F8FBFF"
            BorderBrush="#D6E7F8"
            BorderThickness="0,0,1,0">
      <Grid Margin="14,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,2,4,24">
          <Image Source="{StaticResource MemoryLaneBrandIcon}"
                 Width="30" Height="30"
                 Stretch="Uniform"
                 Margin="0,0,9,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Memory Lane"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#10203B"/>
            <TextBlock Text="v0.1.14"
                       FontSize="10"
                       Foreground="#7790AA"
                       Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="TimelineNavButton"
                  Tag="Timeline"
                  Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}"
                  Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="◉" Width="22" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="Timeline"/>
            </StackPanel>
          </Button>

          <Button x:Name="SearchNavButton"
                  Tag="Search"
                  Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}"
                  Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⌕" Width="22" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="Search"/>
            </StackPanel>
          </Button>

          <Button x:Name="ApplicationsNavButton"
                  Tag="Applications"
                  Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}"
                  Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▦" Width="22" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="Applications"/>
            </StackPanel>
          </Button>

          <Button x:Name="SettingsNavButton"
                  Tag="Settings"
                  Click="NavButton_Click"
                  Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚙" Width="22" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="Settings"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="3">
          <Button Content="Pause Capture"
                  x:Name="PauseButton"
                  Style="{StaticResource NavButtonStyle}"
                  Click="PauseButton_Click"
                  HorizontalContentAlignment="Left"
                  Margin="0,0,0,5"/>

          <Button IsEnabled="False"
                  Style="{StaticResource NavButtonStyle}"
                  HorizontalContentAlignment="Left"
                  Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⇩" Width="22"/>
              <TextBlock Text="Export"/>
            </StackPanel>
          </Button>

          <Button x:Name="ClearTimelineButton"
                  Style="{StaticResource NavButtonStyle}"
                  Click="ClearTimeline_Click"
                  HorizontalContentAlignment="Left"
                  Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⌫" Width="22"/>
              <TextBlock Text="Clear History"/>
            </StackPanel>
          </Button>

          <StackPanel Orientation="Horizontal" Margin="10,4,0,0">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,7,0"/>
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Foreground="#71869D"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1" Margin="22,18,22,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="2,0,2,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock x:Name="PageTitle"
                     Text="Timeline"
                     FontSize="26"
                     FontWeight="SemiBold"
                     Foreground="#10203B"/>
          <TextBlock x:Name="PageSubtitle"
                     Text="See your activity in context"
                     Margin="0,3,0,0"
                     FontSize="12"
                     Foreground="#7489A0"/>
        </StackPanel>

        <Button Grid.Column="1"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="AddMemory_Click"
                Padding="14,9"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="+" Foreground="White" FontWeight="Bold" Margin="0,0,7,0"/>
            <TextBlock Text="Add Memory" Foreground="White"/>
          </StackPanel>
        </Button>
      </Grid>

      <Border Grid.Row="1"
              Background="#FFFFFF"
              BorderBrush="#D6E7F8"
              BorderThickness="1"
              CornerRadius="13"
              Padding="10"
              Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Background="#F8FBFF"
                  BorderBrush="#D6E7F8"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="11,7"
                  Margin="0,0,10,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="⌕"
                         FontSize="18"
                         Foreground="#4E8FD1"
                         VerticalAlignment="Center"/>
              <TextBox x:Name="SearchBox"
                       Grid.Column="1"
                       BorderThickness="0"
                       Background="Transparent"
                       Padding="8,2"
                       Foreground="#27415C"
                       TextChanged="SearchBox_TextChanged"
                       ToolTip="Search your activity"/>
            </Grid>
          </Border>

          <Button Grid.Column="1"
                  Content="▣  Today"
                  Style="{StaticResource ModernButtonStyle}"
                  IsEnabled="False"
                  Margin="0,0,8,0"/>

          <Button Grid.Column="2"
                  Content="▦  All Apps"
                  Style="{StaticResource ModernButtonStyle}"
                  IsEnabled="False"/>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Border x:Name="TimelineContainer"
                Background="#FFFFFF"
                BorderBrush="#D6E7F8"
                BorderThickness="1"
                CornerRadius="14"
                Padding="10,8">
          <ListView x:Name="TimelineList"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    MouseDoubleClick="TimelineList_MouseDoubleClick">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                      <Border x:Name="RowChrome"
                              Background="{TemplateBinding Background}"
                              CornerRadius="10"
                              Margin="2,1">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="RowChrome" Property="Background" Value="#F4F9FF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="RowChrome" Property="Background" Value="#EAF4FF"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0" Margin="8,9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20"/>
                      <ColumnDefinition Width="78"/>
                      <ColumnDefinition Width="48"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="90"/>
                      <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <!-- timeline rail -->
                    <Grid Grid.Column="0">
                      <Border Width="2"
                              Background="#D9EAFB"
                              HorizontalAlignment="Center"
                              Margin="0,-10,0,-10"/>
                      <Ellipse Width="8" Height="8"
                               Fill="#FFFFFF"
                               Stroke="#2F97FF"
                               StrokeThickness="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}"
                               FontSize="12"
                               Foreground="#73889F"
                               VerticalAlignment="Center"/>

                    <Border Grid.Column="2"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Background="#F0F6FC"
                            BorderBrush="#D9E7F5"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                      <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                             Width="28" Height="28"
                             Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="3"
                                Margin="10,0,12,0"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding SourceApp}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="#10203B"/>
                      <TextBlock Text="{Binding Title}"
                                 Margin="0,2,0,0"
                                 FontSize="12"
                                 Foreground="#60758C"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap"/>
                    </StackPanel>

                    <!-- preview tile -->
                    <Border Grid.Column="4"
                            Width="76" Height="44"
                            Background="#F5F9FE"
                            BorderBrush="#D6E6F6"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="7"
                            VerticalAlignment="Center">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="22"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                               Width="18" Height="18"
                               Stretch="Uniform"
                               VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Margin="5,2,0,0">
                          <Border Height="3" Background="#B9D3EC" CornerRadius="2" Margin="0,0,0,4"/>
                          <Border Height="3" Background="#D2E3F3" CornerRadius="2" Margin="0,0,8,4"/>
                          <Border Height="3" Background="#D2E3F3" CornerRadius="2" Margin="0,0,4,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Button Grid.Column="5"
                            Content="⋯"
                            Style="{StaticResource IconButtonStyle}"
                            Tag="{Binding}"
                            Click="Details_Click"
                            ToolTip="Open details"
                            Padding="8,5"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"/>
                  </Grid>

                  <Border Grid.Row="1" Background="#EDF4FB" Margin="20,0,8,0"/>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Border>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
          <StackPanel>
            <Border Background="#FFFFFF"
                    BorderBrush="#D6E7F8"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Capture"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#10203B"/>
                <CheckBox x:Name="PauseCaptureCheckBox"
                          Content="Pause all capture"
                          Margin="0,16,0,10"
                          Checked="SettingChanged"
                          Unchecked="SettingChanged"/>
                <CheckBox x:Name="AppCaptureCheckBox"
                          Content="Remember app switches and focused windows"
                          Margin="0,0,0,10"
                          Checked="SettingChanged"
                          Unchecked="SettingChanged"/>
                <CheckBox x:Name="ClipboardCaptureCheckBox"
                          Content="Remember copied text"
                          Checked="SettingChanged"
                          Unchecked="SettingChanged"/>
              </StackPanel>
            </Border>

            <Border Background="#FFFFFF"
                    BorderBrush="#D6E7F8"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Excluded Apps &amp; Services"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#10203B"/>
                <TextBlock Text="Enter Windows process names, one per line. Activity from excluded processes is not intentionally recorded."
                           Margin="0,8,0,12"
                           Foreground="#657B92"
                           TextWrapping="Wrap"/>
                <TextBox x:Name="ExclusionsBox"
                         AcceptsReturn="True"
                         MinHeight="110"/>
                <Button Content="Apply Exclusions"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Click="ApplyExclusions_Click"/>
              </StackPanel>
            </Border>

            <Border Background="#FFFFFF"
                    BorderBrush="#D6E7F8"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Windows"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#10203B"/>
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Start Memory Lane when I sign in to Windows"
                          Margin="0,16,0,0"
                          Checked="StartWithWindowsChanged"
                          Unchecked="StartWithWindowsChanged"/>
              </StackPanel>
            </Border>

            <Border Background="#FFFFFF"
                    BorderBrush="#D6E7F8"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22">
              <StackPanel>
                <TextBlock Text="Data &amp; Privacy"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#10203B"/>
                <TextBlock Text="Memory Lane stores your activity timeline locally on this PC."
                           Margin="0,8,0,14"
                           Foreground="#657B92"
                           TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="Show Welcome Tutorial" Click="ShowTutorial_Click"/>
                  <Button Content="Clear App Cache" Click="ClearCache_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>