<Window x:Class="MemoryLane.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemoryLane.Windows"
        Title="Memory Lane v0.1.9"
        Icon="Assets/MemoryLaneIcon.png"
        Width="1280" Height="820"
        MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3F8FF">
  <Window.Resources>
    <local:AppIconConverter x:Key="AppIconConverter"/>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- LIGHT WINDOWS SIDEBAR -->
    <Border Grid.Column="0"
            Background="#F8FBFF"
            BorderBrush="#D7E6F7"
            BorderThickness="0,0,1,0"
            Padding="18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,4,0,28">
            <Image Source="Assets/MemoryLaneIcon.png"
                   Width="34" Height="34"
                   Stretch="Uniform"
                   Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Memory Lane"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="#10203B"/>
              <TextBlock Text="v0.1.9 · Windows UI"
                         Margin="0,2,0,0"
                         FontSize="10"
                         Foreground="#6F87A3"/>
            </StackPanel>
          </StackPanel>

          <Button Content="⌂  Timeline"
                  Style="{StaticResource NavButtonStyle}"
                  Tag="Timeline"
                  Click="NavButton_Click"
                  HorizontalContentAlignment="Left"
                  Margin="0,0,0,8"/>
          <Button Content="⌕  Search"
                  Style="{StaticResource NavButtonStyle}"
                  Tag="Search"
                  Click="NavButton_Click"
                  HorizontalContentAlignment="Left"
                  Margin="0,0,0,8"/>
          <Button Content="☆  Favorites"
                  Style="{StaticResource NavButtonStyle}"
                  Tag="Favorites"
                  Click="NavButton_Click"
                  HorizontalContentAlignment="Left"
                  Margin="0,0,0,8"/>
          <Button Content="⚙  Settings"
                  Style="{StaticResource NavButtonStyle}"
                  Tag="Settings"
                  Click="NavButton_Click"
                  HorizontalContentAlignment="Left"
                  Margin="0,0,0,8"/>

          <Separator Margin="0,16,0,16" Background="#D7E6F7"/>

          <Button x:Name="PauseButton"
                  Style="{StaticResource NavButtonStyle}"
                  Click="PauseButton_Click"
                  HorizontalContentAlignment="Left"
                  Margin="0,0,0,8"/>
          <Button Content="+  Add Memory"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Click="AddMemory_Click"
                  HorizontalContentAlignment="Left"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="2,0,0,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText"
                       Foreground="#60748D"
                       FontSize="12"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- MAIN CONTENT -->
    <Grid Grid.Column="1" Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- HEADER -->
      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock x:Name="PageTitle"
                     Text="Timeline"
                     FontSize="30"
                     FontWeight="SemiBold"
                     Foreground="#10203B"/>
          <TextBlock x:Name="PageSubtitle"
                     Text="Your recent activity"
                     Margin="0,4,0,0"
                     FontSize="14"
                     Foreground="#667B95"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Border Background="#E9F3FF"
                  BorderBrush="#CFE2F7"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12,8"
                  Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8"
                       Fill="#24C36B"
                       Margin="0,0,7,0"
                       VerticalAlignment="Center"/>
              <TextBlock Text="Capture active"
                         Foreground="#36506E"
                         FontSize="12"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button x:Name="ClearTimelineButton"
                  Style="{StaticResource ModernButtonStyle}"
                  Content="Clear History"
                  Click="ClearTimeline_Click"/>
        </StackPanel>
      </Grid>

      <!-- TOOLBAR -->
      <Border Grid.Row="1"
              Background="#FFFFFF"
              BorderBrush="#D6E5F6"
              BorderThickness="1"
              CornerRadius="14"
              Padding="12"
              Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBox x:Name="SearchBox"
                   Grid.Column="0"
                   Visibility="Visible"
                   Margin="0,0,12,0"
                   Padding="12,9"
                   FontSize="14"
                   Background="#F8FBFF"
                   Foreground="#10203B"
                   BorderBrush="#D6E5F6"
                   TextChanged="SearchBox_TextChanged"
                   ToolTip="Search apps, window titles, notes, and copied text"/>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource ModernButtonStyle}" Content="Today" IsEnabled="False"/>
            <Button Style="{StaticResource ModernButtonStyle}" Content="All Apps" IsEnabled="False" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- BODY -->
      <Grid Grid.Row="2">
        <Border x:Name="TimelineContainer"
                Background="#FFFFFF"
                BorderBrush="#D6E5F6"
                BorderThickness="1"
                CornerRadius="16"
                Padding="0">
          <ListView x:Name="TimelineList"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    MouseDoubleClick="TimelineList_MouseDoubleClick">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                      <Border x:Name="RowChrome"
                              Background="{TemplateBinding Background}"
                              CornerRadius="10"
                              Margin="6,2">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="RowChrome" Property="Background" Value="#F2F8FF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="RowChrome" Property="Background" Value="#E7F3FF"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0" Margin="14,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="82"/>
                      <ColumnDefinition Width="52"/>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="104"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- TIME -->
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="#49627F"/>
                      <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MMM d}}"
                                 Margin="0,2,0,0"
                                 FontSize="11"
                                 Foreground="#8A9AAF"/>
                    </StackPanel>

                    <!-- APP ICON -->
                    <Border Grid.Column="1"
                            Width="40" Height="40"
                            CornerRadius="10"
                            Background="#F1F7FE"
                            BorderBrush="#DCE9F7"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                      <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                             Width="30" Height="30"
                             Stretch="Uniform"/>
                    </Border>

                    <!-- SOURCE -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                      <TextBlock Text="{Binding SourceApp}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="#24415F"
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- ACTIVITY -->
                    <StackPanel Grid.Column="3"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                      <TextBlock Text="{Binding Title}"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 Foreground="#10203B"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Body}"
                                 Margin="0,4,0,0"
                                 FontSize="12"
                                 Foreground="#657A93"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxHeight="36"/>
                    </StackPanel>

                    <!-- TYPE -->
                    <Border Grid.Column="4"
                            Background="#EEF6FF"
                            CornerRadius="8"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                      <TextBlock Text="{Binding SourceKind}"
                                 FontSize="11"
                                 Foreground="#376A9E"/>
                    </Border>

                    <!-- ACTIONS -->
                    <StackPanel Grid.Column="5"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                      <Button Content="Details"
                              Style="{StaticResource ModernButtonStyle}"
                              Tag="{Binding}"
                              Click="Details_Click"
                              Padding="10,6"
                              Margin="0,0,6,0"/>
                      <Button Content="☆"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTip="Favorite"
                              Tag="{Binding}"
                              Click="Favorite_Click"
                              Padding="9,6"
                              Margin="0,0,6,0"/>
                      <Button Content="⋯"
                              Style="{StaticResource IconButtonStyle}"
                              ToolTip="Delete"
                              Tag="{Binding}"
                              Click="Delete_Click"
                              Padding="9,6"
                              Margin="0"/>
                    </StackPanel>
                  </Grid>

                  <Border Grid.Row="1" Background="#EDF3FA" Margin="14,0"/>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Border>

        <!-- SETTINGS -->
        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
          <StackPanel>
            <Border Background="#FFFFFF"
                    BorderBrush="#D6E5F6"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Capture"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#10203B"/>
                <CheckBox x:Name="PauseCaptureCheckBox"
                          Content="Pause all capture"
                          Margin="0,16,0,10"
                          Checked="SettingChanged"
                          Unchecked="SettingChanged"/>
                <CheckBox x:Name="AppCaptureCheckBox"
                          Content="Remember app switches and focused windows"
                          Margin="0,0,0,10"
                          Checked="SettingChanged"
                          Unchecked="SettingChanged"/>
                <CheckBox x:Name="ClipboardCaptureCheckBox"
                          Content="Remember copied text"
                          Checked="SettingChanged"
                          Unchecked="SettingChanged"/>
              </StackPanel>
            </Border>

            <Border Background="#FFFFFF"
                    BorderBrush="#D6E5F6"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Excluded Apps &amp; Services"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#10203B"/>
                <TextBlock Text="Enter Windows process names, one per line. Memory Lane will not intentionally log activity or clipboard content while an excluded process is active."
                           Margin="0,8,0,12"
                           Foreground="#667B95"
                           TextWrapping="Wrap"/>
                <TextBox x:Name="ExclusionsBox"
                         AcceptsReturn="True"
                         MinHeight="120"/>
                <Button Content="Apply Exclusions"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Click="ApplyExclusions_Click"/>
              </StackPanel>
            </Border>

            <Border Background="#FFFFFF"
                    BorderBrush="#D6E5F6"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Windows"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#10203B"/>
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Start Memory Lane when I sign in to Windows"
                          Margin="0,16,0,0"
                          Checked="StartWithWindowsChanged"
                          Unchecked="StartWithWindowsChanged"/>
              </StackPanel>
            </Border>

            <Border Background="#FFFFFF"
                    BorderBrush="#D6E5F6"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22">
              <StackPanel>
                <TextBlock Text="Data &amp; Privacy"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#10203B"/>
                <TextBlock Text="Memory Lane stores your activity timeline locally on this PC. No cloud account, analytics SDK, or advertising SDK is required."
                           Margin="0,8,0,14"
                           Foreground="#667B95"
                           TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="Show Welcome Tutorial"
                          Click="ShowTutorial_Click"/>
                  <Button Content="Clear App Cache"
                          Click="ClearCache_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>