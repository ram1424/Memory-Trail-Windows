<Window x:Class="MemoryLane.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemoryLane.Windows"
        Title="Memory Trail v0.3.0"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
  <Window.Resources>
    <local:AppIconConverter x:Key="AppIconConverter"/>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2,0,26">
          <Border Width="38" Height="38" CornerRadius="10" Background="#0C2458">
            <Image x:Name="BrandLogo" Width="34" Height="34" Stretch="Uniform"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Memory Trail" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock Text="v0.3.0" Margin="0,2,0,0" FontSize="10"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="TimelineNavButton" Tag="Timeline"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="●" Width="24" FontSize="12"/>
              <TextBlock Text="Timeline"/>
            </StackPanel>
          </Button>

          <Button x:Name="SearchNavButton" Tag="Search"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⌕" Width="24" FontSize="18"/>
              <TextBlock Text="Search"/>
            </StackPanel>
          </Button>

          <Button x:Name="FavoritesNavButton" Tag="Favorites"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="☆" Width="24" FontSize="16"/>
              <TextBlock Text="Favorites"/>
            </StackPanel>
          </Button>

          <Button x:Name="SettingsNavButton" Tag="Settings"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚙" Width="24" FontSize="15"/>
              <TextBlock Text="Settings"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="3">
          <Border Background="#F7F9FC" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
              </StackPanel>
              <Button x:Name="PauseButton" Click="PauseButton_Click"
                      Style="{StaticResource NavButtonStyle}" Margin="0,7,0,0"
                      HorizontalContentAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="28,22,28,26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Timeline"
                     FontSize="28" FontWeight="SemiBold"
                     Foreground="{StaticResource PrimaryTextBrush}"/>
          <TextBlock x:Name="PageSubtitle" Text="A clean history of your recent activity"
                     Margin="0,4,0,0" FontSize="13"
                     Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                Click="AddMemory_Click" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,7,0"/>
            <TextBlock Text="Add Memory" Foreground="White"/>
          </StackPanel>
        </Button>
      </Grid>

      <Border x:Name="SearchPanel" Grid.Row="1"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="12"
              Padding="12" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="⌕" FontSize="20" Foreground="#7D8DA1"
                     VerticalAlignment="Center" Margin="2,0,8,0"/>
          <TextBox x:Name="SearchBox" Grid.Column="1"
                   BorderThickness="0" Background="Transparent"
                   Padding="4,3" TextChanged="SearchBox_TextChanged"
                   ToolTip="Search apps, titles, notes, and clipboard text"/>
          <TextBlock Grid.Column="2" Text="Search your activity"
                     VerticalAlignment="Center" FontSize="11"
                     Foreground="#98A2B3" Margin="12,0,4,0"/>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Border x:Name="TimelineContainer"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14"
                Padding="8">
          <ListView x:Name="TimelineList"
                    Background="Transparent" BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    MouseDoubleClick="TimelineList_MouseDoubleClick">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                      <Border x:Name="Row"
                              Background="{TemplateBinding Background}"
                              CornerRadius="10" Margin="2,2" Padding="2">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="#F7FAFD"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="#EEF5FF"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="12,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#475467"/>
                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MMM d}}"
                               Margin="0,2,0,0" FontSize="10"
                               Foreground="#98A2B3"/>
                  </StackPanel>

                  <Border Grid.Column="1" Width="38" Height="38" CornerRadius="9"
                          Background="#F4F7FB" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                           Width="28" Height="28" Stretch="Uniform"/>
                  </Border>

                  <StackPanel Grid.Column="2" Margin="12,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SourceApp}" FontSize="12"
                               FontWeight="SemiBold" Foreground="#344054"/>
                    <TextBlock Text="{Binding Title}" Margin="0,3,0,0"
                               FontSize="14" FontWeight="Medium"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Body}" Margin="0,3,0,0"
                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>

                  <Button Grid.Column="3" Content="☆"
                          Style="{StaticResource IconButtonStyle}"
                          Tag="{Binding}" Click="Favorite_Click"
                          ToolTip="Favorite" Margin="2"/>
                  <Button Grid.Column="4" Content="Details"
                          Style="{StaticResource ModernButtonStyle}"
                          Tag="{Binding}" Click="Details_Click"
                          Margin="4,0,2,0"/>
                  <Button Grid.Column="5" Content="×"
                          Style="{StaticResource IconButtonStyle}"
                          Foreground="{StaticResource DangerBrush}"
                          Tag="{Binding}" Click="Delete_Click"
                          ToolTip="Delete" Margin="2"/>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Border>

        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Capture" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Choose what Memory Trail remembers."
                           Margin="0,5,0,16" Foreground="{StaticResource SecondaryTextBrush}"/>
                <CheckBox x:Name="PauseCaptureCheckBox" Content="Pause all capture"
                          Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
                <CheckBox x:Name="AppCaptureCheckBox" Content="Remember app switches and focused windows"
                          Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
                <CheckBox x:Name="ClipboardCaptureCheckBox" Content="Remember copied text"
                          Checked="SettingChanged" Unchecked="SettingChanged"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Privacy exclusions" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="One Windows process name per line. Excluded apps are not intentionally recorded."
                           Margin="0,5,0,14" Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
                <TextBox x:Name="ExclusionsBox" AcceptsReturn="True" MinHeight="110"/>
                <Button Content="Apply exclusions" Margin="0,12,0,0"
                        HorizontalAlignment="Left" Click="ApplyExclusions_Click"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Start Memory Trail when I sign in to Windows"
                          Margin="0,14,0,0"
                          Checked="StartWithWindowsChanged" Unchecked="StartWithWindowsChanged"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="22">
              <StackPanel>
                <TextBlock Text="Maintenance" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Tutorial, reset, and history controls."
                           Margin="0,5,0,14" Foreground="{StaticResource SecondaryTextBrush}"/>
                <WrapPanel>
                  <Button Content="Show tutorial" Click="ShowTutorial_Click" Margin="0,0,8,8"/>
                  <Button Content="Reset preferences" Click="ClearCache_Click" Margin="0,0,8,8"/>
                  <Button x:Name="ClearTimelineButton" Content="Clear history"
                          Click="ClearTimeline_Click" Margin="0,0,8,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>