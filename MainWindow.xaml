<Window x:Class="MemoryLane.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemoryLane.Windows"
        Title="Memory Trail v0.4.1"
        Width="1320" Height="820"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
  <Window.Resources>
    <local:AppIconConverter x:Key="AppIconConverter"/>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,0,28">
          <Border Width="42" Height="42" CornerRadius="12" Background="#0B2147"
                  BorderBrush="#24538D" BorderThickness="1"
                  Padding="7">
            <Image x:Name="BrandLogo" Width="27" Height="27"
                   Stretch="Uniform" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Memory Trail" FontSize="16" FontWeight="SemiBold"
                       Foreground="White"/>
            <TextBlock Text="v0.4.1" Margin="0,2,0,0" FontSize="10"
                       Foreground="#7690AE"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="TimelineNavButton" Tag="Timeline"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16"/>
              <TextBlock Text="Timeline"/>
            </StackPanel>
          </Button>
          <Button x:Name="SearchNavButton" Tag="Search"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16"/>
              <TextBlock Text="Search"/>
            </StackPanel>
          </Button>
          <Button x:Name="ClipboardNavButton" Tag="Clipboard"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16"/>
              <TextBlock Text="Clipboard"/>
            </StackPanel>
          </Button>
          <Button x:Name="FavoritesNavButton" Tag="Favorites"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16"/>
              <TextBlock Text="Favorites"/>
            </StackPanel>
          </Button>
          <Button x:Name="NotesNavButton" Tag="Notes"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16"/>
              <TextBlock Text="Notes"/>
            </StackPanel>
          </Button>

          <Border Height="1" Background="#21344E" Margin="8,14,8,14"/>

          <Button x:Name="PrivacyNavButton" Tag="Privacy"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16"/>
              <TextBlock Text="Privacy"/>
            </StackPanel>
          </Button>
          <Button x:Name="SettingsNavButton" Tag="Settings"
                  Click="NavButton_Click" Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="28" FontSize="16"/>
              <TextBlock Text="Settings"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Row="3" Background="#0D1D31" BorderBrush="#243852"
                BorderThickness="1" CornerRadius="12" Padding="11">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"/>
              <TextBlock x:Name="StatusText" FontSize="12" Foreground="#9CB0C9"/>
            </StackPanel>
            <Button x:Name="PauseButton" Click="PauseButton_Click"
                    Style="{StaticResource NavButtonStyle}" Margin="0,7,0,0"
                    Padding="0,7" HorizontalContentAlignment="Left"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="16">
      <Grid x:Name="ActivityShell">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="SearchPanel"
                  Background="#111E32" BorderBrush="#2A3E5C"
                  BorderThickness="1" CornerRadius="13"
                  Padding="10,7" Margin="0,0,12,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                         Foreground="#95A9C2" VerticalAlignment="Center" Margin="3,0,8,0"/>
              <TextBox x:Name="SearchBox" Grid.Column="1"
                       BorderThickness="0" Background="Transparent"
                       Padding="3,2" TextChanged="SearchBox_TextChanged"
                       ToolTip="Search your timeline"/>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="AllAppsFilter" Content="All Apps" Tag="All"
                    Style="{StaticResource ChipButtonStyle}" Click="Category_Click"
                    Background="#168BFF" BorderBrush="#168BFF" Foreground="White"/>
            <Button x:Name="BrowserFilter" Content="Browser" Tag="Browser"
                    Style="{StaticResource ChipButtonStyle}" Click="Category_Click"/>
            <Button x:Name="EmailFilter" Content="Email" Tag="Email"
                    Style="{StaticResource ChipButtonStyle}" Click="Category_Click"/>
            <Button x:Name="ChatFilter" Content="Chat" Tag="Chat"
                    Style="{StaticResource ChipButtonStyle}" Click="Category_Click"/>
            <Button x:Name="FilesFilter" Content="Files" Tag="Files"
                    Style="{StaticResource ChipButtonStyle}" Click="Category_Click"/>
            <Button x:Name="OfficeFilter" Content="Office" Tag="Office"
                    Style="{StaticResource ChipButtonStyle}" Click="Category_Click"/>
            <Button x:Name="ShowDetailsButton" Content="▣  Details"
                    Style="{StaticResource ChipButtonStyle}"
                    Click="ShowDetailsPane_Click"
                    Visibility="Collapsed" Padding="13,7"/>
            <Button Content="+  Add" Style="{StaticResource PrimaryButtonStyle}"
                    Click="AddMemory_Click" Padding="13,7"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*"/>
            <ColumnDefinition x:Name="DetailsSpacerColumn" Width="12"/>
            <ColumnDefinition x:Name="DetailsColumn" Width="0.95*"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="TimelineContainer" Grid.Column="0"
                  Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="15"
                  Padding="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <TextBlock Text="Today" FontSize="13" Foreground="#A4B5CA"
                         Margin="8,6,0,7"/>

              <ListView x:Name="TimelineList" Grid.Row="1"
                        Background="Transparent" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="TimelineList_SelectionChanged"
                        MouseDoubleClick="TimelineList_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                          <Border x:Name="Row" Background="{TemplateBinding Background}"
                                  CornerRadius="10" Margin="2,1" Padding="0">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="#122641"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Row" Property="Background" Value="#173B6C"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid Height="61" Margin="8,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="36"/>
                      </Grid.ColumnDefinitions>

                      <Border Width="38" Height="38" CornerRadius="9"
                              Background="#0A1526"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                               Width="31" Height="31" Stretch="Uniform"/>
                      </Border>

                      <StackPanel Grid.Column="1" Margin="10,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceApp}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#F8FAFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Title}" Margin="0,4,0,0"
                                   FontSize="12" Foreground="#A9BAD0"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>

                      <TextBlock Grid.Column="2"
                                 Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}"
                                 FontSize="11" Foreground="#A2B3CA"
                                 VerticalAlignment="Center" HorizontalAlignment="Right"/>

                      <Button Grid.Column="3" Width="32" Height="32"
                              Content="☆" FontSize="17"
                              Style="{StaticResource IconButtonStyle}"
                              Tag="{Binding}" Click="Favorite_Click"
                              ToolTip="Favorite"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>

          <Border x:Name="DetailsPanel" Grid.Column="2"
                  Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="15"
                  Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                  <Border Width="46" Height="46" CornerRadius="12" Background="#0A1526">
                    <Image Source="{Binding SelectedItem, ElementName=TimelineList, Converter={StaticResource AppIconConverter}}"
                           Width="38" Height="38" Stretch="Uniform"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedItem.SourceApp, ElementName=TimelineList, TargetNullValue=Select an activity}"
                               FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding SelectedItem.Title, ElementName=TimelineList, TargetNullValue=Details appear here}"
                               Margin="0,4,0,0" Foreground="#9EB1C9" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             Text="{Binding SelectedItem.CreatedAt, ElementName=TimelineList, StringFormat={}{0:h:mm tt}}"
                             Foreground="#9DB0C8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button Grid.Column="3" Width="30" Height="30"
                          Content="×" FontSize="18"
                          Style="{StaticResource IconButtonStyle}"
                          Click="HideDetailsPane_Click"
                          ToolTip="Hide details"
                          VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="↗  Open Again" Click="OpenSelected_Click"/>
                  <Button Grid.Column="2" Content="▣  Copy Title" Click="CopySelectedTitle_Click"/>
                </Grid>

                <Button Content="☆  Add to Favorites" Click="FavoriteSelected_Click"
                        HorizontalAlignment="Stretch" Margin="0,0,0,22"/>

                <TextBlock Text="Window Title" FontSize="12" Foreground="#8398B5"/>
                <TextBlock Text="{Binding SelectedItem.Title, ElementName=TimelineList, TargetNullValue=—}"
                           Margin="0,6,0,16" FontSize="14" Foreground="#E4ECF7" TextWrapping="Wrap"/>

                <TextBlock Text="Source" FontSize="12" Foreground="#8398B5"/>
                <TextBlock Text="{Binding SelectedItem.SourceUrl, ElementName=TimelineList, TargetNullValue=No source link captured}"
                           Margin="0,6,0,16" FontSize="13" Foreground="#39A6FF" TextWrapping="Wrap"/>

                <TextBlock Text="Time" FontSize="12" Foreground="#8398B5"/>
                <TextBlock Text="{Binding SelectedItem.CreatedAt, ElementName=TimelineList, StringFormat={}{0:dddd, MMMM d, yyyy • h:mm:ss tt}}"
                           Margin="0,6,0,16" FontSize="13" Foreground="#D7E2F0" TextWrapping="Wrap"/>

                <TextBlock Text="Notes / captured details" FontSize="12" Foreground="#8398B5"/>
                <TextBlock Text="{Binding SelectedItem.Body, ElementName=TimelineList, TargetNullValue=No additional details were captured.}"
                           Margin="0,6,0,0" FontSize="13" LineHeight="20"
                           Foreground="#C3D1E2" TextWrapping="Wrap"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <ScrollViewer x:Name="PrivacyPanel" Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="Privacy" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="Memory Trail is local-first and gives you direct control over what is captured."
                     Margin="0,7,0,22" FontSize="14" Foreground="#97ABC4"/>

          <Border Background="#0D1B2F" BorderBrush="#233854" BorderThickness="1"
                  CornerRadius="15" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Local-only timeline" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"/>
              <TextBlock Text="Your activity history is stored on this PC. Memory Trail does not require a cloud account."
                         Margin="0,6,0,0" Foreground="#9DB0C8" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Background="#0D1B2F" BorderBrush="#233854" BorderThickness="1"
                  CornerRadius="15" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Capture controls" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"/>
              <TextBlock Text="Pause capture at any time, disable clipboard capture, or exclude applications and services."
                         Margin="0,6,0,13" Foreground="#9DB0C8" TextWrapping="Wrap"/>
              <Button Content="Open Settings" Tag="Settings" Click="NavButton_Click"
                      HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
          <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="Control what Memory Trail remembers and how it behaves."
                     Margin="0,7,0,22" FontSize="14" Foreground="#97ABC4"/>

          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="15" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Capture" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Text="Choose what Memory Trail remembers."
                         Margin="0,5,0,16" Foreground="#9DB0C8"/>
              <CheckBox x:Name="PauseCaptureCheckBox" Content="Pause all capture"
                        Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="AppCaptureCheckBox" Content="Remember app switches and focused windows"
                        Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="ClipboardCaptureCheckBox" Content="Remember copied text"
                        Checked="SettingChanged" Unchecked="SettingChanged"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="15" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Privacy exclusions" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Text="One Windows process name per line. Excluded apps are not intentionally recorded."
                         Margin="0,5,0,14" Foreground="#9DB0C8" TextWrapping="Wrap"/>
              <TextBox x:Name="ExclusionsBox" AcceptsReturn="True" MinHeight="110"/>
              <Button Content="Apply exclusions" Margin="0,12,0,0"
                      HorizontalAlignment="Left" Click="ApplyExclusions_Click"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="15" Padding="22" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
              <CheckBox x:Name="StartWithWindowsCheckBox"
                        Content="Start Memory Trail when I sign in to Windows"
                        Margin="0,14,0,0"
                        Checked="StartWithWindowsChanged" Unchecked="StartWithWindowsChanged"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="15" Padding="22">
            <StackPanel>
              <TextBlock Text="Maintenance" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Text="Tutorial, reset, and history controls."
                         Margin="0,5,0,14" Foreground="#9DB0C8"/>
              <WrapPanel>
                <Button Content="Show tutorial" Click="ShowTutorial_Click" Margin="0,0,8,8"/>
                <Button Content="Reset preferences" Click="ClearCache_Click" Margin="0,0,8,8"/>
                <Button x:Name="ClearTimelineButton" Content="Clear history"
                        Click="ClearTimeline_Click" Margin="0,0,8,8"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>