<Window x:Class="MemoryLane.Windows.MemoryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Details"
        Icon="/Assets/MemoryLaneReferenceIcon.png"
        Width="720" Height="620"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Memory Details"
                 FontSize="30"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource PrimaryTextBrush}"/>
      <TextBlock x:Name="TimestampText"
                 Margin="0,6,0,0"
                 FontSize="14"
                 Foreground="{StaticResource SecondaryTextBrush}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,20,0,18">
      <StackPanel>
        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22"
                Margin="0,0,0,14">
          <StackPanel>
            <TextBlock x:Name="SourceAppText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="TitleText"
                       Margin="0,8,0,0"
                       FontSize="23"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock x:Name="BodyText"
                       Margin="0,14,0,0"
                       FontSize="15"
                       LineHeight="23"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="135"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Type" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock Grid.Column="1" x:Name="KindText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>

            <TextBlock Grid.Row="1" Text="Process" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProcessText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>

            <TextBlock Grid.Row="2" Text="Source / Link" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
              <TextBlock x:Name="UrlText"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"/>
              <Button x:Name="OpenSourceButton"
                      Content="Open Source"
                      Click="OpenSource_Click"
                      HorizontalAlignment="Left"
                      Margin="0,10,0,0"
                      Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Close" IsDefault="True" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>