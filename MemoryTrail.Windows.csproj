<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <AssemblyName>Memory Trail</AssemblyName>
    <RootNamespace>MemoryLane.Windows</RootNamespace>
    <ApplicationManifest>Config\app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MemoryTrailApp.ico</ApplicationIcon>
    <Version>1.1</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1</InformationalVersion>
    <DisplayVersion>1.1</DisplayVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Resource Include="Assets\MemoryTrailApp.ico" />
    <Resource Include="Assets\MemoryTrailIconMaster.png" />
    <Resource Include="Assets\MemoryTrailIcon.png" />
    <Resource Include="Assets\OnboardingIcon.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(BuildCommit)' != ''">
    <AssemblyMetadata Include="BuildCommit" Value="$(BuildCommit)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DistributionChannel)' != ''">
    <AssemblyMetadata Include="DistributionChannel" Value="$(DistributionChannel)" />
  </ItemGroup>

  <!-- Keep WPF view/code-behind relationships explicit after organizing source into folders. -->
  <ItemGroup>
    <Page Update="Views\AddMemoryWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\AddMemoryWindow.xaml.cs">
      <DependentUpon>AddMemoryWindow.xaml</DependentUpon>
    </Compile>

    <Page Update="Views\ClearCacheWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\ClearCacheWindow.xaml.cs">
      <DependentUpon>ClearCacheWindow.xaml</DependentUpon>
    </Compile>

    <Page Update="Views\PrivacyPolicyWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\PrivacyPolicyWindow.xaml.cs">
      <DependentUpon>PrivacyPolicyWindow.xaml</DependentUpon>
    </Compile>

    <Page Update="Views\MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>

    <Page Update="Views\HistoryClearWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\HistoryClearWindow.xaml.cs">
      <DependentUpon>HistoryClearWindow.xaml</DependentUpon>
    </Compile>

    <Page Update="Views\MemoryDetailWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\MemoryDetailWindow.xaml.cs">
      <DependentUpon>MemoryDetailWindow.xaml</DependentUpon>
    </Compile>

    <Page Update="Views\OnboardingWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\OnboardingWindow.xaml.cs">
      <DependentUpon>OnboardingWindow.xaml</DependentUpon>
    </Compile>

    <Page Update="Views\SplashWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\SplashWindow.xaml.cs">
      <DependentUpon>SplashWindow.xaml</DependentUpon>
    </Compile>

    <Page Update="Views\UpdateAvailableWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\UpdateAvailableWindow.xaml.cs">
      <DependentUpon>UpdateAvailableWindow.xaml</DependentUpon>
    </Compile>

    <Page Update="Views\WhatsNewWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views\WhatsNewWindow.xaml.cs">
      <DependentUpon>WhatsNewWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
