<Window x:Class="MemoryLane.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Memory Trail"
        Width="1060" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#07111F">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A1930" Offset="0"/>
        <GradientStop Color="#07111F" Offset="0.55"/>
        <GradientStop Color="#0A1730" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <Grid Margin="30">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="Page1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.88*"/>
          <ColumnDefinition Width="1.12*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="12,0,38,0">
          <Border Width="94" Height="94" CornerRadius="24"
                  Background="#0C2349"
                  BorderBrush="#245BA0"
                  BorderThickness="1"
                  Padding="14"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,24">
            <Image x:Name="WelcomeBrandLogo" Width="64" Height="64"
                   Stretch="Uniform" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>

          <TextBlock Text="Welcome to&#x0a;Memory Trail"
                     FontSize="39" FontWeight="SemiBold"
                     LineHeight="44" Foreground="#FFFFFF"/>
          <TextBlock Text="A simple, private way to retrace your digital day."
                     Margin="0,18,0,0"
                     FontSize="18" LineHeight="27"
                     Foreground="#D4E0F0"
                     TextWrapping="Wrap"/>
          <TextBlock Text="Memory Trail quietly keeps a searchable history of the apps and windows you use so you can find your way back."
                     Margin="0,14,0,0"
                     FontSize="14" LineHeight="22"
                     Foreground="#8FA5C2"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1"
                Background="#0D1A2E"
                BorderBrush="#29405F"
                BorderThickness="1"
                CornerRadius="21"
                Padding="22"
                Margin="4,20,4,20">
          <StackPanel>
            <TextBlock Text="Your day, beautifully organized"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       Margin="0,0,0,16"/>

            <Border Background="#111F34" CornerRadius="13" Padding="13" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="#0E7CEB">
                  <TextBlock Text="E" FontFamily="Segoe UI" FontWeight="Bold" FontSize="19" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Microsoft Edge" FontWeight="SemiBold" Foreground="#F7FAFF"/>
                  <TextBlock Text="Project documentation" Margin="0,3,0,0" Foreground="#9CAEC5"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="9:14 AM" FontSize="11" Foreground="#7488A5" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Background="#111F34" CornerRadius="13" Padding="13" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="#0879E8">
                  <TextBlock Text="O" FontFamily="Segoe UI" FontWeight="Bold" FontSize="18" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Outlook" FontWeight="SemiBold" Foreground="#F7FAFF"/>
                  <TextBlock Text="Weekly project update" Margin="0,3,0,0" Foreground="#9CAEC5"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="10:27 AM" FontSize="11" Foreground="#7488A5" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Background="#111F34" CornerRadius="13" Padding="13" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="#7655D8">
                  <TextBlock Text="T" FontFamily="Segoe UI" FontWeight="Bold" FontSize="18" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Microsoft Teams" FontWeight="SemiBold" Foreground="#F7FAFF"/>
                  <TextBlock Text="Design review discussion" Margin="0,3,0,0" Foreground="#9CAEC5"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="11:35 AM" FontSize="11" Foreground="#7488A5" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Background="#111F34" CornerRadius="13" Padding="13">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="#F0A91E">
                  <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="File Explorer" FontWeight="SemiBold" Foreground="#F7FAFF"/>
                  <TextBlock Text="Project Phoenix" Margin="0,3,0,0" Foreground="#9CAEC5"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="11:41 AM" FontSize="11" Foreground="#7488A5" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="Page2" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.88*"/>
          <ColumnDefinition Width="1.12*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="12,0,38,0">
          <Border Width="88" Height="88" CornerRadius="23" Background="#0D6DD7"
                  BorderBrush="#2D95FF" BorderThickness="1"
                  HorizontalAlignment="Left" Margin="0,0,0,24">
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                       FontSize="40" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Find anything&#x0a;in seconds"
                     FontSize="39" FontWeight="SemiBold"
                     LineHeight="44" Foreground="#FFFFFF"/>
          <TextBlock Text="Search across apps, window titles, notes, links, files, and copied text from one private timeline."
                     Margin="0,18,0,0" FontSize="16" LineHeight="25"
                     Foreground="#BCCBE0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1" Background="#0D1A2E" BorderBrush="#29405F"
                BorderThickness="1" CornerRadius="21" Padding="22" Margin="4,20,4,20">
          <StackPanel>
            <Border Background="#111F34" BorderBrush="#2A405F" BorderThickness="1"
                    CornerRadius="12" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#A8B8CF" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="project update" Foreground="#E7EEF8"/>
                <TextBlock Grid.Column="2" Text="×" Foreground="#8DA0BB"/>
              </Grid>
            </Border>
            <TextBlock Text="2 results" Margin="2,18,0,10" FontSize="12" Foreground="#8094B0"/>

            <Border Background="#111F34" CornerRadius="13" Padding="14" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="9" Background="#0879E8">
                  <TextBlock Text="O" FontFamily="Segoe UI" FontWeight="Bold" FontSize="17" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Outlook" Foreground="#3EA2FF" FontWeight="SemiBold"/>
                  <TextBlock Text="Weekly project update" Margin="0,4,0,0" Foreground="#E7EEF8"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="#111F34" CornerRadius="13" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="9" Background="#7457D7">
                  <TextBlock Text="T" FontFamily="Segoe UI" FontWeight="Bold" FontSize="17" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Microsoft Teams" Foreground="#A990FF" FontWeight="SemiBold"/>
                  <TextBlock Text="Follow up on project update" Margin="0,4,0,0" Foreground="#E7EEF8"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="Page3" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.88*"/>
          <ColumnDefinition Width="1.12*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="12,0,38,0">
          <Border Width="88" Height="88" CornerRadius="23" Background="#134A9A"
                  BorderBrush="#2A6FD4" BorderThickness="1"
                  HorizontalAlignment="Left" Margin="0,0,0,24">
            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                       FontSize="38" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Private by design"
                     FontSize="39" FontWeight="SemiBold"
                     LineHeight="44" Foreground="#FFFFFF"/>
          <TextBlock Text="Your timeline stays on this PC. Pause capture, exclude apps, control clipboard history, and keep your activity private."
                     Margin="0,18,0,0" FontSize="16" LineHeight="25"
                     Foreground="#BCCBE0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1" Background="#0D1A2E" BorderBrush="#29405F"
                BorderThickness="1" CornerRadius="21" Padding="22" Margin="4,20,4,20">
          <StackPanel>
            <TextBlock Text="Your privacy controls" FontSize="20" FontWeight="SemiBold"
                       Foreground="#FFFFFF" Margin="0,0,0,16"/>

            <Border Background="#12352D" CornerRadius="12" Padding="13" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="9" Background="#15915F">
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Local-only timeline" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Your data stays on this device." Margin="0,3,0,0" Foreground="#A7C9BD"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="#102B4E" CornerRadius="12" Padding="13" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="9" Background="#217DDE">
                  <TextBlock Text="Ⅱ" Foreground="White" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Pause capture any time" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Quickly pause or resume." Margin="0,3,0,0" Foreground="#A9C3E2"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="#242153" CornerRadius="12" Padding="13" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="9" Background="#6656E9">
                  <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Exclude apps and services" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Keep sensitive apps out." Margin="0,3,0,0" Foreground="#BBB7E6"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="#3A2818" CornerRadius="12" Padding="13">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="9" Background="#E37B16">
                  <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="No cloud account required" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Works fully offline." Margin="0,3,0,0" Foreground="#D6B995"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" Margin="4,18,4,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="BackButton" Content="←  Back"
                Click="Back_Click" Visibility="Hidden"
                HorizontalAlignment="Left" Padding="18,9"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="4"/>
          <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="4"/>
          <Ellipse x:Name="Dot3" Width="8" Height="8" Margin="4"/>
        </StackPanel>

        <Button x:Name="NextButton" Grid.Column="2"
                Content="Next  →" Style="{StaticResource PrimaryButtonStyle}"
                Click="Next_Click" HorizontalAlignment="Right" Padding="22,10"/>
      </Grid>
    </Grid>
  </Grid>
</Window>