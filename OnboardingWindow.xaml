<Window x:Class="MemoryLane.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Memory Trail"
        Width="1040" Height="760"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#E8EEF9">
  <Window.Resources>
    <Style x:Key="TourCard" TargetType="Border">
      <Setter Property="Background" Value="#F6F9FC"/>
      <Setter Property="BorderBrush" Value="#D8E1EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="15"/>
    </Style>
    <Style x:Key="FeatureTile" TargetType="Border">
      <Setter Property="Background" Value="#EBF1F9"/>
      <Setter Property="BorderBrush" Value="#D8E1EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8EEF9" Offset="0"/>
        <GradientStop Color="#DBE5F4" Offset="0.58"/>
        <GradientStop Color="#D1DEEF" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1"
            CornerRadius="24" Margin="28" Padding="0">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="12" Opacity="0.12"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="62"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,20,28,0">
          <TextBlock x:Name="PageCounterText" Text="1 of 6" FontSize="11" FontWeight="Medium" Foreground="#40506A"/>
          <TextBlock x:Name="PageTitleTopText" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold"
                     Foreground="#66778F" Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="1">
          <!-- PAGE 1: Welcome -->
          <Grid x:Name="Page1" Margin="40,26">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="350">
              <Border Width="150" Height="150" CornerRadius="32" Background="#EBF1F9" Padding="0">
                <Image x:Name="WelcomeBrandLogo" Width="150" Height="150" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
              <TextBlock Text="Welcome to&#x0a;Memory Trail" FontSize="34" FontWeight="Bold"
                         Foreground="#1A2438" TextAlignment="Center" Margin="0,17,0,0"/>
              <TextBlock Text="A privacy-first, searchable history of the work you do on your PC."
                         FontSize="16" Foreground="#40506A" TextAlignment="Center"
                         TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="36,0,0,0">
              <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="22" Background="#1680FF"><TextBlock Text="◷" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1"><TextBlock Text="Retrace your work" FontSize="16" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="See your day as a chronological timeline of apps, pages, messages, files, and copied text." FontSize="12" Foreground="#40506A" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
              </Grid>
              <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="22" Background="#875AD8"><TextBlock Text="✦" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1"><TextBlock Text="Ask Memory Trail" FontSize="16" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Search your local history by time, app, filename, subject, page, or what happened before or after." FontSize="12" Foreground="#40506A" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
              </Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="22" Background="#2BA66C"><TextBlock Text="✓" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1"><TextBlock Text="Privacy-first by design" FontSize="16" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Memory Trail runs locally. Captured activity is sourced and stored on this PC and is not sent to an external service." FontSize="12" Foreground="#40506A" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- PAGE 2: Today -->
          <Grid x:Name="Page2" Visibility="Collapsed" Margin="34,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="Today, Newest First" FontSize="30" FontWeight="Bold" Foreground="#1A2438" HorizontalAlignment="Center"/>
              <TextBlock Text="Today shows your captured activity in one continuous newest-first history without summarizing or rewriting what you viewed."
                         FontSize="15" Foreground="#40506A" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="690" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,15">
              <Border Background="#1680FF" CornerRadius="14" Padding="11,6" Margin="0,0,8,0"><TextBlock Text="All" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border>
              <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="14" Padding="11,6" Margin="0,0,8,0"><TextBlock Text="Web" Foreground="#1A2438" FontSize="11"/></Border>
              <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="14" Padding="11,6" Margin="0,0,8,0"><TextBlock Text="Email" Foreground="#1A2438" FontSize="11"/></Border>
              <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="14" Padding="11,6" Margin="0,0,8,0"><TextBlock Text="Chat" Foreground="#1A2438" FontSize="11"/></Border>
              <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="14" Padding="11,6"><TextBlock Text="Files" Foreground="#1A2438" FontSize="11"/></Border>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource TourCard}" MaxWidth="680" HorizontalAlignment="Center">
              <StackPanel>
                <Grid Height="58"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="10:42 AM" Foreground="#66778F" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                  <Image x:Name="EdgeTutorialIcon" Grid.Column="1" Width="32" Height="32"/>
                  <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Memory Trail · Releases" FontWeight="SemiBold" Foreground="#1A2438"/><Border Background="#E7F8ED" CornerRadius="9" Padding="6,2" Margin="7,0,0,0"><TextBlock Text="Live Activity" Foreground="#168A48" FontSize="9" FontWeight="SemiBold"/></Border></StackPanel><TextBlock Text="Microsoft Edge" Foreground="#66778F" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                  <TextBlock Grid.Column="3" Text="Web" Foreground="#1680FF" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="#D8E1EC"/>
                <Grid Height="58"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="10:18 AM" Foreground="#66778F" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                  <Image x:Name="OutlookTutorialIcon" Grid.Column="1" Width="32" Height="32"/>
                  <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="RE: Project Update" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Microsoft Outlook" Foreground="#66778F" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                  <TextBlock Grid.Column="3" Text="Email" Foreground="#E88A20" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="#D8E1EC"/>
                <Grid Height="58"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="9:54 AM" Foreground="#66778F" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                  <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Background="#FFF2C9"><TextBlock Text="▰" Foreground="#C99A14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Project Phoenix.xlsx" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="File Explorer" Foreground="#66778F" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                  <TextBlock Grid.Column="3" Text="Files" Foreground="#C99A14" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
            <UniformGrid Grid.Row="3" Columns="3" MaxWidth="720" HorizontalAlignment="Center" Margin="0,14,0,0">
              <Border Style="{StaticResource FeatureTile}" Margin="0,0,10,0"><StackPanel><TextBlock Text="⚡ Live Activity" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Your newest activity stays at the top and is clearly marked while active." TextWrapping="Wrap" FontSize="11" Foreground="#40506A" Margin="0,6,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource FeatureTile}" Margin="0,0,10,0"><StackPanel><TextBlock Text="▥ Details Panel" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Select any activity to see its local details on the right." TextWrapping="Wrap" FontSize="11" Foreground="#40506A" Margin="0,6,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource FeatureTile}"><StackPanel><TextBlock Text="☰ Dynamic Filters" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Activity types and counts make it easy to focus your timeline." TextWrapping="Wrap" FontSize="11" Foreground="#40506A" Margin="0,6,0,0"/></StackPanel></Border>
            </UniformGrid>
          </Grid>

          <!-- PAGE 3: Ask -->
          <Grid x:Name="Page3" Visibility="Collapsed" Margin="36,26">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="Ask Memory Trail" FontSize="30" FontWeight="Bold" Foreground="#1A2438" HorizontalAlignment="Center"/>
              <TextBlock Text="Use natural-language local search to find captured activity without scrolling through your entire day."
                         FontSize="15" Foreground="#40506A" TextAlignment="Center" MaxWidth="680" TextWrapping="Wrap" Margin="0,7,0,18"/>
              <StackPanel MaxWidth="650">
                <Border Style="{StaticResource TourCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="✦  What was I doing around 10:30 AM?" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Find activity captured near that time." FontSize="11" Foreground="#66778F" Margin="28,3,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="✦  What did I view before opening Teams?" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Look backward from a Teams event." FontSize="11" Foreground="#66778F" Margin="28,3,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="✦  Find the Outlook email I viewed today" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Match captured Outlook subject lines." FontSize="11" Foreground="#66778F" Margin="28,3,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}"><StackPanel><TextBlock Text="✦  Find the budget spreadsheet from yesterday" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Search filenames, file paths, apps, and dates." FontSize="11" Foreground="#66778F" Margin="28,3,0,0"/></StackPanel></Border>
              </StackPanel>
              <UniformGrid Columns="4" MaxWidth="720" Margin="0,18,0,0">
                <Border Style="{StaticResource FeatureTile}" Margin="0,0,8,0"><StackPanel><TextBlock Text="◷ Time-aware" FontWeight="SemiBold"/><TextBlock Text="Today, yesterday, and specific times." FontSize="10" Foreground="#66778F" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureTile}" Margin="0,0,8,0"><StackPanel><TextBlock Text="▦ App-aware" FontWeight="SemiBold"/><TextBlock Text="Edge, Outlook, Teams, Office, and more." FontSize="10" Foreground="#66778F" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureTile}" Margin="0,0,8,0"><StackPanel><TextBlock Text="↔ Before &amp; After" FontWeight="SemiBold"/><TextBlock Text="Trace what happened around another activity." FontSize="10" Foreground="#66778F" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureTile}"><StackPanel><TextBlock Text="✓ Local" FontWeight="SemiBold"/><TextBlock Text="Queries use your local Memory Trail history." FontSize="10" Foreground="#66778F" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </Grid>

          <!-- PAGE 4: Capture -->
          <Grid x:Name="Page4" Visibility="Collapsed" Margin="30,20">
            <StackPanel>
              <TextBlock Text="Remember the Useful Details" FontSize="30" FontWeight="Bold" Foreground="#1A2438" HorizontalAlignment="Center"/>
              <TextBlock Text="Memory Trail captures the meaningful thing you were viewing—not just the app name."
                         FontSize="14" Foreground="#40506A" TextAlignment="Center" Margin="0,6,0,16"/>
              <UniformGrid Columns="3" Rows="2">
                <Border Style="{StaticResource TourCard}" Margin="0,0,10,10"><StackPanel><TextBlock Text="◎" FontSize="24" Foreground="#1680FF" HorizontalAlignment="Center"/><TextBlock Text="Web Browsers" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,7"/><TextBlock Text="✓ Page and tab titles&#x0a;✓ Page URLs when available&#x0a;✓ Edge, Chrome, Firefox and more" FontSize="11" Foreground="#40506A"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}" Margin="0,0,10,10"><StackPanel><TextBlock Text="✉" FontSize="24" Foreground="#875AD8" HorizontalAlignment="Center"/><TextBlock Text="Email &amp; Chat" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,7"/><TextBlock Text="✓ Email subject lines&#x0a;✓ Mail item subjects&#x0a;✓ Teams conversations" FontSize="11" Foreground="#40506A"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="▰" FontSize="24" Foreground="#2BA66C" HorizontalAlignment="Center"/><TextBlock Text="Files &amp; Notes" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,7"/><TextBlock Text="✓ Explorer locations and filenames&#x0a;✓ Office documents&#x0a;✓ OneNote and supported apps" FontSize="11" Foreground="#40506A"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="▤" FontSize="24" Foreground="#1680FF" HorizontalAlignment="Center"/><TextBlock Text="Clipboard History" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,7"/><TextBlock Text="✓ Copied text&#x0a;✓ Copied links and URLs&#x0a;✓ Copied code snippets" FontSize="11" Foreground="#40506A"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="＋" FontSize="24" Foreground="#875AD8" HorizontalAlignment="Center"/><TextBlock Text="Add Memory" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,7"/><TextBlock Text="✓ Create a manual memory&#x0a;✓ Save links or notes&#x0a;✓ Quick toolbar access" FontSize="11" Foreground="#40506A"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}"><StackPanel><TextBlock Text="★" FontSize="24" Foreground="#2BA66C" HorizontalAlignment="Center"/><TextBlock Text="Favorites" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,7"/><TextBlock Text="✓ Mark important items&#x0a;✓ Quick access later&#x0a;✓ Keep key context close" FontSize="11" Foreground="#40506A"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </Grid>

          <!-- PAGE 5: Privacy -->
          <Grid x:Name="Page5" Visibility="Collapsed" Margin="30,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border Width="290" Height="290" CornerRadius="28" Background="#E6F1FF" BorderBrush="#D8E1EC" BorderThickness="1">
                <Grid>
                  <Image x:Name="PrivacyBrandLogo" Width="150" Height="150" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Border Width="60" Height="60" CornerRadius="30" Background="#1680FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24">
                    <TextBlock Text="✓" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Border>
              <TextBlock Text="Your history stays on this PC." FontSize="18" FontWeight="Bold" Foreground="#1A2438" Margin="0,14,0,0"/>
              <TextBlock Text="Private by default. Local by design." Foreground="#40506A" Margin="0,5,0,12"/>
              <StackPanel Width="220">
                <TextBlock Text="✓  Sourced locally" Foreground="#40506A" Margin="0,0,0,6"/>
                <TextBlock Text="✓  Processed locally" Foreground="#40506A" Margin="0,0,0,6"/>
                <TextBlock Text="✓  Stored locally" Foreground="#40506A"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="36,4,0,0">
              <TextBlock Text="Privacy First. By Design." FontSize="30" FontWeight="Bold" Foreground="#1A2438"/>
              <TextBlock Text="Memory Trail is a private, locally run app. Your activity is captured, processed, and stored on this PC. No timeline data is uploaded or sent outside your computer."
                         FontSize="12" Foreground="#40506A" TextWrapping="Wrap" Margin="0,6,0,12"/>
              <Border Style="{StaticResource TourCard}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Local-only architecture" FontWeight="SemiBold"/><TextBlock Text="Captured activity is sourced locally, processed locally, and stored locally. No cloud sync or external data connectors are required." FontSize="11" Foreground="#66778F" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource TourCard}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Pause Capture" FontWeight="SemiBold"/><TextBlock Text="Pause or resume activity capture whenever you need privacy." FontSize="11" Foreground="#66778F" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource TourCard}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Exclude Apps" FontWeight="SemiBold"/><TextBlock Text="Choose apps and services Memory Trail should ignore." FontSize="11" Foreground="#66778F" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource TourCard}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Local Storage" FontWeight="SemiBold"/><TextBlock Text="Your activity history is stored locally on this PC." FontSize="11" Foreground="#66778F" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource TourCard}"><StackPanel><TextBlock Text="Verifiable source code" FontWeight="SemiBold"/><TextBlock Text="The source code is available for review and verification." FontSize="11" Foreground="#66778F" Margin="0,4,0,0"/></StackPanel></Border>
            </StackPanel>
          </Grid>

          <!-- PAGE 6: Windows context -->
          <Grid x:Name="Page6" Visibility="Collapsed" Margin="38,26">
            <StackPanel HorizontalAlignment="Center" MaxWidth="690">
              <TextBlock Text="Allow Window Context" FontSize="30" FontWeight="Bold" Foreground="#1A2438" HorizontalAlignment="Center"/>
              <TextBlock Text="Windows UI Automation and local app/window metadata let Memory Trail capture useful context such as browser page titles, Outlook subjects, Teams conversations, OneNote pages, and supported file information."
                         FontSize="15" Foreground="#40506A" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,20"/>
              <Border Style="{StaticResource TourCard}" Width="620">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Image x:Name="ContextBrandLogo" Width="56" Height="56"/>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Memory Trail" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Window context capture runs locally using Windows APIs." Foreground="#66778F" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                  <TextBlock Grid.Column="2" Text="✓ Ready" Foreground="#2BA66C" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <TextBlock Text="No external connector is needed. You can control app activity and clipboard capture anytime from Settings."
                         Foreground="#40506A" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,18"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="#EBF1F9" CornerRadius="14" Padding="10,6" Margin="0,0,10,0"><TextBlock Text="◷ Today" FontSize="11"/></Border>
                <Border Background="#EBF1F9" CornerRadius="14" Padding="10,6" Margin="0,0,10,0"><TextBlock Text="✦ Ask Memory Trail" FontSize="11"/></Border>
                <Border Background="#EBF1F9" CornerRadius="14" Padding="10,6" Margin="0,0,10,0"><TextBlock Text="▰ Files" FontSize="11"/></Border>
                <Border Background="#EBF1F9" CornerRadius="14" Padding="10,6" Margin="0,0,10,0"><TextBlock Text="▤ Clipboard" FontSize="11"/></Border>
                <Border Background="#EBF1F9" CornerRadius="14" Padding="10,6"><TextBlock Text="★ Favorites" FontSize="11"/></Border>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="28,0,28,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="BackButton" Content="←  Back" Click="Back_Click" Visibility="Hidden"
                  HorizontalAlignment="Left" Padding="16,8"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="4"/>
            <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="4"/>
            <Ellipse x:Name="Dot3" Width="8" Height="8" Margin="4"/>
            <Ellipse x:Name="Dot4" Width="8" Height="8" Margin="4"/>
            <Ellipse x:Name="Dot5" Width="8" Height="8" Margin="4"/>
            <Ellipse x:Name="Dot6" Width="8" Height="8" Margin="4"/>
          </StackPanel>
          <Button x:Name="NextButton" Grid.Column="2" Content="Continue  →"
                  Style="{StaticResource PrimaryButtonStyle}" Click="Next_Click"
                  HorizontalAlignment="Right" Padding="18,9"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>