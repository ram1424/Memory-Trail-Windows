<Window x:Class="MemoryLane.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Memory Trail"
        Width="1060" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EEF4FB">
  <Window.Resources>
    <Style x:Key="TourCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D8E2EF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="Padding" Value="22"/>
    </Style>
    <Style x:Key="TourRowStyle" TargetType="Border">
      <Setter Property="Background" Value="#F8FBFF"/>
      <Setter Property="BorderBrush" Value="#E2E9F2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F8FBFF" Offset="0"/>
        <GradientStop Color="#EDF4FC" Offset="0.55"/>
        <GradientStop Color="#F6F9FD" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <Grid Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- PAGE 1: WELCOME -->
      <Grid x:Name="Page1" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.92*"/>
          <ColumnDefinition Width="1.08*"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="8,0,42,0">
          <Border Width="108" Height="108" CornerRadius="28" Background="#FFFFFF"
                  BorderBrush="#D8E2EF" BorderThickness="1" Padding="8"
                  HorizontalAlignment="Left" Margin="0,0,0,22">
            <Image x:Name="WelcomeBrandLogo" Width="90" Height="90" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="WELCOME" FontSize="12" FontWeight="SemiBold" Foreground="#1E78F0" Margin="0,0,0,10"/>
          <TextBlock Text="Welcome to&#x0a;Memory Trail" FontSize="40" FontWeight="SemiBold"
                     LineHeight="45" Foreground="#17233A"/>
          <TextBlock Text="A private, effortless way to retrace your digital day."
                     Margin="0,15,0,0" FontSize="17" LineHeight="25"
                     Foreground="#40516A" TextWrapping="Wrap"/>
          <StackPanel Margin="0,22,0,0">
            <TextBlock Text="◷   Automatically captures your activity" Foreground="#53647A" FontSize="14" Margin="0,0,0,10"/>
            <TextBlock Text="⌕   Find anything you did, when you did it" Foreground="#53647A" FontSize="14" Margin="0,0,0,10"/>
            <TextBlock Text="⌾   Everything stays on your device" Foreground="#53647A" FontSize="14"/>
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource TourCardStyle}" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="A clear timeline of your day" FontSize="21" FontWeight="SemiBold"
                       Foreground="#17233A" Margin="0,0,0,14"/>
            <TextBlock Text="Your most recent activity stays easy to recognize." Foreground="#66768B" Margin="0,0,0,14"/>
            <Border Style="{StaticResource TourRowStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="EdgeTutorialIcon" Width="36" Height="36" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Microsoft Edge" Foreground="#17233A" FontWeight="SemiBold"/><TextBlock Text="Project documentation" Foreground="#66768B" Margin="0,3,0,0"/></StackPanel>
                <TextBlock Grid.Column="2" Text="9:42 AM" Foreground="#7A889B" FontSize="11" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource TourRowStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="OutlookTutorialIcon" Width="36" Height="36" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Outlook" Foreground="#17233A" FontWeight="SemiBold"/><TextBlock Text="Weekly project update" Foreground="#66768B" Margin="0,3,0,0"/></StackPanel>
                <TextBlock Grid.Column="2" Text="9:38 AM" Foreground="#7A889B" FontSize="11" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource TourRowStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="TeamsTutorialIcon" Width="36" Height="36" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Microsoft Teams" Foreground="#17233A" FontWeight="SemiBold"/><TextBlock Text="Design review discussion" Foreground="#66768B" Margin="0,3,0,0"/></StackPanel>
                <TextBlock Grid.Column="2" Text="9:31 AM" Foreground="#7A889B" FontSize="11" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PAGE 2: TODAY -->
      <Grid x:Name="Page2" Visibility="Collapsed" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="8,0,42,0">
          <Border Width="84" Height="84" CornerRadius="24" Background="#FFF2E2">
            <TextBlock Text="▥" FontSize="34" Foreground="#F39A34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="TODAY VIEW" FontSize="12" FontWeight="SemiBold" Foreground="#1E78F0" Margin="0,20,0,10"/>
          <TextBlock Text="See your day&#x0a;at a glance" FontSize="40" FontWeight="SemiBold" LineHeight="45" Foreground="#17233A"/>
          <TextBlock Text="Your newest activity stays at the top and is marked Live Activity, so you can immediately recognize what you were just doing."
                     Margin="0,15,0,0" FontSize="16" LineHeight="24" Foreground="#53647A" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource TourCardStyle}" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Live Activity follows your newest item" FontSize="20" FontWeight="SemiBold" Foreground="#17233A" Margin="0,0,0,14"/>
            <Border Background="#EEF7FF" BorderBrush="#A8CFFF" BorderThickness="1" CornerRadius="16" Padding="13" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="OutlookSearchIcon" Width="34" Height="34"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Outlook" Foreground="#17233A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#E5F8ED" BorderBrush="#BDE9CD" BorderThickness="1" CornerRadius="9" Padding="6,2" Margin="7,0,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#22B85C" Margin="0,0,4,0"/>
                        <TextBlock Text="LIVE ACTIVITY" Foreground="#178445" FontSize="8" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="RE: Project update" Foreground="#66768B" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Now" Foreground="#1E78F0" FontSize="11" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource TourRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="TeamsSearchIcon" Width="34" Height="34"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Microsoft Teams" Foreground="#17233A" FontWeight="SemiBold"/><TextBlock Text="Design review discussion" Foreground="#66768B" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="2 min ago" Foreground="#7A889B" FontSize="11" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource TourRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="8" Background="#FFF0C8"><TextBlock Text="▤" Foreground="#D28B18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="File Explorer" Foreground="#17233A" FontWeight="SemiBold"/><TextBlock Text="Memory Trail" Foreground="#66768B" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="8 min ago" Foreground="#7A889B" FontSize="11" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PAGE 3: ASK -->
      <Grid x:Name="Page3" Visibility="Collapsed" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="8,0,42,0">
          <Border Width="84" Height="84" CornerRadius="24" Background="#EEE7FF">
            <TextBlock Text="⌕" FontSize="40" Foreground="#7857E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="ASK MEMORY TRAIL" FontSize="12" FontWeight="SemiBold" Foreground="#1E78F0" Margin="0,20,0,10"/>
          <TextBlock Text="Ask naturally.&#x0a;Find it quickly." FontSize="40" FontWeight="SemiBold" LineHeight="45" Foreground="#17233A"/>
          <TextBlock Text="Ask about time, apps, files, emails, chats, websites, or projects — without needing exact names."
                     Margin="0,15,0,0" FontSize="16" LineHeight="24" Foreground="#53647A" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource TourCardStyle}" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="What do you want to remember?" FontSize="20" FontWeight="SemiBold" Foreground="#17233A" Margin="0,0,0,14"/>
            <Border Background="#FFFFFF" BorderBrush="#D6E2EE" BorderThickness="1" CornerRadius="16" Padding="12" Margin="0,0,0,14">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="#66768B" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="What was I doing earlier today?" Foreground="#7A889B"/><Border Grid.Column="2" Background="#1E78F0" CornerRadius="10" Padding="12,5"><TextBlock Text="Ask" Foreground="White"/></Border></Grid>
            </Border>
            <UniformGrid Columns="2">
              <Border Style="{StaticResource TourRowStyle}" Margin="0,0,8,8"><TextBlock Text="◷  Earlier today" Foreground="#40516A"/></Border>
              <Border Style="{StaticResource TourRowStyle}" Margin="0,0,0,8"><TextBlock Text="▤  Recent files" Foreground="#40516A"/></Border>
              <Border Style="{StaticResource TourRowStyle}" Margin="0,0,8,0"><TextBlock Text="✉  Recent email" Foreground="#40516A"/></Border>
              <Border Style="{StaticResource TourRowStyle}" Margin="0"><TextBlock Text="◎  Websites visited" Foreground="#40516A"/></Border>
            </UniformGrid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PAGE 4: PRIVACY -->
      <Grid x:Name="Page4" Visibility="Collapsed" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="8,0,42,0">
          <Border Width="84" Height="84" CornerRadius="24" Background="#E4F8EF">
            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#21A66B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="PRIVACY" FontSize="12" FontWeight="SemiBold" Foreground="#1E78F0" Margin="0,20,0,10"/>
          <TextBlock Text="Stay in control" FontSize="40" FontWeight="SemiBold" Foreground="#17233A"/>
          <TextBlock Text="Choose what gets captured, pause any time, and keep your history private and local."
                     Margin="0,15,0,0" FontSize="16" LineHeight="24" Foreground="#53647A" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource TourCardStyle}" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Privacy &amp; exclusions" FontSize="21" FontWeight="SemiBold" Foreground="#17233A" Margin="0,0,0,14"/>
            <Border Style="{StaticResource TourRowStyle}"><TextBlock Text="⊘   Exclude sensitive apps" Foreground="#40516A"/></Border>
            <Border Style="{StaticResource TourRowStyle}"><TextBlock Text="◎   Keep selected websites out" Foreground="#40516A"/></Border>
            <Border Style="{StaticResource TourRowStyle}"><TextBlock Text="Aa   Exclude keywords" Foreground="#40516A"/></Border>
            <Border Style="{StaticResource TourRowStyle}"><TextBlock Text="▣   Clipboard capture is optional" Foreground="#40516A"/></Border>
            <Border Background="#EAF8F1" BorderBrush="#C9EBDD" BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,4,0,0">
              <TextBlock Text="Everything stays on this PC." Foreground="#247553" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- FOOTER -->
      <Grid Grid.Row="1" Margin="4,16,4,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Content="←  Back" Click="Back_Click" Visibility="Hidden" HorizontalAlignment="Left" Padding="18,9"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="Dot1" Width="9" Height="9" Margin="4"/>
          <Ellipse x:Name="Dot2" Width="9" Height="9" Margin="4"/>
          <Ellipse x:Name="Dot3" Width="9" Height="9" Margin="4"/>
          <Ellipse x:Name="Dot4" Width="9" Height="9" Margin="4"/>
        </StackPanel>
        <Button x:Name="NextButton" Grid.Column="2" Content="Next  →" Style="{StaticResource PrimaryButtonStyle}"
                Click="Next_Click" HorizontalAlignment="Right" Padding="22,10"/>
      </Grid>
    </Grid>
  </Grid>
</Window>