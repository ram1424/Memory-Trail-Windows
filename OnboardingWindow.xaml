<Window x:Class="MemoryLane.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Memory Trail"
        Width="1060" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#12365B">
  <Window.Resources>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="#204E77"/>
      <Setter Property="BorderBrush" Value="#5D8FB8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B4B78" Offset="0"/>
        <GradientStop Color="#163B60" Offset="0.52"/>
        <GradientStop Color="#194469" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- PAGE 1 -->
      <Grid x:Name="Page1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.92*"/>
          <ColumnDefinition Width="1.08*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="8,0,38,0">
          <Border Width="118" Height="118" Background="#242B36" BorderBrush="#5B6879"
                  BorderThickness="1" CornerRadius="30" Padding="12"
                  HorizontalAlignment="Left" Margin="0,0,0,22">
            <Image x:Name="WelcomeBrandLogo" Width="90" Height="90"
                   Stretch="Uniform" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>

          <TextBlock Text="01  •  YOUR TIMELINE" FontSize="12" FontWeight="SemiBold"
                     Foreground="#D3A86A" Margin="0,0,0,10"/>
          <TextBlock Text="Welcome to&#x0a;Memory Trail"
                     FontSize="39" FontWeight="SemiBold"
                     LineHeight="44" Foreground="#FFFFFF"/>
          <TextBlock Text="A private, effortless way to retrace your digital day."
                     Margin="0,17,0,0"
                     FontSize="18" LineHeight="27"
                     Foreground="#D6E1F0"
                     TextWrapping="Wrap"/>
          <TextBlock Text="See the apps, documents, conversations, and pages you touched — organized into one local timeline you control."
                     Margin="0,14,0,0"
                     FontSize="14" LineHeight="22"
                     Foreground="#D5E4F2"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,20,0,20">
          <StackPanel>
            <TextBlock Text="A clear timeline of your day"
                       FontSize="20" FontWeight="SemiBold" Foreground="White"
                       Margin="0,0,0,16"/>

            <!-- Edge -->
            <Border Background="#265A86" CornerRadius="13" Padding="12" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" Background="Transparent">
                  <Image x:Name="EdgeTutorialIcon" Width="36" Height="36" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Microsoft Edge" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Project documentation" Margin="0,3,0,0" Foreground="#F0E9E2"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="9:14 AM" FontSize="11" Foreground="#CFC4B9" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <!-- Outlook -->
            <Border Background="#265A86" CornerRadius="13" Padding="12" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" Background="Transparent">
                  <Image x:Name="OutlookTutorialIcon" Width="36" Height="36" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Outlook" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Weekly project update" Margin="0,3,0,0" Foreground="#F0E9E2"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="10:27 AM" FontSize="11" Foreground="#CFC4B9" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <!-- Teams -->
            <Border Background="#265A86" CornerRadius="13" Padding="12" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" Background="Transparent">
                  <Image x:Name="TeamsTutorialIcon" Width="36" Height="36" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Microsoft Teams" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Design review discussion" Margin="0,3,0,0" Foreground="#F0E9E2"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="11:35 AM" FontSize="11" Foreground="#CFC4B9" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <!-- Explorer -->
            <Border Background="#265A86" CornerRadius="13" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="38" Height="38">
                  <Border Background="#EBAA1F" CornerRadius="8"/>
                  <Path Data="M 6 12 L 17 12 L 20 16 L 33 16 L 33 31 L 6 31 Z" Fill="#FFD15A"/>
                  <Path Data="M 6 12 L 17 12 L 19 15 L 6 15 Z" Fill="#FFF0A8"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="File Explorer" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Project Phoenix" Margin="0,3,0,0" Foreground="#F0E9E2"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="11:41 AM" FontSize="11" Foreground="#CFC4B9" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PAGE 2 -->
      <Grid x:Name="Page2" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.92*"/>
          <ColumnDefinition Width="1.08*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="8,0,38,0">
          <Border Width="98" Height="98" CornerRadius="25"
                  Background="#1084EC" BorderBrush="#45B2FF" BorderThickness="1">
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                       FontSize="44" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="02  •  SEARCH" FontSize="12" FontWeight="SemiBold"
                     Foreground="#D3A86A" Margin="0,20,0,0"/>
          <TextBlock Text="Find it again&#x0a;in seconds"
                     Margin="0,22,0,0"
                     FontSize="39" FontWeight="SemiBold"
                     LineHeight="44" Foreground="White"/>
          <TextBlock Text="Search app names, window titles, notes, links, and copied text from one clean, private history."
                     Margin="0,17,0,0"
                     FontSize="16" LineHeight="25"
                     Foreground="#D8CDC3" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,20,0,20">
          <StackPanel>
            <Border Background="#265A86" BorderBrush="#2C4567" BorderThickness="1"
                    CornerRadius="12" Padding="11">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#BDB1A6" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="project update" Foreground="#F5F0EA"/>
                <TextBlock Grid.Column="2" Text="×" Foreground="#A99D91"/>
              </Grid>
            </Border>

            <TextBlock Text="4 results" Margin="2,16,0,10" FontSize="12" Foreground="#A79B90"/>

            <Border Background="#265A86" CornerRadius="13" Padding="12" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" Background="Transparent">
                  <Image x:Name="OutlookSearchIcon" Width="34" Height="34" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Outlook" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Weekly project update" Margin="0,3,0,0" Foreground="#F0E9E2"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="10:27 AM" FontSize="11" Foreground="#CFC4B9" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Background="#265A86" CornerRadius="13" Padding="12" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" Background="Transparent">
                  <Image x:Name="TeamsSearchIcon" Width="34" Height="34" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Microsoft Teams" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Project update discussion" Margin="0,3,0,0" Foreground="#F0E9E2"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="11:03 AM" FontSize="11" Foreground="#CFC4B9" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Background="#265A86" CornerRadius="13" Padding="12" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="36" Height="36">
                  <Ellipse Fill="#F4C20D"/>
                  <Path Data="M 18 18 L 36 18 A 18 18 0 0 1 9 33 Z" Fill="#34A853"/>
                  <Path Data="M 18 18 L 9 33 A 18 18 0 0 1 8 5 Z" Fill="#EA4335"/>
                  <Path Data="M 18 18 L 8 5 A 18 18 0 0 1 36 18 Z" Fill="#FBBC05"/>
                  <Ellipse Width="15" Height="15" Fill="#4285F4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Google Chrome" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Project update - Google Docs" Margin="0,3,0,0" Foreground="#F0E9E2"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="1:22 PM" FontSize="11" Foreground="#CFC4B9" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border Background="#265A86" CornerRadius="13" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" Background="#1E69D5" CornerRadius="8">
                  <TextBlock Text="W" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Microsoft Word" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Project update draft" Margin="0,3,0,0" Foreground="#F0E9E2"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="2:18 PM" FontSize="11" Foreground="#CFC4B9" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PAGE 3 -->
      <Grid x:Name="Page3" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.92*"/>
          <ColumnDefinition Width="1.08*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="8,0,38,0">
          <Border Width="98" Height="98" CornerRadius="25"
                  Background="#0BB481" BorderBrush="#37E0B0" BorderThickness="1">
            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                       FontSize="43" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="03  •  PRIVACY" FontSize="12" FontWeight="SemiBold"
                     Foreground="#D3A86A" Margin="0,20,0,0"/>
          <TextBlock Text="Your privacy&#x0a;controls"
                     Margin="0,22,0,0"
                     FontSize="39" FontWeight="SemiBold"
                     LineHeight="44" Foreground="White"/>
          <TextBlock Text="Your timeline stays on this PC. Pause capture, exclude sensitive apps, and decide exactly what Memory Trail remembers."
                     Margin="0,17,0,0"
                     FontSize="16" LineHeight="25"
                     Foreground="#D8CDC3" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,20,0,20">
          <StackPanel>
            <Border Background="#11362D" CornerRadius="12" Padding="13" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#139566">
                  <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="17"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Local-only timeline" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Your data stays on this device." Margin="0,3,0,0" Foreground="#A5C9BC"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="#102D50" CornerRadius="12" Padding="13" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#1D7EE0">
                  <TextBlock Text="Ⅱ" Foreground="White" FontWeight="Bold" FontSize="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Pause capture any time" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Quickly pause or resume." Margin="0,3,0,0" Foreground="#A8C3E2"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="#262154" CornerRadius="12" Padding="13" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#6E58E7">
                  <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="17"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Exclude apps and services" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Keep sensitive apps out." Margin="0,3,0,0" Foreground="#BBB6E4"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="#3A2918" CornerRadius="12" Padding="13">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#EB7B17">
                  <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="17"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="No cloud account required" Foreground="White" FontWeight="SemiBold"/>
                  <TextBlock Text="Works fully offline." Margin="0,3,0,0" Foreground="#D5B996"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" Margin="4,16,4,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="BackButton" Content="←  Back"
                Click="Back_Click" Visibility="Hidden"
                HorizontalAlignment="Left" Padding="18,9"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="Dot1" Width="9" Height="9" Margin="4"/>
          <Ellipse x:Name="Dot2" Width="9" Height="9" Margin="4"/>
          <Ellipse x:Name="Dot3" Width="9" Height="9" Margin="4"/>
        </StackPanel>

        <Button x:Name="NextButton" Grid.Column="2"
                Content="Next  →" Style="{StaticResource PrimaryButtonStyle}"
                Click="Next_Click" HorizontalAlignment="Right" Padding="22,10"/>
      </Grid>
    </Grid>
  </Grid>
</Window>