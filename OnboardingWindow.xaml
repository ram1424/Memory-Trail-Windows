<Window x:Class="MemoryLane.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemoryLane.Windows"
        Title="Welcome to Memory Trail"
        Width="920" Height="680"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text"
        Background="#E8EEF9">
  <Window.Resources>
    <Style x:Key="TourCard" TargetType="Border">
      <Setter Property="Background" Value="#FBFCFF"/>
      <Setter Property="BorderBrush" Value="#D8E1EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="FeatureCard" TargetType="Border">
      <Setter Property="Background" Value="#F4F7FC"/>
      <Setter Property="BorderBrush" Value="#E0E7F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="TourButton" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
      <Setter Property="MinWidth" Value="112"/>
      <Setter Property="Height" Value="40"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8EEF9" Offset="0"/>
        <GradientStop Color="#DCE6F5" Offset="0.58"/>
        <GradientStop Color="#D2DFEF" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <Border Margin="20" Background="#F8FAFE" BorderBrush="#D7E0EC" BorderThickness="1"
            CornerRadius="18" Padding="0">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.10"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="50"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="62"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="22,0">
          <TextBlock x:Name="PageCounterText" Text="1 of 6" FontSize="10.5" FontWeight="SemiBold"
                     Foreground="#40506A" VerticalAlignment="Center"/>
          <TextBlock x:Name="PageTitleTopText" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="11.5" FontWeight="SemiBold" Foreground="#66778F" Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="1" Margin="22,4,22,6">
          <Grid x:Name="Page1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340">
              <Border Width="96" Height="96" CornerRadius="24" Background="#EAF0F8">
                <Image x:Name="WelcomeBrandLogo" Width="118" Height="118" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
              <TextBlock Text="Welcome to Memory Trail" FontSize="26" FontWeight="Bold"
                         Foreground="#1A2438" TextAlignment="Center" Margin="0,14,0,0"/>
              <TextBlock Text="A privacy-first, searchable history of the work you do on your PC."
                         FontSize="13" Foreground="#40506A" TextAlignment="Center" TextWrapping="Wrap"
                         LineHeight="19" Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,4,0">
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#E2EEFF">
                  <TextBlock Text="◷" FontSize="21" Foreground="#1680FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Retrace your work" FontSize="14" FontWeight="SemiBold" Foreground="#1A2438"/>
                  <TextBlock Text="See a clean chronological history of apps, pages, messages, files, and copied text."
                             FontSize="11.5" Foreground="#40506A" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="13" Background="#EFE7FC">
                  <TextBlock Text="✦" FontSize="19" Foreground="#7B52D2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Ask Memory Trail" FontSize="16" FontWeight="SemiBold" Foreground="#1A2438"/>
                  <TextBlock Text="Find local history by time, app, filename, subject, page, or nearby activity."
                             FontSize="12.5" Foreground="#40506A" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="13" Background="#E3F5EB">
                  <TextBlock Text="✓" FontSize="19" Foreground="#26945E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Private by design" FontSize="16" FontWeight="SemiBold" Foreground="#1A2438"/>
                  <TextBlock Text="Captured history is sourced, processed, and stored locally on this PC."
                             FontSize="12.5" Foreground="#40506A" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Grid>

          <Grid x:Name="Page2" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Today, Newest First" FontSize="24" FontWeight="Bold" Foreground="#1A2438" HorizontalAlignment="Center"/>
              <TextBlock Text="A continuous timeline of what you viewed—without rewriting or summarizing your activity."
                         FontSize="14" Foreground="#40506A" TextAlignment="Center" TextWrapping="Wrap"
                         MaxWidth="620" Margin="0,7,0,20"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border Background="#1680FF" CornerRadius="13" Padding="9,5" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="All" Width="19" Height="19" Margin="0,0,5,0"/><TextBlock Text="All" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
                <Border Background="#F4F7FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="13" Padding="9,5" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Browser" Width="19" Height="19" Margin="0,0,5,0"/><TextBlock Text="Web" VerticalAlignment="Center"/></StackPanel></Border>
                <Border Background="#F4F7FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="13" Padding="9,5" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Email" Width="19" Height="19" Margin="0,0,5,0"/><TextBlock Text="Email" VerticalAlignment="Center"/></StackPanel></Border>
                <Border Background="#F4F7FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="13" Padding="9,5" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Chat" Width="19" Height="19" Margin="0,0,5,0"/><TextBlock Text="Chat" VerticalAlignment="Center"/></StackPanel></Border>
                <Border Background="#F4F7FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="13" Padding="9,5"><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Files" Width="19" Height="19" Margin="0,0,5,0"/><TextBlock Text="Files" VerticalAlignment="Center"/></StackPanel></Border>
              </StackPanel>
              <Border Style="{StaticResource TourCard}" MaxWidth="660" HorizontalAlignment="Center">
                <StackPanel>
                  <Grid Height="56"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="10:42 AM" Foreground="#66778F" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    <Image x:Name="EdgeTutorialIcon" Grid.Column="1" Width="30" Height="30"/>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="Memory Trail · Releases" FontSize="12.5" FontWeight="SemiBold" Foreground="#1A2438"/>
                        <Border Background="#E6F7EC" CornerRadius="10" Padding="7,2" Margin="8,0,0,0"><TextBlock Text="Live Activity" Foreground="#238A50" FontSize="9.5" FontWeight="SemiBold"/></Border>
                      </StackPanel>
                      <TextBlock Text="Microsoft Edge" Foreground="#66778F" FontSize="11.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="#E8F2FF" CornerRadius="12" Padding="7,4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Browser" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="Web" Foreground="#176EC7" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
                  </Grid>
                  <Border Height="1" Background="#E3E8EF"/>
                  <Grid Height="66"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="10:18 AM" Foreground="#66778F" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    <Image x:Name="OutlookTutorialIcon" Grid.Column="1" Width="34" Height="34"/>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="RE: Project Update" FontSize="13.5" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Microsoft Outlook" Foreground="#66778F" FontSize="11.5" Margin="0,3,0,0"/></StackPanel>
                    <Border Grid.Column="3" Background="#FFF2E3" CornerRadius="12" Padding="7,4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Email" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="Email" Foreground="#C96F13" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
                  </Grid>
                  <Border Height="1" Background="#E3E8EF"/>
                  <Grid Height="66"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="9:54 AM" Foreground="#66778F" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9" Background="#FFF3CC"><TextBlock Text="▰" Foreground="#B78C13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Project Phoenix.xlsx" FontSize="13.5" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="File Explorer" Foreground="#66778F" FontSize="11.5" Margin="0,3,0,0"/></StackPanel>
                    <Border Grid.Column="3" Background="#FFF5D9" CornerRadius="12" Padding="7,4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Files" Width="18" Height="18" Margin="0,0,5,0"/><TextBlock Text="File" Foreground="#A67E11" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
                  </Grid>
                </StackPanel>
              </Border>
              <UniformGrid Columns="3" MaxWidth="670" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Border Style="{StaticResource FeatureCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Live Activity" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="The newest item is clearly identified." TextWrapping="Wrap" FontSize="11.5" Foreground="#66778F" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Details Panel" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Select anything to inspect it on the right." TextWrapping="Wrap" FontSize="11.5" Foreground="#66778F" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureCard}"><StackPanel><TextBlock Text="Dynamic Filters" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Only relevant activity categories appear." TextWrapping="Wrap" FontSize="11.5" Foreground="#66778F" Margin="0,5,0,0"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </Grid>

          <Grid x:Name="Page3" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="Ask Memory Trail" FontSize="29" FontWeight="Bold" Foreground="#1A2438"/>
              <TextBlock Text="Use natural-language local search instead of manually scanning your whole timeline."
                         FontSize="14" Foreground="#40506A" TextAlignment="Center" MaxWidth="620" TextWrapping="Wrap" Margin="0,7,0,22"/>
              <StackPanel Width="650">
                <Border Style="{StaticResource TourCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="✦  What was I doing around 10:30 AM?" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Find activity captured near that time." FontSize="11.5" Foreground="#66778F" Margin="28,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="✦  What did I view before opening Teams?" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Trace what happened immediately before another activity." FontSize="11.5" Foreground="#66778F" Margin="28,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="✦  Find the Outlook email I viewed today" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Match captured application names and subject lines." FontSize="11.5" Foreground="#66778F" Margin="28,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource TourCard}"><StackPanel><TextBlock Text="✦  Find the budget spreadsheet from yesterday" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Search filenames, paths, apps, and dates." FontSize="11.5" Foreground="#66778F" Margin="28,4,0,0"/></StackPanel></Border>
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid x:Name="Page4" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Remember the Useful Details" FontSize="29" FontWeight="Bold" Foreground="#1A2438" HorizontalAlignment="Center"/>
              <TextBlock Text="Memory Trail records meaningful window context—not just the application name."
                         FontSize="14" Foreground="#40506A" HorizontalAlignment="Center" Margin="0,7,0,22"/>
              <UniformGrid Columns="3" Rows="2" MaxWidth="760" HorizontalAlignment="Center">
                <Border Style="{StaticResource FeatureCard}" Margin="0,0,12,12"><StackPanel><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Browser" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="Web Browsers" FontWeight="SemiBold" Foreground="#1A2438" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Page titles and URLs when available." FontSize="11.5" Foreground="#66778F" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureCard}" Margin="0,0,12,12"><StackPanel><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Email" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="Email &amp; Chat" FontWeight="SemiBold" Foreground="#1A2438" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Email subjects and supported conversation titles." FontSize="11.5" Foreground="#66778F" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureCard}" Margin="0,0,0,12"><StackPanel><StackPanel Orientation="Horizontal"><local:CategoryIcon Category="Files" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="Files &amp; Notes" FontWeight="SemiBold" Foreground="#1A2438" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Folders, filenames, documents, and supported notes." FontSize="11.5" Foreground="#66778F" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="▣  Clipboard" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Copied text, links, and code when enabled." FontSize="11.5" Foreground="#66778F" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureCard}" Margin="0,0,12,0"><StackPanel><TextBlock Text="+  Add Memory" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Save a manual note or reference whenever you need it." FontSize="11.5" Foreground="#66778F" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureCard}"><StackPanel><TextBlock Text="★  Favorites" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Keep important timeline items easy to find later." FontSize="11.5" Foreground="#66778F" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </Grid>

          <Grid x:Name="Page5" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
              <Border Width="170" Height="170" CornerRadius="28" Background="#E5EEF9">
                <Grid>
                  <Image x:Name="PrivacyBrandLogo" Width="105" Height="105" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Border Width="44" Height="44" CornerRadius="22" Background="#1680FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24">
                    <TextBlock Text="✓" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Border>
              <TextBlock Text="Your history stays on this PC." FontSize="16" FontWeight="Bold" Foreground="#1A2438" TextAlignment="Center" Margin="0,18,0,0"/>
              <TextBlock Text="Private by default. Local by design." FontSize="12.5" Foreground="#66778F" TextAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,12,0">
              <TextBlock Text="Privacy First. By Design." FontSize="29" FontWeight="Bold" Foreground="#1A2438"/>
              <TextBlock Text="Your activity is captured, processed, and stored locally. Memory Trail does not require cloud sync or an external connector for its timeline."
                         FontSize="13" Foreground="#40506A" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,18"/>
              <Border Style="{StaticResource FeatureCard}" Margin="0,0,0,10"><TextBlock Text="✓  Local processing and local storage" Foreground="#1A2438" FontWeight="SemiBold"/></Border>
              <Border Style="{StaticResource FeatureCard}" Margin="0,0,0,10"><TextBlock Text="✓  Pause capture or disable clipboard capture anytime" Foreground="#1A2438" FontWeight="SemiBold"/></Border>
              <Border Style="{StaticResource FeatureCard}" Margin="0,0,0,10"><TextBlock Text="✓  Exclude apps and processes you do not want recorded" Foreground="#1A2438" FontWeight="SemiBold"/></Border>
              <Border Style="{StaticResource FeatureCard}"><TextBlock Text="✓  Source code available for review and verification" Foreground="#1A2438" FontWeight="SemiBold"/></Border>
            </StackPanel>
          </Grid>

          <Grid x:Name="Page6" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="690">
              <Image x:Name="ContextBrandLogo" Width="118" Height="118" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="Ready to Start" FontSize="25" FontWeight="Bold" Foreground="#1A2438" Margin="0,18,0,0"/>
              <TextBlock Text="Memory Trail uses the window information Windows exposes to create useful local history. You stay in control of capture, exclusions, clipboard history, and startup behavior."
                         FontSize="14" Foreground="#40506A" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,20"/>
              <UniformGrid Columns="3" Width="650">
                <Border Style="{StaticResource FeatureCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Local" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="History remains on this computer." FontSize="11.5" Foreground="#66778F" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Controllable" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Pause or exclude apps whenever needed." FontSize="11.5" Foreground="#66778F" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource FeatureCard}"><StackPanel><TextBlock Text="Searchable" FontWeight="SemiBold" Foreground="#1A2438"/><TextBlock Text="Find what you were doing without scrolling." FontSize="11.5" Foreground="#66778F" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="22,0,22,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="BackButton" Content="←  Back" Click="Back_Click" Style="{StaticResource TourButton}" Visibility="Hidden"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="#1680FF" Margin="4"/>
            <Ellipse x:Name="Dot2" Width="7" Height="7" Fill="#BDC9D9" Margin="4"/>
            <Ellipse x:Name="Dot3" Width="7" Height="7" Fill="#BDC9D9" Margin="4"/>
            <Ellipse x:Name="Dot4" Width="7" Height="7" Fill="#BDC9D9" Margin="4"/>
            <Ellipse x:Name="Dot5" Width="7" Height="7" Fill="#BDC9D9" Margin="4"/>
            <Ellipse x:Name="Dot6" Width="7" Height="7" Fill="#BDC9D9" Margin="4"/>
          </StackPanel>
          <Button x:Name="NextButton" Grid.Column="2" Content="Continue  →" Click="Next_Click"
                  Style="{StaticResource PrimaryButtonStyle}" MinWidth="138" Height="40"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>