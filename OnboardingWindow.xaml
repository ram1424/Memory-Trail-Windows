<Window x:Class="MemoryLane.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Memory Lane"
        Icon="Assets/MemoryLaneIcon.png"
        Width="920" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EAF4FF">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid x:Name="PageHost">
      <!-- PAGE 1 -->
      <Grid x:Name="Page1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.18*"/>
          <ColumnDefinition Width="0.82*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="12,0,28,0">
          <Image Source="Assets/MemoryLaneIcon.png"
                 Width="120" Height="120"
                 HorizontalAlignment="Left"
                 Stretch="Uniform"/>

          <TextBlock Text="Welcome to Memory Lane"
                     Margin="0,28,0,0"
                     FontSize="34"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     MaxWidth="500"
                     Foreground="#10203B"/>

          <TextBlock Text="Retrace your digital day without trying to remember where you saw something."
                     Margin="0,14,0,0"
                     FontSize="17"
                     LineHeight="25"
                     TextWrapping="Wrap"
                     Foreground="#5A6D86"/>

          <TextBlock Text="Memory Lane quietly builds a private timeline of the apps and windows you use, then makes that history searchable."
                     Margin="0,12,0,0"
                     FontSize="15"
                     LineHeight="23"
                     TextWrapping="Wrap"
                     Foreground="#6A7D96"/>
        </StackPanel>

        <Border Grid.Column="1"
                Background="#F8FBFF"
                CornerRadius="24"
                Padding="24"
                Margin="0,34,8,34">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Today"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#20334E"/>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
              <Border Background="#DDEEFF" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="#123A70">
                    <TextBlock Text="E" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BFEAFF"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Web Browser" FontWeight="SemiBold" Foreground="#10203B"/>
                    <TextBlock Text="Product Documentation" Foreground="#5F738C" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Background="#DDEEFF" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="#0D6CA8">
                    <TextBlock Text="O" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D5F4FF"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#10203B"/>
                    <TextBlock Text="Weekly Project Update" Foreground="#5F738C" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Background="#DDEEFF" CornerRadius="14" Padding="14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="#5846A8">
                    <TextBlock Text="T" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#ECE9FF"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Chat" FontWeight="SemiBold" Foreground="#10203B"/>
                    <TextBlock Text="Team Planning Discussion" Foreground="#5F738C" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- PAGE 2 -->
      <Grid x:Name="Page2" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#F8FBFF" CornerRadius="24" Margin="8,34,30,34" Padding="24">
          <Grid>
            <Ellipse Width="260" Height="260" Stroke="#9EC8F2" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="190" Height="190" Stroke="#C9DCF2" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image Source="Assets/MemoryLaneIcon.png"
                   Width="92" Height="92"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Stretch="Uniform"/>

            <Border Width="92" Height="48" CornerRadius="12" Background="#DDEEFF"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,72,0,0">
              <TextBlock Text="Browser" Foreground="#0D5FB8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="92" Height="48" CornerRadius="12" Background="#DDEEFF"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,22,0">
              <TextBlock Text="Email" Foreground="#0D5FB8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="92" Height="48" CornerRadius="12" Background="#DDEEFF"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="42,0,0,82">
              <TextBlock Text="Chat" Foreground="#5B55C8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="104" Height="48" CornerRadius="12" Background="#DDEEFF"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,52">
              <TextBlock Text="Files" Foreground="#1885A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,24,0">
          <TextBlock Text="Remember what you were doing"
                     FontSize="34"
                     FontWeight="SemiBold"
                     Foreground="#10203B"
                     TextWrapping="Wrap"/>
          <TextBlock Text="Memory Lane watches the active application and focused window title, then records meaningful changes in your timeline."
                     Margin="0,16,0,0"
                     FontSize="16"
                     LineHeight="24"
                     Foreground="#5A6D86"
                     TextWrapping="Wrap"/>

          <Border Background="#E5F1FF" CornerRadius="14" Padding="16" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="Examples" FontWeight="SemiBold" Foreground="#20334E"/>
              <TextBlock Text="• Browser: Product documentation" Margin="0,10,0,0" Foreground="#5F738C"/>
              <TextBlock Text="• Email: Weekly project update" Margin="0,7,0,0" Foreground="#5F738C"/>
              <TextBlock Text="• Chat: Team planning discussion" Margin="0,7,0,0" Foreground="#5F738C"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- PAGE 3 -->
      <Grid x:Name="Page3" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="24,0,34,0">
          <TextBlock Text="Find it again in seconds"
                     FontSize="34"
                     FontWeight="SemiBold"
                     Foreground="#10203B"/>
          <TextBlock Text="Search by the words you remember — app name, page title, email subject, copied text, or a note you added yourself."
                     Margin="0,16,0,0"
                     FontSize="16"
                     LineHeight="24"
                     Foreground="#5A6D86"
                     TextWrapping="Wrap"/>

          <Border Background="#E5F1FF" CornerRadius="14" Padding="16" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="Your timeline is searchable" FontWeight="SemiBold" Foreground="#20334E"/>
              <TextBlock Text="Search • Favorites • Manual memories" Margin="0,8,0,0" Foreground="#5F738C"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Column="1" Background="#F8FBFF" CornerRadius="24" Margin="16,34,8,34" Padding="24">
          <StackPanel>
            <Border Background="#F8FBFF" BorderBrush="#C9DCF2" BorderThickness="1" CornerRadius="10" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⌕" FontSize="22" Foreground="#0A84FF" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="project update" Margin="10,0,0,0"
                           FontSize="16" Foreground="#10203B" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <TextBlock Text="2 results" Margin="0,20,0,10" FontSize="13" Foreground="#6D7F96"/>

            <Border Background="#DDEEFF" CornerRadius="12" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Email" Foreground="#0A84FF" FontWeight="SemiBold"/>
                <TextBlock Text="Weekly Project Update" Margin="0,5,0,0" Foreground="#10203B" FontWeight="SemiBold"/>
                <TextBlock Text="10:42 AM" Margin="0,5,0,0" Foreground="#6D7F96"/>
              </StackPanel>
            </Border>

            <Border Background="#DDEEFF" CornerRadius="12" Padding="14">
              <StackPanel>
                <TextBlock Text="Manual Memory" Foreground="#0A84FF" FontWeight="SemiBold"/>
                <TextBlock Text="Follow up on project update" Margin="0,5,0,0" Foreground="#10203B" FontWeight="SemiBold"/>
                <TextBlock Text="Yesterday" Margin="0,5,0,0" Foreground="#6D7F96"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PAGE 4 -->
      <Grid x:Name="Page4" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.95*"/>
          <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#F8FBFF" CornerRadius="24" Margin="8,34,30,34" Padding="26">
          <Grid>
            <Ellipse Width="250" Height="250" Fill="#123A70" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path Data="M 180,110 L 270,145 L 255,265 L 180,300 L 105,265 L 90,145 Z"
                  Fill="#1885A0" Stroke="#FFB65C" StrokeThickness="3"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Stretch="Uniform" Width="210" Height="230"/>
            <Path Data="M 142,206 L 170,234 L 225,170"
                  Stroke="White" StrokeThickness="9" Fill="Transparent"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="120" Height="100" Stretch="Uniform"/>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,18,0">
          <TextBlock Text="Private by design"
                     FontSize="34"
                     FontWeight="SemiBold"
                     Foreground="#10203B"/>
          <TextBlock Text="Your timeline stays on this PC. You control what Memory Lane remembers, and capture can be paused at any time."
                     Margin="0,16,0,0"
                     FontSize="16"
                     LineHeight="24"
                     Foreground="#5A6D86"
                     TextWrapping="Wrap"/>

          <StackPanel Margin="0,24,0,0">
            <TextBlock Text="✓ Local-only timeline storage" Foreground="#397A50" Margin="0,0,0,9"/>
            <TextBlock Text="✓ Optional clipboard capture" Foreground="#397A50" Margin="0,0,0,9"/>
            <TextBlock Text="✓ Per-app privacy exclusions" Foreground="#397A50" Margin="0,0,0,9"/>
            <TextBlock Text="✓ No account, analytics, or advertising SDK" Foreground="#397A50"/>
          </StackPanel>

          <Border Background="#EDF8F1" BorderBrush="#C6E7D2" BorderThickness="1" CornerRadius="12"
                  Padding="14" Margin="0,24,0,0">
            <TextBlock Text="You can change these controls any time in Settings."
                       Foreground="#397A50" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" Margin="4,22,4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="BackButton"
              Content="Back"
              Click="Back_Click"
              Visibility="Hidden"
              HorizontalAlignment="Left"
              Padding="18,9"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#0A84FF" Margin="4"/>
        <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#CFE3F8" Margin="4"/>
        <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#CFE3F8" Margin="4"/>
        <Ellipse x:Name="Dot4" Width="8" Height="8" Fill="#CFE3F8" Margin="4"/>
      </StackPanel>

      <Button x:Name="NextButton"
              Grid.Column="2"
              Content="Next"
              Click="Next_Click"
              HorizontalAlignment="Right"
              Padding="20,9"/>
    </Grid>
  </Grid>
</Window>