<Window x:Class="MemoryLane.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Memory Trail"
        Icon="/Assets/MemoryLaneReferenceIcon.png"
        Width="980" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EEF6FF">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Page 1 -->
    <Grid x:Name="Page1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.92*"/>
        <ColumnDefinition Width="1.08*"/>
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Center" Margin="10,0,34,0">
        <Image Source="/Assets/MemoryLaneReferenceIcon.png"
               Width="92" Height="92"
               Stretch="Uniform"
               HorizontalAlignment="Left"
               Margin="0,0,0,22"/>

        <TextBlock Text="Welcome to&#x0a;Memory Trail"
                   FontSize="38"
                   FontWeight="SemiBold"
                   Foreground="#10203B"
                   LineHeight="42"/>

        <TextBlock Text="Retrace your digital day without trying to remember where you saw something."
                   Margin="0,16,0,0"
                   FontSize="18"
                   LineHeight="27"
                   Foreground="#334F6B"
                   TextWrapping="Wrap"/>

        <TextBlock Text="Memory Trail quietly builds a private timeline of the apps and windows you use, then makes that history searchable."
                   Margin="0,14,0,0"
                   FontSize="14"
                   LineHeight="22"
                   Foreground="#6C8096"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Column="1"
              Background="#FFFFFF"
              BorderBrush="#D6E7F8"
              BorderThickness="1"
              CornerRadius="20"
              Padding="22"
              Margin="4,22,4,22">
        <StackPanel>
          <TextBlock Text="See your activity in context"
                     FontSize="19"
                     FontWeight="SemiBold"
                     Foreground="#10203B"
                     Margin="0,0,0,16"/>

          <Border Background="#F8FBFF" CornerRadius="13" Padding="13" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="9" Background="#E4F3FF">
                <TextBlock Text="E" Foreground="#0A84FF" FontWeight="Bold" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="9,0,6,0">
                <TextBlock Text="Microsoft Edge" FontWeight="SemiBold" Foreground="#10203B"/>
                <TextBlock Text="Product Documentation" Margin="0,3,0,0" Foreground="#6A7F95"/>
              </StackPanel>
              <Border Grid.Column="2" Width="60" Height="34" CornerRadius="6"
                      BorderBrush="#D6E7F8" BorderThickness="1" Background="#FFFFFF">
                <StackPanel Margin="7,6">
                  <Border Height="3" Background="#9FC8EE" CornerRadius="2" Margin="0,0,0,4"/>
                  <Border Height="3" Background="#D0E2F2" CornerRadius="2" Margin="0,0,8,0"/>
                </StackPanel>
              </Border>
              <TextBlock Grid.Column="3" Text="9:14 AM" FontSize="11" Foreground="#7F92A6"
                         Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Background="#F8FBFF" CornerRadius="13" Padding="13" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="9" Background="#E7F1FF">
                <TextBlock Text="O" Foreground="#1768C4" FontWeight="Bold" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="9,0,6,0">
                <TextBlock Text="Outlook" FontWeight="SemiBold" Foreground="#10203B"/>
                <TextBlock Text="Weekly Project Update" Margin="0,3,0,0" Foreground="#6A7F95"/>
              </StackPanel>
              <Border Grid.Column="2" Width="60" Height="34" CornerRadius="6"
                      BorderBrush="#D6E7F8" BorderThickness="1" Background="#FFFFFF">
                <StackPanel Margin="7,6">
                  <Border Height="3" Background="#9FC8EE" CornerRadius="2" Margin="0,0,0,4"/>
                  <Border Height="3" Background="#D0E2F2" CornerRadius="2" Margin="0,0,8,0"/>
                </StackPanel>
              </Border>
              <TextBlock Grid.Column="3" Text="10:27 AM" FontSize="11" Foreground="#7F92A6"
                         Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Background="#F8FBFF" CornerRadius="13" Padding="13">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="9" Background="#EEEAFE">
                <TextBlock Text="T" Foreground="#6757D7" FontWeight="Bold" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="9,0,6,0">
                <TextBlock Text="Microsoft Teams" FontWeight="SemiBold" Foreground="#10203B"/>
                <TextBlock Text="Team Planning Discussion" Margin="0,3,0,0" Foreground="#6A7F95"/>
              </StackPanel>
              <Border Grid.Column="2" Width="60" Height="34" CornerRadius="6"
                      BorderBrush="#D6E7F8" BorderThickness="1" Background="#FFFFFF">
                <StackPanel Margin="7,6">
                  <Border Height="3" Background="#AFA4F5" CornerRadius="2" Margin="0,0,0,4"/>
                  <Border Height="3" Background="#D8D2F8" CornerRadius="2" Margin="0,0,8,0"/>
                </StackPanel>
              </Border>
              <TextBlock Grid.Column="3" Text="11:03 AM" FontSize="11" Foreground="#7F92A6"
                         Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Page 2 -->
    <Grid x:Name="Page2" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Center" Margin="10,0,32,0">
        <TextBlock Text="Remember what you&#x0a;were doing"
                   FontSize="35"
                   FontWeight="SemiBold"
                   Foreground="#10203B"
                   LineHeight="41"/>
        <TextBlock Text="Memory Trail watches the active application and focused window title, then records meaningful changes in your timeline."
                   Margin="0,16,0,0"
                   FontSize="16"
                   LineHeight="25"
                   Foreground="#536A83"
                   TextWrapping="Wrap"/>
        <Border Background="#FFFFFF" CornerRadius="14" Padding="16" Margin="0,24,0,0"
                BorderBrush="#D6E7F8" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Examples" FontWeight="SemiBold" Foreground="#10203B"/>
            <TextBlock Text="• Browser: Product Documentation" Margin="0,10,0,0" Foreground="#657B92"/>
            <TextBlock Text="• Email: Weekly Project Update" Margin="0,6,0,0" Foreground="#657B92"/>
            <TextBlock Text="• Chat: Team Planning Discussion" Margin="0,6,0,0" Foreground="#657B92"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Column="1"
              Background="#FFFFFF"
              BorderBrush="#D6E7F8"
              BorderThickness="1"
              CornerRadius="20"
              Padding="28"
              Margin="6,24,4,24">
        <Grid>
          <Border Width="3" Background="#D6E8F9" HorizontalAlignment="Left" Margin="22,12,0,12"/>
          <StackPanel Margin="0,18,0,0">
            <Border Background="#F8FBFF" BorderBrush="#D6E7F8" BorderThickness="1"
                    CornerRadius="13" Padding="13" Margin="46,0,0,14">
              <StackPanel>
                <TextBlock Text="Microsoft Edge" FontWeight="SemiBold" Foreground="#10203B"/>
                <TextBlock Text="Product Documentation" Margin="0,3,0,0" Foreground="#60758C"/>
                <TextBlock Text="9:14 AM" Margin="0,4,0,0" FontSize="11" Foreground="#8294A7"/>
              </StackPanel>
            </Border>
            <Border Background="#F8FBFF" BorderBrush="#D6E7F8" BorderThickness="1"
                    CornerRadius="13" Padding="13" Margin="46,0,0,14">
              <StackPanel>
                <TextBlock Text="Outlook" FontWeight="SemiBold" Foreground="#10203B"/>
                <TextBlock Text="Weekly Project Update" Margin="0,3,0,0" Foreground="#60758C"/>
                <TextBlock Text="10:27 AM" Margin="0,4,0,0" FontSize="11" Foreground="#8294A7"/>
              </StackPanel>
            </Border>
            <Border Background="#F8FBFF" BorderBrush="#D6E7F8" BorderThickness="1"
                    CornerRadius="13" Padding="13" Margin="46,0,0,0">
              <StackPanel>
                <TextBlock Text="Microsoft Teams" FontWeight="SemiBold" Foreground="#10203B"/>
                <TextBlock Text="Team Planning Discussion" Margin="0,3,0,0" Foreground="#60758C"/>
                <TextBlock Text="11:03 AM" Margin="0,4,0,0" FontSize="11" Foreground="#8294A7"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <Ellipse Width="12" Height="12" Fill="#FFFFFF" Stroke="#2196F3" StrokeThickness="3"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,55,0,0"/>
          <Ellipse Width="12" Height="12" Fill="#FFFFFF" Stroke="#2196F3" StrokeThickness="3"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,164,0,0"/>
          <Ellipse Width="12" Height="12" Fill="#FFFFFF" Stroke="#2196F3" StrokeThickness="3"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,273,0,0"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Page 3 -->
    <Grid x:Name="Page3" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Center" Margin="10,0,34,0">
        <TextBlock Text="Find it again&#x0a;in seconds"
                   FontSize="35"
                   FontWeight="SemiBold"
                   Foreground="#10203B"
                   LineHeight="41"/>
        <TextBlock Text="Search by application, page title, copied text, or a memory you saved yourself."
                   Margin="0,16,0,0"
                   FontSize="16"
                   LineHeight="25"
                   Foreground="#536A83"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Column="1"
              Background="#FFFFFF"
              BorderBrush="#D6E7F8"
              BorderThickness="1"
              CornerRadius="20"
              Padding="22"
              Margin="6,24,4,24">
        <StackPanel>
          <Border Background="#F8FBFF" BorderBrush="#D6E7F8" BorderThickness="1"
                  CornerRadius="9" Padding="11">
            <TextBlock Text="⌕  project update" Foreground="#405A74"/>
          </Border>
          <TextBlock Text="2 matching memories" Margin="0,18,0,10" Foreground="#8496A9" FontSize="11"/>
          <Border Background="#F8FBFF" CornerRadius="13" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Outlook · 10:27 AM" Foreground="#0A84FF" FontWeight="SemiBold"/>
              <TextBlock Text="Weekly Project Update" Margin="0,5,0,0" Foreground="#10203B" FontWeight="SemiBold"/>
              <TextBlock Text="Review milestones and next steps" Margin="0,4,0,0" Foreground="#667B92"/>
            </StackPanel>
          </Border>
          <Border Background="#F8FBFF" CornerRadius="13" Padding="14">
            <StackPanel>
              <TextBlock Text="Saved Memory · Yesterday" Foreground="#0A84FF" FontWeight="SemiBold"/>
              <TextBlock Text="Follow up on project update" Margin="0,5,0,0" Foreground="#10203B" FontWeight="SemiBold"/>
              <TextBlock Text="Manual notes live beside captured activity." Margin="0,4,0,0" Foreground="#667B92"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Page 4 -->
    <Grid x:Name="Page4" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Center" Margin="10,0,34,0">
        <Image Source="/Assets/MemoryLaneReferenceIcon.png" Width="92" Height="92"
               HorizontalAlignment="Left" Margin="0,0,0,22"/>
        <TextBlock Text="Private by design"
                   FontSize="35"
                   FontWeight="SemiBold"
                   Foreground="#10203B"/>
        <TextBlock Text="Your timeline stays on this PC. You control capture, exclusions, clipboard history, and when Memory Trail is paused."
                   Margin="0,16,0,0"
                   FontSize="16"
                   LineHeight="25"
                   Foreground="#536A83"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Column="1"
              Background="#FFFFFF"
              BorderBrush="#D6E7F8"
              BorderThickness="1"
              CornerRadius="20"
              Padding="22"
              Margin="6,24,4,24">
        <StackPanel>
          <TextBlock Text="Your privacy controls"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="#10203B"
                     Margin="0,0,0,14"/>
          <Border Background="#F2F9F5" CornerRadius="12" Padding="13" Margin="0,0,0,9">
            <TextBlock Text="✓ Local-only timeline" Foreground="#2E6F4E" FontWeight="SemiBold"/>
          </Border>
          <Border Background="#F8FBFF" CornerRadius="12" Padding="13" Margin="0,0,0,9">
            <TextBlock Text="✓ Pause or resume capture any time" Foreground="#315E90" FontWeight="SemiBold"/>
          </Border>
          <Border Background="#F8FBFF" CornerRadius="12" Padding="13" Margin="0,0,0,9">
            <TextBlock Text="✓ Exclude apps and services" Foreground="#315E90" FontWeight="SemiBold"/>
          </Border>
          <Border Background="#F8FBFF" CornerRadius="12" Padding="13">
            <TextBlock Text="✓ No cloud account required" Foreground="#315E90" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="4,18,4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="BackButton"
              Content="Back"
              Click="Back_Click"
              Visibility="Hidden"
              HorizontalAlignment="Left"
              Padding="18,9"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#168CFF" Margin="4"/>
        <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#C8D9E9" Margin="4"/>
        <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#C8D9E9" Margin="4"/>
        <Ellipse x:Name="Dot4" Width="8" Height="8" Fill="#C8D9E9" Margin="4"/>
      </StackPanel>

      <Button x:Name="NextButton"
              Grid.Column="2"
              Content="Next"
              Style="{StaticResource PrimaryButtonStyle}"
              Click="Next_Click"
              HorizontalAlignment="Right"
              Padding="22,10"/>
    </Grid>
  </Grid>
</Window>