<Window x:Class="MemoryLane.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Memory Lane"
        Icon="Assets/MemoryLaneIcon.png"
        Width="920" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F8FC">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid x:Name="PageHost">
      <!-- PAGE 1 -->
      <Grid x:Name="Page1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.05*"/>
          <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="12,0,48,0">
          <Image Source="Assets/MemoryLaneIcon.png"
                 Width="120" Height="120"
                 HorizontalAlignment="Left"
                 Stretch="Uniform"/>

          <TextBlock Text="Welcome to Memory Lane"
                     Margin="0,28,0,0"
                     FontSize="36"
                     FontWeight="SemiBold"
                     Foreground="#182235"/>

          <TextBlock Text="Retrace your digital day without trying to remember where you saw something."
                     Margin="0,14,0,0"
                     FontSize="17"
                     LineHeight="25"
                     TextWrapping="Wrap"
                     Foreground="#607087"/>

          <TextBlock Text="Memory Lane quietly builds a private timeline of the apps and windows you use, then makes that history searchable."
                     Margin="0,12,0,0"
                     FontSize="15"
                     LineHeight="23"
                     TextWrapping="Wrap"
                     Foreground="#7A899E"/>
        </StackPanel>

        <Border Grid.Column="1"
                Background="#FFFFFF"
                CornerRadius="24"
                Padding="24"
                Margin="0,34,8,34">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Today"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#26364D"/>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
              <Border Background="#F1F5FA" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="#123E67">
                    <TextBlock Text="E" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#76C8FF"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Microsoft Edge" FontWeight="SemiBold" Foreground="#182235"/>
                    <TextBlock Text="Cisco Room Bar Configuration Guide" Foreground="#65758B" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Background="#F1F5FA" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="#1B4D3A">
                    <TextBlock Text="O" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7CE0A8"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Outlook" FontWeight="SemiBold" Foreground="#182235"/>
                    <TextBlock Text="Incident Update | PH2" Foreground="#65758B" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Background="#F1F5FA" CornerRadius="14" Padding="14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="#3A2A68">
                    <TextBlock Text="T" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C4A7FF"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Microsoft Teams" FontWeight="SemiBold" Foreground="#182235"/>
                    <TextBlock Text="John Smith | Project Phoenix" Foreground="#65758B" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- PAGE 2 -->
      <Grid x:Name="Page2" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#FFFFFF" CornerRadius="24" Margin="8,34,30,34" Padding="24">
          <Grid>
            <Ellipse Width="260" Height="260" Stroke="#1F344A" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="190" Height="190" Stroke="#1A2A3C" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image Source="Assets/MemoryLaneIcon.png"
                   Width="92" Height="92"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Stretch="Uniform"/>

            <Border Width="92" Height="48" CornerRadius="12" Background="#F1F5FA"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,72,0,0">
              <TextBlock Text="Edge" Foreground="#BFD9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="92" Height="48" CornerRadius="12" Background="#F1F5FA"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,22,0">
              <TextBlock Text="Outlook" Foreground="#BFD9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="92" Height="48" CornerRadius="12" Background="#F1F5FA"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="42,0,0,82">
              <TextBlock Text="Teams" Foreground="#D7C4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="104" Height="48" CornerRadius="12" Background="#F1F5FA"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,52">
              <TextBlock Text="Explorer" Foreground="#BFE8D0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,24,0">
          <TextBlock Text="Remember what you were doing"
                     FontSize="34"
                     FontWeight="SemiBold"
                     Foreground="#182235"
                     TextWrapping="Wrap"/>
          <TextBlock Text="Memory Lane watches the active application and focused window title, then records meaningful changes in your timeline."
                     Margin="0,16,0,0"
                     FontSize="16"
                     LineHeight="24"
                     Foreground="#607087"
                     TextWrapping="Wrap"/>

          <Border Background="#EEF3F9" CornerRadius="14" Padding="16" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="Examples" FontWeight="SemiBold" Foreground="#26364D"/>
              <TextBlock Text="• Edge page: Cisco Room Bar Configuration Guide" Margin="0,10,0,0" Foreground="#65758B"/>
              <TextBlock Text="• Outlook: Incident Update | PH2" Margin="0,7,0,0" Foreground="#65758B"/>
              <TextBlock Text="• Teams: John Smith | Project Phoenix" Margin="0,7,0,0" Foreground="#65758B"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- PAGE 3 -->
      <Grid x:Name="Page3" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="24,0,34,0">
          <TextBlock Text="Find it again in seconds"
                     FontSize="34"
                     FontWeight="SemiBold"
                     Foreground="#182235"/>
          <TextBlock Text="Search by the words you remember — app name, page title, email subject, copied text, or a note you added yourself."
                     Margin="0,16,0,0"
                     FontSize="16"
                     LineHeight="24"
                     Foreground="#607087"
                     TextWrapping="Wrap"/>

          <Border Background="#EEF3F9" CornerRadius="14" Padding="16" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="Your timeline is searchable" FontWeight="SemiBold" Foreground="#26364D"/>
              <TextBlock Text="Search • Favorites • Manual memories" Margin="0,8,0,0" Foreground="#65758B"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="24" Margin="16,34,8,34" Padding="24">
          <StackPanel>
            <Border Background="#FFFFFF" BorderBrush="#D5DEE9" BorderThickness="1" CornerRadius="10" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⌕" FontSize="22" Foreground="#7FA5D1" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="incident update" Margin="10,0,0,0"
                           FontSize="16" Foreground="#182235" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <TextBlock Text="2 results" Margin="0,20,0,10" FontSize="13" Foreground="#78869A"/>

            <Border Background="#F1F5FA" CornerRadius="12" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Outlook" Foreground="#70C2FF" FontWeight="SemiBold"/>
                <TextBlock Text="Incident Update | PH2" Margin="0,5,0,0" Foreground="#182235" FontWeight="SemiBold"/>
                <TextBlock Text="10:42 AM" Margin="0,5,0,0" Foreground="#78869A"/>
              </StackPanel>
            </Border>

            <Border Background="#F1F5FA" CornerRadius="12" Padding="14">
              <StackPanel>
                <TextBlock Text="Memory Lane" Foreground="#70C2FF" FontWeight="SemiBold"/>
                <TextBlock Text="Follow up on incident update" Margin="0,5,0,0" Foreground="#182235" FontWeight="SemiBold"/>
                <TextBlock Text="Yesterday" Margin="0,5,0,0" Foreground="#78869A"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PAGE 4 -->
      <Grid x:Name="Page4" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.95*"/>
          <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#FFFFFF" CornerRadius="24" Margin="8,34,30,34" Padding="26">
          <Grid>
            <Ellipse Width="250" Height="250" Fill="#0E2435" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path Data="M 180,110 L 270,145 L 255,265 L 180,300 L 105,265 L 90,145 Z"
                  Fill="#163C59" Stroke="#65C8FF" StrokeThickness="3"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Stretch="Uniform" Width="210" Height="230"/>
            <Path Data="M 142,206 L 170,234 L 225,170"
                  Stroke="White" StrokeThickness="9" Fill="Transparent"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="120" Height="100" Stretch="Uniform"/>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,18,0">
          <TextBlock Text="Private by design"
                     FontSize="34"
                     FontWeight="SemiBold"
                     Foreground="#182235"/>
          <TextBlock Text="Your timeline stays on this PC. You control what Memory Lane remembers, and capture can be paused at any time."
                     Margin="0,16,0,0"
                     FontSize="16"
                     LineHeight="24"
                     Foreground="#607087"
                     TextWrapping="Wrap"/>

          <StackPanel Margin="0,24,0,0">
            <TextBlock Text="✓ Local-only timeline storage" Foreground="#397A50" Margin="0,0,0,9"/>
            <TextBlock Text="✓ Optional clipboard capture" Foreground="#397A50" Margin="0,0,0,9"/>
            <TextBlock Text="✓ Per-app privacy exclusions" Foreground="#397A50" Margin="0,0,0,9"/>
            <TextBlock Text="✓ No account, analytics, or advertising SDK" Foreground="#397A50"/>
          </StackPanel>

          <Border Background="#EDF8F1" BorderBrush="#C6E7D2" BorderThickness="1" CornerRadius="12"
                  Padding="14" Margin="0,24,0,0">
            <TextBlock Text="You can change these controls any time in Settings."
                       Foreground="#397A50" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" Margin="4,22,4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="BackButton"
              Content="Back"
              Click="Back_Click"
              Visibility="Hidden"
              HorizontalAlignment="Left"
              Padding="18,9"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#2F6FED" Margin="4"/>
        <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#D7DEE8" Margin="4"/>
        <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#D7DEE8" Margin="4"/>
        <Ellipse x:Name="Dot4" Width="8" Height="8" Fill="#D7DEE8" Margin="4"/>
      </StackPanel>

      <Button x:Name="NextButton"
              Grid.Column="2"
              Content="Next"
              Click="Next_Click"
              HorizontalAlignment="Right"
              Padding="20,9"/>
    </Grid>
  </Grid>
</Window>