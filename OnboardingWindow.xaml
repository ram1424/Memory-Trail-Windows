<Window x:Class="MemoryLane.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Memory Trail"
        Width="980" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F8FC">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid x:Name="Page1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Center" Margin="12,0,34,0">
        <Border Width="98" Height="98" CornerRadius="24"
                Background="#0B1F4A"
                HorizontalAlignment="Left"
                Margin="0,0,0,22">
          <Image x:Name="WelcomeBrandLogo" Width="92" Height="92" Stretch="Uniform"/>
        </Border>
        <TextBlock Text="Welcome to&#x0a;Memory Trail"
                   FontSize="38" FontWeight="SemiBold"
                   LineHeight="42" Foreground="#172033"/>
        <TextBlock Text="A simple, private way to retrace your digital day."
                   Margin="0,16,0,0"
                   FontSize="18" LineHeight="27"
                   Foreground="#405268"
                   TextWrapping="Wrap"/>
        <TextBlock Text="Memory Trail quietly keeps a searchable history of the apps and windows you use so you can find your way back."
                   Margin="0,14,0,0"
                   FontSize="14" LineHeight="22"
                   Foreground="#748399"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Column="1"
              Background="#FFFFFF"
              BorderBrush="#E1E8F0"
              BorderThickness="1"
              CornerRadius="20"
              Padding="22"
              Margin="4,20,4,20">
        <StackPanel>
          <TextBlock Text="Your day, at a glance"
                     FontSize="19" FontWeight="SemiBold"
                     Foreground="#172033"
                     Margin="0,0,0,16"/>

          <Border Background="#F8FBFF" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="38" Height="38" CornerRadius="10">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#16C7C8" Offset="0"/>
                    <GradientStop Color="#1577FF" Offset="0.55"/>
                    <GradientStop Color="#22C55E" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="e" Foreground="White" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Microsoft Edge" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock Text="Project documentation" Margin="0,3,0,0" Foreground="#6B7A90"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="9:14 AM" FontSize="11" Foreground="#98A2B3"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Background="#F8FBFF" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="38" Height="38" CornerRadius="10" Background="#1677E8">
                <TextBlock Text="O" Foreground="White" FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Outlook" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock Text="Weekly project update" Margin="0,3,0,0" Foreground="#6B7A90"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="10:27 AM" FontSize="11" Foreground="#98A2B3"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Background="#F8FBFF" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="38" Height="38" CornerRadius="10" Background="#6554C0">
                <TextBlock Text="T" Foreground="White" FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Microsoft Teams" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock Text="Design review discussion" Margin="0,3,0,0" Foreground="#6B7A90"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="11:03 AM" FontSize="11" Foreground="#98A2B3"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Background="#F8FBFF" CornerRadius="14" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="38" Height="38" CornerRadius="10" Background="#F4B63D">
                <TextBlock Text="F" Foreground="White" FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="File Explorer" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock Text="Project Phoenix" Margin="0,3,0,0" Foreground="#6B7A90"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="11:41 AM" FontSize="11" Foreground="#98A2B3"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="Page2" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Center" Margin="12,0,34,0">
        <TextBlock Text="Remember what you&#x0a;were doing"
                   FontSize="36" FontWeight="SemiBold"
                   LineHeight="41" Foreground="#172033"/>
        <TextBlock Text="Memory Trail records meaningful app and window changes so your history stays useful instead of noisy."
                   Margin="0,16,0,0" FontSize="16" LineHeight="25"
                   Foreground="#53667C" TextWrapping="Wrap"/>
        <Border Background="#EAF3FF" CornerRadius="12" Padding="14" Margin="0,22,0,0">
          <TextBlock Text="Tip: double-click any timeline item to open its details."
                     Foreground="#245B9B" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>

      <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E1E8F0"
              BorderThickness="1" CornerRadius="20" Padding="26" Margin="4,22,4,22">
        <Grid>
          <Border Width="2" Background="#D8E9FB" HorizontalAlignment="Left" Margin="20,12,0,12"/>
          <StackPanel>
            <Grid Margin="0,8,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse Width="12" Height="12" Fill="#1677FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Background="#F8FBFF" CornerRadius="13" Padding="13">
                <StackPanel>
                  <TextBlock Text="Microsoft Edge" Foreground="#1577FF" FontWeight="SemiBold"/>
                  <TextBlock Text="Product documentation" Margin="0,3,0,0" Foreground="#172033"/>
                  <TextBlock Text="9:14 AM" Margin="0,4,0,0" FontSize="11" Foreground="#98A2B3"/>
                </StackPanel>
              </Border>
            </Grid>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse Width="12" Height="12" Fill="#6554C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Background="#F8FBFF" CornerRadius="13" Padding="13">
                <StackPanel>
                  <TextBlock Text="Microsoft Teams" Foreground="#6554C0" FontWeight="SemiBold"/>
                  <TextBlock Text="Design review discussion" Margin="0,3,0,0" Foreground="#172033"/>
                  <TextBlock Text="10:03 AM" Margin="0,4,0,0" FontSize="11" Foreground="#98A2B3"/>
                </StackPanel>
              </Border>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse Width="12" Height="12" Fill="#F4B63D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Background="#F8FBFF" CornerRadius="13" Padding="13">
                <StackPanel>
                  <TextBlock Text="File Explorer" Foreground="#B87700" FontWeight="SemiBold"/>
                  <TextBlock Text="Project Phoenix" Margin="0,3,0,0" Foreground="#172033"/>
                  <TextBlock Text="11:41 AM" Margin="0,4,0,0" FontSize="11" Foreground="#98A2B3"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="Page3" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Center" Margin="12,0,34,0">
        <TextBlock Text="Find it again&#x0a;in seconds"
                   FontSize="36" FontWeight="SemiBold"
                   LineHeight="41" Foreground="#172033"/>
        <TextBlock Text="Search across app names, window titles, notes, links, and copied text from one place."
                   Margin="0,16,0,0" FontSize="16" LineHeight="25"
                   Foreground="#53667C" TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E1E8F0"
              BorderThickness="1" CornerRadius="20" Padding="22" Margin="4,22,4,22">
        <StackPanel>
          <Border Background="#F7FAFD" BorderBrush="#DCE5EF" BorderThickness="1"
                  CornerRadius="10" Padding="11">
            <TextBlock Text="⌕   project update" Foreground="#405268"/>
          </Border>
          <TextBlock Text="2 results" Margin="2,18,0,10" FontSize="11" Foreground="#98A2B3"/>
          <Border Background="#F8FBFF" CornerRadius="13" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="9" Background="#1677E8">
                <TextBlock Text="O" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Outlook" Foreground="#1677E8" FontWeight="SemiBold"/>
                <TextBlock Text="Weekly project update" Margin="0,4,0,0" Foreground="#172033"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Background="#F8FBFF" CornerRadius="13" Padding="14">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="9" Background="#0B1F4A">
                <TextBlock Text="M" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Saved memory" Foreground="#315A8A" FontWeight="SemiBold"/>
                <TextBlock Text="Follow up on project update" Margin="0,4,0,0" Foreground="#172033"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="Page4" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Center" Margin="12,0,34,0">
        <Border Width="98" Height="98" CornerRadius="24" Background="#0B1F4A"
                HorizontalAlignment="Left" Margin="0,0,0,22">
          <Image x:Name="PrivacyBrandLogo" Width="92" Height="92" Stretch="Uniform"/>
        </Border>
        <TextBlock Text="Private by design"
                   FontSize="36" FontWeight="SemiBold"
                   Foreground="#172033"/>
        <TextBlock Text="Your timeline stays on this PC. You control capture, exclusions, clipboard history, and when Memory Trail is paused."
                   Margin="0,16,0,0" FontSize="16" LineHeight="25"
                   Foreground="#53667C" TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E1E8F0"
              BorderThickness="1" CornerRadius="20" Padding="24" Margin="4,22,4,22">
        <StackPanel>
          <TextBlock Text="Your privacy controls" FontSize="19" FontWeight="SemiBold"
                     Foreground="#172033" Margin="0,0,0,16"/>
          <Border Background="#ECFDF3" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <TextBlock Text="✓  Local-only timeline" Foreground="#18794E" FontWeight="SemiBold"/>
          </Border>
          <Border Background="#EEF5FF" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <TextBlock Text="✓  Pause capture any time" Foreground="#245B9B" FontWeight="SemiBold"/>
          </Border>
          <Border Background="#F4F0FF" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <TextBlock Text="✓  Exclude apps and services" Foreground="#6246A8" FontWeight="SemiBold"/>
          </Border>
          <Border Background="#FFF7E7" CornerRadius="12" Padding="14">
            <TextBlock Text="✓  No cloud account required" Foreground="#946200" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="4,18,4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="BackButton" Content="Back"
              Click="Back_Click" Visibility="Hidden"
              HorizontalAlignment="Left" Padding="18,9"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="4"/>
        <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="4"/>
        <Ellipse x:Name="Dot3" Width="8" Height="8" Margin="4"/>
        <Ellipse x:Name="Dot4" Width="8" Height="8" Margin="4"/>
      </StackPanel>

      <Button x:Name="NextButton" Grid.Column="2"
              Content="Next" Style="{StaticResource PrimaryButtonStyle}"
              Click="Next_Click" HorizontalAlignment="Right" Padding="22,10"/>
    </Grid>
  </Grid>
</Window>