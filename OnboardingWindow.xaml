<Window x:Class="MemoryLane.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Memory Lane"
        Icon="{StaticResource MemoryLaneBrandIcon}"
        Width="980" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#E5EEF8">
  <Grid Margin="34">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <!-- PAGE 1 -->
      <Grid x:Name="Page1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.92*"/>
          <ColumnDefinition Width="1.08*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="14,0,34,0">
          <Border Width="96" Height="96" CornerRadius="22"
                  Background="#0B2E6B"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,24">
            <Image Source="{StaticResource MemoryLaneBrandIcon}" Width="80" Height="80"/>
          </Border>

          <TextBlock Text="Welcome to Memory Lane"
                     FontSize="36"
                     FontWeight="SemiBold"
                     Foreground="#10203B"
                     TextWrapping="Wrap"/>

          <TextBlock Text="Retrace your digital day without trying to remember exactly where you saw something."
                     Margin="0,14,0,0"
                     FontSize="18"
                     LineHeight="27"
                     Foreground="#425A74"
                     TextWrapping="Wrap"/>

          <TextBlock Text="Memory Lane creates a private, searchable history of the apps and windows you use—so the context you need is easy to find later."
                     Margin="0,14,0,0"
                     FontSize="15"
                     LineHeight="23"
                     Foreground="#60748C"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1"
                Background="#F8FBFE"
                BorderBrush="#BFD0E2"
                BorderThickness="1"
                CornerRadius="22"
                Padding="22"
                Margin="8,24,6,24">
          <StackPanel>
            <Grid Margin="0,0,0,18">
              <TextBlock Text="A day at a glance"
                         FontSize="19"
                         FontWeight="SemiBold"
                         Foreground="#10203B"/>
              <Border HorizontalAlignment="Right"
                      Background="#DCEBFA"
                      CornerRadius="8"
                      Padding="9,5">
                <TextBlock Text="TODAY" FontSize="10" FontWeight="SemiBold" Foreground="#315E90"/>
              </Border>
            </Grid>

            <Border Background="#EEF4FA" CornerRadius="14" Padding="14" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#1173C8">
                  <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="17"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                  <TextBlock Text="Browser" FontWeight="SemiBold" Foreground="#10203B"/>
                  <TextBlock Text="Project roadmap · Q4 priorities" Margin="0,3,0,0"
                             Foreground="#60748C" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="9:14 AM" Foreground="#7D8FA4"
                           VerticalAlignment="Center" FontSize="11"/>
              </Grid>
            </Border>

            <Border Background="#EEF4FA" CornerRadius="14" Padding="14" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#1768C4">
                  <TextBlock Text="E" Foreground="White" FontWeight="Bold" FontSize="17"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                  <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#10203B"/>
                  <TextBlock Text="RE: Launch checklist and next steps" Margin="0,3,0,0"
                             Foreground="#60748C" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="10:27 AM" Foreground="#7D8FA4"
                           VerticalAlignment="Center" FontSize="11"/>
              </Grid>
            </Border>

            <Border Background="#EEF4FA" CornerRadius="14" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#5B55C8">
                  <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="17"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                  <TextBlock Text="Team Chat" FontWeight="SemiBold" Foreground="#10203B"/>
                  <TextBlock Text="Design review · Product team" Margin="0,3,0,0"
                             Foreground="#60748C" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="11:03 AM" Foreground="#7D8FA4"
                           VerticalAlignment="Center" FontSize="11"/>
              </Grid>
            </Border>

            <Border Background="#E7F2FD" CornerRadius="12" Padding="12" Margin="0,14,0,0">
              <TextBlock Text="Memory Lane keeps the context—not just the app name."
                         Foreground="#315E90"
                         FontSize="12"
                         TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PAGE 2 -->
      <Grid x:Name="Page2" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.9*"/>
          <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="16,0,34,0">
          <TextBlock Text="Remember what you were doing"
                     FontSize="34" FontWeight="SemiBold"
                     Foreground="#10203B"
                     TextWrapping="Wrap"/>
          <TextBlock Text="When your focused window changes, Memory Lane records the application, window title, and time so you can reconstruct what you were working on."
                     Margin="0,16,0,0"
                     FontSize="16"
                     LineHeight="24"
                     Foreground="#53677E"
                     TextWrapping="Wrap"/>

          <Border Background="#DCE8F4" CornerRadius="14" Padding="15" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="Captured automatically" FontWeight="SemiBold" Foreground="#20334E"/>
              <TextBlock Text="App · window title · timestamp · activity type"
                         Margin="0,7,0,0"
                         Foreground="#53677E"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Column="1"
                Background="#F8FBFE"
                BorderBrush="#BFD0E2"
                BorderThickness="1"
                CornerRadius="22"
                Padding="20"
                Margin="8,28,6,28">
          <StackPanel>
            <TextBlock Text="Activity in context"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#10203B"
                       Margin="0,0,0,14"/>

            <Border Background="#EEF4FA" CornerRadius="14" Padding="14" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#1173C8">
                  <TextBlock Text="B" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Browser" FontWeight="SemiBold" Foreground="#10203B"/>
                  <TextBlock Text="Product documentation · Deployment guide"
                             Margin="0,3,0,0" Foreground="#53677E"/>
                  <TextBlock Text="9:14 AM · App activity"
                             Margin="0,4,0,0" Foreground="#8494A6" FontSize="11"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="#EEF4FA" CornerRadius="14" Padding="14" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#1768C4">
                  <TextBlock Text="E" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#10203B"/>
                  <TextBlock Text="RE: Vendor onboarding timeline"
                             Margin="0,3,0,0" Foreground="#53677E"/>
                  <TextBlock Text="10:27 AM · App activity"
                             Margin="0,4,0,0" Foreground="#8494A6" FontSize="11"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="#EEF4FA" CornerRadius="14" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#5B55C8">
                  <TextBlock Text="T" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Team Chat" FontWeight="SemiBold" Foreground="#10203B"/>
                  <TextBlock Text="Project planning · Weekly sync"
                             Margin="0,3,0,0" Foreground="#53677E"/>
                  <TextBlock Text="11:03 AM · App activity"
                             Margin="0,4,0,0" Foreground="#8494A6" FontSize="11"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PAGE 3 -->
      <Grid x:Name="Page3" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.88*"/>
          <ColumnDefinition Width="1.12*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="16,0,34,0">
          <TextBlock Text="Find it again in seconds"
                     FontSize="34" FontWeight="SemiBold"
                     Foreground="#10203B"/>
          <TextBlock Text="Search using whatever you remember: an app, a phrase from the title, copied text, or a note you saved manually."
                     Margin="0,16,0,0"
                     FontSize="16"
                     LineHeight="24"
                     Foreground="#53677E"
                     TextWrapping="Wrap"/>
          <Border Background="#DCE8F4" CornerRadius="14" Padding="15" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="Search across" FontWeight="SemiBold" Foreground="#20334E"/>
              <TextBlock Text="Apps · titles · notes · clipboard · links"
                         Margin="0,7,0,0" Foreground="#53677E"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Column="1"
                Background="#F8FBFE"
                BorderBrush="#BFD0E2"
                BorderThickness="1"
                CornerRadius="22"
                Padding="20"
                Margin="8,28,6,28">
          <StackPanel>
            <Border Background="#FFFFFF" BorderBrush="#BFD0E2" BorderThickness="1"
                    CornerRadius="10" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⌕" FontSize="21" Foreground="#0A84FF"/>
                <TextBlock Grid.Column="1" Text="launch checklist"
                           Margin="10,0,0,0"
                           FontSize="15"
                           Foreground="#10203B"/>
              </Grid>
            </Border>

            <TextBlock Text="2 matching memories"
                       Margin="0,18,0,10"
                       Foreground="#7A8CA0"
                       FontSize="12"/>

            <Border Background="#EEF4FA" CornerRadius="13" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Email · 10:27 AM" Foreground="#1768C4" FontWeight="SemiBold"/>
                <TextBlock Text="RE: Launch checklist and next steps"
                           Margin="0,5,0,0"
                           Foreground="#10203B"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Open the email again from the detail view when a source link is available."
                           Margin="0,5,0,0"
                           Foreground="#60748C"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Border Background="#EEF4FA" CornerRadius="13" Padding="14">
              <StackPanel>
                <TextBlock Text="Saved Memory · Yesterday" Foreground="#1768C4" FontWeight="SemiBold"/>
                <TextBlock Text="Follow up on launch checklist"
                           Margin="0,5,0,0"
                           Foreground="#10203B"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Manual notes appear alongside captured activity."
                           Margin="0,5,0,0"
                           Foreground="#60748C"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- PAGE 4 -->
      <Grid x:Name="Page4" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.9*"/>
          <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="16,0,34,0">
          <Border Width="96" Height="96" CornerRadius="22"
                  Background="#0B2E6B"
                  HorizontalAlignment="Left">
            <Image Source="{StaticResource MemoryLaneBrandIcon}" Width="80" Height="80"/>
          </Border>
          <TextBlock Text="Private by design"
                     Margin="0,24,0,0"
                     FontSize="34"
                     FontWeight="SemiBold"
                     Foreground="#10203B"/>
          <TextBlock Text="Your timeline stays on this PC. You decide what gets captured, what gets excluded, and when capture is paused."
                     Margin="0,16,0,0"
                     FontSize="16"
                     LineHeight="24"
                     Foreground="#53677E"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1"
                Background="#F8FBFE"
                BorderBrush="#BFD0E2"
                BorderThickness="1"
                CornerRadius="22"
                Padding="20"
                Margin="8,28,6,28">
          <StackPanel>
            <TextBlock Text="Your privacy controls"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#10203B"
                       Margin="0,0,0,14"/>

            <Border Background="#EEF7F2" CornerRadius="13" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="✓ Local timeline" FontWeight="SemiBold" Foreground="#2E6F4E"/>
                <TextBlock Text="Activity history is stored locally on this PC."
                           Margin="0,4,0,0" Foreground="#557064"/>
              </StackPanel>
            </Border>

            <Border Background="#EEF4FA" CornerRadius="13" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="✓ Capture controls" FontWeight="SemiBold" Foreground="#315E90"/>
                <TextBlock Text="Pause capture or turn clipboard history on and off at any time."
                           Margin="0,4,0,0" Foreground="#60748C"/>
              </StackPanel>
            </Border>

            <Border Background="#EEF4FA" CornerRadius="13" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="✓ App exclusions" FontWeight="SemiBold" Foreground="#315E90"/>
                <TextBlock Text="Exclude sensitive apps so their activity is not intentionally recorded."
                           Margin="0,4,0,0" Foreground="#60748C"/>
              </StackPanel>
            </Border>

            <Border Background="#EEF4FA" CornerRadius="13" Padding="14">
              <StackPanel>
                <TextBlock Text="✓ No account required" FontWeight="SemiBold" Foreground="#315E90"/>
                <TextBlock Text="No cloud account, advertising SDK, or analytics SDK is required."
                           Margin="0,4,0,0" Foreground="#60748C"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" Margin="4,20,4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="BackButton"
              Content="Back"
              Click="Back_Click"
              Visibility="Hidden"
              HorizontalAlignment="Left"
              Padding="18,9"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#0A84FF" Margin="4"/>
        <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#BFD0E2" Margin="4"/>
        <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#BFD0E2" Margin="4"/>
        <Ellipse x:Name="Dot4" Width="8" Height="8" Fill="#BFD0E2" Margin="4"/>
      </StackPanel>

      <Button x:Name="NextButton"
              Grid.Column="2"
              Content="Next"
              Style="{StaticResource PrimaryButtonStyle}"
              Click="Next_Click"
              HorizontalAlignment="Right"
              Padding="22,10"/>
    </Grid>
  </Grid>
</Window>