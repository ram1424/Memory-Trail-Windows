<Window x:Class="MemoryLane.Windows.ClearCacheWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Trail — Clear Cache"
        Width="680" Height="455"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F7FAFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <Border CornerRadius="24"
          Background="#F8FAFF"
          BorderBrush="#C9D6E8"
          BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.20" Color="#28446B"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="72"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Border Background="#EAF2FF" BorderBrush="#D5E0F0" BorderThickness="0,0,0,1"
              CornerRadius="24,24,0,0">
        <Grid Margin="20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Width="44" Height="44" CornerRadius="12" Background="#FFFFFF"
                  BorderBrush="#D6E1EF" BorderThickness="1" VerticalAlignment="Center">
            <Image x:Name="BrandLogo" Width="40" Height="40" Stretch="Uniform"/>
          </Border>

          <TextBlock Grid.Column="1" Text="Memory Trail" FontSize="20" FontWeight="Bold"
                     Foreground="#14213A" VerticalAlignment="Center" Margin="12,0,0,0"/>

          <Border Grid.Column="2" Width="1" Height="30" Background="#C1CDDE"
                  Margin="18,0" VerticalAlignment="Center"/>

          <TextBlock Grid.Column="3" Text="Clear Cache" FontSize="17"
                     Foreground="#3E4D66" VerticalAlignment="Center"/>

          <Button Grid.Column="4" Width="38" Height="38" Background="Transparent"
                  BorderThickness="0" Click="Cancel_Click" Cursor="Hand">
            <TextBlock Text="×" FontSize="30" Foreground="#25344D"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
          </Button>
        </Grid>
      </Border>

      <!-- Content -->
      <Grid Grid.Row="1" Margin="30,24,30,26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Crisp vector cache illustration -->
        <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Ellipse Width="180" Height="42" Fill="#DDEBFF" Opacity="0.72" VerticalAlignment="Bottom" Margin="0,0,0,22"/>

          <Canvas Width="180" Height="190">
            <Border Canvas.Left="28" Canvas.Top="55" Width="112" Height="42"
                    CornerRadius="22" Background="#87B6FF" BorderBrush="#DCEBFF" BorderThickness="2"/>
            <Border Canvas.Left="28" Canvas.Top="91" Width="112" Height="42"
                    CornerRadius="22" Background="#65A4FA" BorderBrush="#DCEBFF" BorderThickness="2"/>
            <Border Canvas.Left="28" Canvas.Top="127" Width="112" Height="42"
                    CornerRadius="22" Background="#4C91F1" BorderBrush="#DCEBFF" BorderThickness="2"/>

            <Path Data="M132,112 L153,76 L164,82 L143,119 Z"
                  Fill="#2673E8" Stroke="#1756B8" StrokeThickness="1.5"/>
            <Path Data="M128,111 L146,120 L135,153 C130,162 117,168 100,165 C112,153 119,139 128,111 Z"
                  Fill="#FFC83D" Stroke="#E7A91E" StrokeThickness="1.5"/>

            <TextBlock Canvas.Left="142" Canvas.Top="30" Text="✦" FontSize="27"
                       Foreground="#2498F4" FontWeight="Bold"/>
            <TextBlock Canvas.Left="118" Canvas.Top="18" Text="✦" FontSize="18"
                       Foreground="#61BDFD" FontWeight="Bold"/>
          </Canvas>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="Clear Cache?" FontSize="30" FontWeight="Bold"
                     Foreground="#0E1930"/>

          <TextBlock Margin="0,9,0,0"
                     Text="This clears temporary Memory Trail cache and resets local app preferences to their defaults, helping keep the app running smoothly."
                     TextWrapping="Wrap" FontSize="14.5" LineHeight="21"
                     Foreground="#31445F"/>

          <Border Margin="0,18,0,0" Background="#E7F1FF" BorderBrush="#C9DDF7"
                  BorderThickness="1" CornerRadius="14" Padding="13,11">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                         Foreground="#176DFF" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1"
                         Text="Your activity timeline and captured history will not be deleted."
                         FontSize="12.5" FontWeight="SemiBold" Foreground="#28405F"
                         TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Width="112" Height="42"
                    Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button Width="150" Height="42"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Clear_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="✦" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="Clear Cache" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
