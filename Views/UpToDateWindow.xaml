<Window x:Class="MemoryLane.Windows.UpToDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Trail — Check for Updates"
        Width="760" Height="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AllowsTransparency="False"
        Background="#F5F8FE"
        FontFamily="Segoe UI Variable Text">
  <Border CornerRadius="24" BorderBrush="#C9D7EA" BorderThickness="1"
          Background="#F5F8FE" ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.24" Color="#203A66"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="72"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Border Background="#EAF2FF" BorderBrush="#D5E1F2" BorderThickness="0,0,0,1">
        <Grid Margin="20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Width="42" Height="42" CornerRadius="12" Background="#FFFFFF"
                  BorderBrush="#D8E2EE" BorderThickness="1" VerticalAlignment="Center">
            <Image x:Name="HeaderLogo" Width="38" Height="38" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Grid.Column="1" Text="Memory Trail" FontSize="20" FontWeight="Bold"
                     Foreground="#172238" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <Border Grid.Column="2" Width="1" Height="30" Background="#BFCDE0"
                  Margin="18,0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="Check for Updates" FontSize="17"
                     Foreground="#40506A" VerticalAlignment="Center"/>
          <Button Grid.Column="4" Width="38" Height="38" Background="Transparent"
                  BorderThickness="0" Click="Close_Click" Cursor="Hand">
            <TextBlock Text="×" FontSize="30" Foreground="#26354D"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
          </Button>
        </Grid>
      </Border>

      <!-- Scenic content -->
      <Grid Grid.Row="1">
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#9EC7FF" Offset="0"/>
            <GradientStop Color="#D8E7FF" Offset="0.42"/>
            <GradientStop Color="#FFE2C2" Offset="0.68"/>
            <GradientStop Color="#EEF5FC" Offset="1"/>
          </LinearGradientBrush>
        </Grid.Background>

        <!-- Soft clouds -->
        <Canvas IsHitTestVisible="False" Opacity="0.52">
          <Ellipse Width="180" Height="58" Fill="#FFFFFF" Canvas.Left="-30" Canvas.Top="190"/>
          <Ellipse Width="128" Height="52" Fill="#FFFFFF" Canvas.Left="55" Canvas.Top="174"/>
          <Ellipse Width="150" Height="50" Fill="#FFF7F3" Canvas.Left="602" Canvas.Top="205"/>
          <Ellipse Width="110" Height="42" Fill="#FFFFFF" Canvas.Left="655" Canvas.Top="188"/>
        </Canvas>

        <!-- Mountain silhouettes and trail -->
        <Canvas VerticalAlignment="Bottom" Height="245" IsHitTestVisible="False">
          <Path Fill="#7FA2D3" Opacity="0.58"
                Data="M0,156 L90,95 L160,137 L245,72 L330,132 L430,88 L520,145 L620,75 L760,155 L760,245 L0,245 Z"/>
          <Path Fill="#597FB4" Opacity="0.68"
                Data="M0,185 L90,135 L165,173 L255,115 L345,168 L455,122 L555,175 L650,128 L760,180 L760,245 L0,245 Z"/>
          <Path Fill="#315E82" Opacity="0.88"
                Data="M0,218 L80,175 L150,205 L235,164 L330,210 L420,170 L510,210 L610,168 L760,213 L760,245 L0,245 Z"/>
          <Path Stroke="#FFE8A2" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M390,245 C445,220 490,218 527,201 C565,183 555,164 602,153 C640,144 675,144 712,128"/>
          <Ellipse Width="64" Height="64" Fill="#FFFDF3" Canvas.Left="498" Canvas.Top="96" Opacity="0.92"/>
        </Canvas>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0">
          <Border Width="78" Height="78" CornerRadius="39" Background="#55D421"
                  BorderBrush="#D6FFCA" BorderThickness="2">
            <Border.Effect>
              <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.45" Color="#6CE53A"/>
            </Border.Effect>
            <TextBlock Text="✓" FontSize="46" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/>
          </Border>

          <TextBlock Text="You’re All Caught Up!" FontSize="31" FontWeight="Bold"
                     Foreground="#0F1930" Margin="0,16,0,0" HorizontalAlignment="Center"/>
          <TextBlock Text="You’re running the latest version of Memory Trail."
                     FontSize="15.5" Foreground="#40506A" Margin="0,6,0,18"
                     HorizontalAlignment="Center"/>

          <Border Width="430" Background="#EFFFFFFF" BorderBrush="#FFFFFF"
                  BorderThickness="1.5" CornerRadius="18" Padding="18,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="48" CornerRadius="13" Background="#FFFFFF">
                <Image x:Name="CardLogo" Width="44" Height="44" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
              <Border Grid.Column="1" Background="#CBD5E4" Margin="0,5"/>
              <StackPanel Grid.Column="2" Margin="18,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="Memory Trail" FontSize="17" FontWeight="Bold" Foreground="#172238"/>
                <TextBlock x:Name="VersionText" Text="Version 1.0.1" FontSize="13.5"
                           Foreground="#40506A" Margin="0,2,0,0"/>
              </StackPanel>
              <Border Grid.Column="3" Background="#DFF8CD" CornerRadius="16"
                      Padding="14,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="✓" Foreground="#128128" FontSize="15" FontWeight="Bold"
                             Margin="0,0,6,0"/>
                  <TextBlock Text="Up to Date" Foreground="#176C24" FontSize="12.5"
                             FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,0">
            <TextBlock Text="✦" Foreground="#176DFF" FontSize="22" FontWeight="Bold"
                       Margin="0,0,9,0" VerticalAlignment="Top"/>
            <TextBlock Text="Everything is current and running smoothly.&#x0a;Keep exploring your day’s trail!"
                       FontSize="13.5" Foreground="#30415F" LineHeight="19"/>
          </StackPanel>
        </StackPanel>

        <Button Content="Close" Width="180" Height="46"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,22"
                Style="{StaticResource PrimaryButtonStyle}"
                FontSize="15" FontWeight="SemiBold"
                Click="Close_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
