                  <Border Width="30" Height="30" CornerRadius="8" Background="#EEF0FF"><Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Rectangle Width="18" Height="17" Canvas.Left="3" Canvas.Top="4" RadiusX="2" RadiusY="2" Stroke="#5B62F6" StrokeThickness="2"/><Path Data="M3,9 L21,9 M8,2.5 L8,6 M16,2.5 L16,6" Stroke="#5B62F6" StrokeThickness="2"/></Canvas></Viewbox></Border>
                  <TextBlock Grid.Column="1" Text="Show my activity from this week" FontSize="12.5" FontWeight="SemiBold" Foreground="#101827" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Tag="Find files I worked on recently" Click="AskSuggestion_Click" Margin="0,0,0,8" Padding="12,10" HorizontalContentAlignment="Stretch">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="30" Height="30" CornerRadius="8" Background="#FFF4DD"><Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Fill="#D69800" Data="M2,6 C2,4.9 2.9,4 4,4 H9 L11,6 H20 C21.1,6 22,6.9 22,8 V18 C22,19.1 21.1,20 20,20 H4 C2.9,20 2,19.1 2,18 Z"/></Viewbox></Border>
                  <TextBlock Grid.Column="1" Text="Find files I worked on recently" FontSize="12.5" FontWeight="SemiBold" Foreground="#101827" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Tag="What emails did I view recently?" Click="AskSuggestion_Click" Margin="0,0,8,0" Padding="12,10" HorizontalContentAlignment="Stretch">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="30" Height="30" CornerRadius="8" Background="#E8F7FB"><Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Rectangle Width="20" Height="14" Canvas.Left="2" Canvas.Top="5" RadiusX="2" RadiusY="2" Stroke="#0C88A8" StrokeThickness="2"/><Path Data="M3,7 L12,13 L21,7" Stroke="#0C88A8" StrokeThickness="2" Fill="Transparent"/></Canvas></Viewbox></Border>
                  <TextBlock Grid.Column="1" Text="What emails did I view recently?" FontSize="12.5" FontWeight="SemiBold" Foreground="#101827" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Tag="What conversations did I have today?" Click="AskSuggestion_Click" Margin="0,0,8,0" Padding="12,10" HorizontalContentAlignment="Stretch">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="30" Height="30" CornerRadius="8" Background="#F0ECFF"><Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Fill="#7157C8" Data="M4,4 H20 C21.1,4 22,4.9 22,6 V15 C22,16.1 21.1,17 20,17 H10 L5,21 V17 H4 C2.9,17 2,16.1 2,15 V6 C2,4.9 2.9,4 4,4 Z"/></Viewbox></Border>
                  <TextBlock Grid.Column="1" Text="What conversations did I have today?" FontSize="12.5" FontWeight="SemiBold" Foreground="#101827" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Tag="What websites did I visit?" Click="AskSuggestion_Click" Padding="12,10" HorizontalContentAlignment="Stretch">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="30" Height="30" CornerRadius="8" Background="#EAF7EE"><Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Ellipse Width="20" Height="20" Canvas.Left="2" Canvas.Top="2" Stroke="#27824F" StrokeThickness="2"/><Ellipse Width="10" Height="20" Canvas.Left="7" Canvas.Top="2" Stroke="#27824F" StrokeThickness="1.6"/><Path Data="M2,12 L22,12" Stroke="#27824F" StrokeThickness="1.6"/></Canvas></Viewbox></Border>
                  <TextBlock Grid.Column="1" Text="What websites did I visit?" FontSize="12.5" FontWeight="SemiBold" Foreground="#101827" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Grid Grid.Row="2">
          <Grid x:Name="AskEmptyState">
            <UniformGrid Columns="3">
              <Border Background="#F6F9FD" BorderBrush="#C9D6E4" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,10,0">
                <StackPanel><Viewbox Width="20" Height="20" Margin="0,0,0,12" HorizontalAlignment="Left"><Canvas Width="24" Height="24"><Ellipse Width="11" Height="11" Canvas.Left="3.5" Canvas.Top="4.5" Stroke="#126FE8" StrokeThickness="2.2"/><Path Data="M12.3,13.3 L20,21" Stroke="#126FE8" StrokeThickness="2.2"/></Canvas></Viewbox><TextBlock Text="Search your day" FontSize="15" FontWeight="Bold"/><TextBlock Text="Find activity by time, app, page, file, email, conversation, or words you remember." FontSize="12" Foreground="#405169" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
              </Border>
              <Border Background="#F6F9FD" BorderBrush="#C9D6E4" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,10,0">
                <StackPanel><Viewbox Width="20" Height="20" Margin="0,0,0,12" HorizontalAlignment="Left"><Canvas Width="24" Height="24"><Path Data="M12,3 L20,6 V11 C20,16 16.6,20 12,21 C7.4,20 4,16 4,11 V6 Z" Fill="#DDF4F8" Stroke="#0C88A8" StrokeThickness="2"/><Path Data="M8,12 L11,15 L16,9" Stroke="#0C88A8" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock Text="Local by design" FontSize="15" FontWeight="Bold"/><TextBlock Text="Search runs against the timeline stored on this PC. Your captured history is not sent to a cloud search service." FontSize="12" Foreground="#405169" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
              </Border>
              <Border Background="#F6F9FD" BorderBrush="#C9D6E4" BorderThickness="1" CornerRadius="18" Padding="18">
                <StackPanel><Viewbox Width="20" Height="20" Margin="0,0,0,12" HorizontalAlignment="Left"><Canvas Width="24" Height="24"><Path Data="M5,19 L19,5 M11,5 H19 V13" Stroke="#B77900" StrokeThickness="2.2" Fill="Transparent"/><Rectangle Width="14" Height="14" Canvas.Left="3" Canvas.Top="7" RadiusX="2" RadiusY="2" Stroke="#B77900" StrokeThickness="1.8"/></Canvas></Viewbox><TextBlock Text="Open the trail" FontSize="15" FontWeight="Bold"/><TextBlock Text="Review matching activity and inspect the exact captured context without an artificial result cap." FontSize="12" Foreground="#405169" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
              </Border>
            </UniformGrid>
          </Grid>

          <Grid x:Name="AskResultsState" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Background="#FFFFFF" BorderBrush="#C5D2E0" BorderThickness="1" CornerRadius="14" Padding="13">
                <TextBlock x:Name="AskAnswerText" TextWrapping="Wrap" FontSize="13.5" FontWeight="SemiBold" Foreground="#101827"/>
              </Border>
              <Button Grid.Column="1" Click="AskBackToTop_Click" Padding="10,7" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="Back to Top" FontSize="12" FontWeight="SemiBold"/></StackPanel>
              </Button>
            </Grid>
            <ListView x:Name="AskResultsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderThickness" Value="0"/>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Border Height="66" Background="#FFFFFF" BorderBrush="#D1DBE7" BorderThickness="1"
                          CornerRadius="11" Padding="10" Margin="0,0,0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                              Background="#F6F9FC" BorderBrush="#D7E1EB" BorderThickness="1"
                              VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Image Source="{Binding Converter={StaticResource AppIconConverter}}"
                               Width="26" Height="26" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"/>
                      </Border>

                      <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceApp}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#101827" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#405169"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/>
                      </StackPanel>

                      <TextBlock Grid.Column="2"
                                 Text="{Binding CreatedAt, StringFormat={}{0:MMM d · h:mm tt}}"
                                 FontSize="11.5" Foreground="#46566B"
                                 VerticalAlignment="Center" HorizontalAlignment="Right"
                                 TextAlignment="Right" TextWrapping="NoWrap"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Grid>
      </Grid>

      <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="22">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch">
          <Grid Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
              <Border Width="44" Height="44" CornerRadius="13" Background="#F2F4F8" BorderBrush="#E0E5EC" BorderThickness="1" Margin="0,0,12,0">
                <Viewbox Width="23" Height="23"><Canvas Width="24" Height="24">
                  <Path Data="M5,6 H19 M5,12 H19 M5,18 H19" Stroke="#65758B" StrokeThickness="2" StrokeStartLineCap="Round"/>
                  <Ellipse Width="4" Height="4" Canvas.Left="7" Canvas.Top="4" Fill="#F2F4F8" Stroke="#65758B" StrokeThickness="1.8"/>
                  <Ellipse Width="4" Height="4" Canvas.Left="13" Canvas.Top="10" Fill="#F2F4F8" Stroke="#65758B" StrokeThickness="1.8"/>
                  <Ellipse Width="4" Height="4" Canvas.Left="9" Canvas.Top="16" Fill="#F2F4F8" Stroke="#65758B" StrokeThickness="1.8"/>
                </Canvas></Viewbox>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#0D1422"/>
                <TextBlock Text="Privacy, capture, storage, startup, and update controls." FontSize="12" Foreground="#45566E"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Privacy card: intentionally mirrors the clean macOS Settings presentation. -->
          <Border Background="#F2F6FB" BorderBrush="#CBD7E4" BorderThickness="1" CornerRadius="24" Padding="22" Margin="0,0,0,16">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="28" Height="28" CornerRadius="8" Background="#E7EEF7" Margin="0,0,9,0">
                  <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#25344A"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Privacy" FontSize="13" FontWeight="SemiBold" Foreground="#121A2B" VerticalAlignment="Center"/>
              </StackPanel>

              <TextBlock Text="Privacy-first by design" FontSize="18" FontWeight="Bold" Foreground="#121A2B"/>
              <TextBlock Text="Memory Trail is a private, locally run Windows app. Its captured activity history is processed and stored on this computer."
                         FontSize="12.5" Foreground="#44566F" TextWrapping="Wrap" Margin="0,5,0,15"/>

              <Border Height="1" Background="#D5DEE8" Margin="0,0,0,14"/>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="#E0EDFF" VerticalAlignment="Top">
                  <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#176DFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Sourced and stored locally" FontSize="12.5" FontWeight="SemiBold" Foreground="#121A2B"/>
                  <TextBlock Text="Timeline data comes from local Windows app/window context, local files and paths, and the clipboard when enabled. Captured history is stored locally on this PC."
                             FontSize="11.5" Foreground="#44566F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="#E5EEFF" VerticalAlignment="Top">
                  <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#176DFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="No captured-data transmission" FontSize="12.5" FontWeight="SemiBold" Foreground="#121A2B"/>
                  <TextBlock Text="Memory Trail does not upload, sync, or send your captured timeline data outside of this computer."
                             FontSize="11.5" Foreground="#44566F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="#E3EFFF" VerticalAlignment="Top">
                  <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#176DFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="No external data connectors" FontSize="12.5" FontWeight="SemiBold" Foreground="#121A2B"/>
                  <TextBlock Text="Memory Trail does not use cloud sync, analytics services, or a remote account for its capture and storage workflow. Optional update checks retrieve release metadata only."
                             FontSize="11.5" Foreground="#44566F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="#E4EEFF" VerticalAlignment="Top">
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#176DFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Verifiable source code" FontSize="12.5" FontWeight="SemiBold" Foreground="#121A2B"/>
                  <TextBlock Text="The source code is available for review so you can verify how Memory Trail captures, processes, and stores data."
                             FontSize="11.5" Foreground="#44566F" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>

              <WrapPanel Margin="0,0,0,14">
                <Button Click="OpenPrivacyPolicy_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="View Privacy Policy" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Click="OpenGitHub_Click" HorizontalAlignment="Left" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Review Source Code" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </WrapPanel>

              <Border Height="1" Background="#D5DEE8" Margin="0,0,0,14"/>

              <Button Click="ClearCache_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Clear App Cache" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock Text="Resets cached capture state and Memory Trail preferences without deleting your activity history."
                         FontSize="11" Foreground="#44566F" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Functional controls retained, but visually simplified to match the reference. -->
          <Border Background="#F2F6FB" BorderBrush="#CBD7E4" BorderThickness="1" CornerRadius="24" Padding="22" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Controls" FontSize="16" FontWeight="Bold" Foreground="#121A2B" Margin="0,0,0,14"/>

              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Capture" FontSize="12.5" FontWeight="SemiBold" Foreground="#121A2B" Margin="0,0,0,9"/>
                  <CheckBox x:Name="PauseCaptureCheckBox" Content="Pause all capture" Margin="0,0,0,9" Checked="SettingChanged" Unchecked="SettingChanged"/>
                  <CheckBox x:Name="AppCaptureCheckBox" Content="Remember app switches and focused windows" Margin="0,0,0,9" Checked="SettingChanged" Unchecked="SettingChanged"/>
                  <CheckBox x:Name="ClipboardCaptureCheckBox" Content="Remember copied text" Checked="SettingChanged" Unchecked="SettingChanged"/>
                  <TextBlock Text="Copied text stays in the local timeline when clipboard capture is enabled."
                             Foreground="#44566F" FontSize="10.8" TextWrapping="Wrap" Margin="22,7,0,0"/>

                  <TextBlock Text="Privacy exclusions" FontSize="12.5" FontWeight="SemiBold" Foreground="#121A2B" Margin="0,18,0,7"/>
                  <TextBlock Text="One Windows process name per line." Foreground="#44566F" FontSize="10.8" Margin="0,0,0,7"/>
                  <StackPanel>
                    <TextBox x:Name="ExclusionsBox" AcceptsReturn="True" MinHeight="90"/>
                    <Button Content="Apply exclusions" Margin="0,9,0,0" HorizontalAlignment="Left" Click="ApplyExclusions_Click"/>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Windows" FontSize="12.5" FontWeight="SemiBold" Foreground="#121A2B" Margin="0,0,0,9"/>
                  <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Memory Trail when I sign in to Windows"
                            IsEnabled="True" IsHitTestVisible="True" Opacity="1"
                            Checked="StartWithWindowsChanged" Unchecked="StartWithWindowsChanged"/>

                  <Border Height="1" Background="#D5DEE8" Margin="0,17,0,15"/>

                  <TextBlock Text="Updates" FontSize="12.5" FontWeight="SemiBold" Foreground="#121A2B" Margin="0,0,0,9"/>
                  <CheckBox x:Name="AutomaticUpdateCheckBox" Content="Check for updates on each launch"
                            Checked="AutomaticUpdatesChanged" Unchecked="AutomaticUpdatesChanged" Margin="0,0,0,9"/>
                  <WrapPanel>
                    <Button Content="Check for Updates" Click="CheckForUpdates_Click" Margin="0,0,8,8"/>
                    <Button Content="Replay Tutorial" Click="ShowTutorial_Click" Margin="0,0,8,8"/>
                    <Button Content="What's New" Click="ShowWhatsNew_Click" Margin="0,0,8,8"/>
                  </WrapPanel>
                  <TextBlock x:Name="UpdateStatusText" Text="Updates have not been checked yet."
                             Foreground="#44566F" FontSize="10.8" TextWrapping="Wrap" Margin="0,2,0,0"/>

                  <Border Height="1" Background="#D5DEE8" Margin="0,17,0,15"/>

                  <TextBlock Text="History &amp; data" FontSize="12.5" FontWeight="SemiBold" Foreground="#121A2B" Margin="0,0,0,5"/>
                  <TextBlock Text="Manage your local timeline in the Data &amp; History section below."
                             FontSize="10.8" Foreground="#44566F" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="#F2F6FB" BorderBrush="#CBD7E4" BorderThickness="1"
                  CornerRadius="24" Padding="22" Margin="0,0,0,16">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                <Border Width="30" Height="30" CornerRadius="9" Background="#E4EEFF" Margin="0,0,9,0">
                  <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#176DFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Data &amp; History" FontSize="15.5" FontWeight="Bold" Foreground="#121A2B"/>
                  <TextBlock Text="Your trail lives here. You decide when it travels or disappears."
                             FontSize="12" Foreground="#44566F"/>
                </StackPanel>
              </StackPanel>

              <TextBlock Text="Capture data location" FontSize="11.5" FontWeight="SemiBold" Foreground="#121A2B"/>
              <Border Background="#E9EFF6" BorderBrush="#D4DDE8" BorderThickness="1"
                      CornerRadius="11" Padding="11,9" Margin="0,6,0,9">
                <TextBlock x:Name="StoragePathText" Text="%LOCALAPPDATA%\Memory Trail"
                           FontFamily="Consolas" FontSize="12" Foreground="#31445F" TextWrapping="Wrap"/>
              </Border>
              <WrapPanel Margin="0,0,0,14">
                <Button Content="Open Data Folder" Click="OpenDataFolder_Click" Margin="0,0,8,8"/>
                <Button Content="Export Activity (.json)" Click="ExportActivity_Click" Margin="0,0,8,8"/>
              </WrapPanel>

              <Border Height="1" Background="#D5DEE8" Margin="0,0,0,14"/>
              <TextBlock Text="Clear history" FontSize="11.5" FontWeight="SemiBold" Foreground="#121A2B"/>
              <TextBlock Text="Choose how much of the trail to sweep away. You will see exactly what is being removed before anything is deleted."
                         FontSize="12" Foreground="#44566F" TextWrapping="Wrap" Margin="0,3,0,10"/>

              <UniformGrid Columns="3">
                <Button Click="ClearLastWeek_Click" Margin="0,0,8,0" Padding="13,12" HorizontalContentAlignment="Stretch">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="10" Background="#E2EEFF">
                      <TextBlock Text="7" FontSize="12" FontWeight="Bold" Foreground="#176DFF"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                      <TextBlock Text="Last week" FontSize="11.5" FontWeight="SemiBold"/>
                      <TextBlock Text="Sweep 7 days" FontSize="11.5" Foreground="#44566F"/>
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Click="ClearLastMonth_Click" Margin="0,0,8,0" Padding="13,12" HorizontalContentAlignment="Stretch">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="10" Background="#F2E8FF">
                      <TextBlock Text="30" FontSize="11" FontWeight="Bold" Foreground="#8057C7"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                      <TextBlock Text="Last month" FontSize="11.5" FontWeight="SemiBold"/>
                      <TextBlock Text="Sweep 30 days" FontSize="11.5" Foreground="#44566F"/>
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Click="ClearAllHistory_Click" Padding="13,12" HorizontalContentAlignment="Stretch">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="10" Background="#FFE7E5">
                      <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#D45555"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                      <TextBlock Text="All history" FontSize="11.5" FontWeight="SemiBold"/>
                      <TextBlock Text="The big broom" FontSize="11.5" Foreground="#44566F"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </UniformGrid>
            </StackPanel>
          </Border>

          <!-- About block intentionally sits directly on the Settings background like the reference. -->
          <StackPanel Margin="4,2,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
              <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#44566F"
                         Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBlock Text="About Memory Trail" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F"/>
            </StackPanel>
            <TextBlock x:Name="AboutVersionText" Text="Version 1" FontSize="11.5" Foreground="#52647D" Margin="0,0,0,3"/>
            <TextBlock Text="Created By: Roman Zakharov" FontSize="11.5" Foreground="#52647D" Margin="0,0,0,3"/>
            <TextBlock Text="Source code, privacy details, documentation, and the latest release are available on GitHub."
                       FontSize="11" Foreground="#44566F" TextWrapping="Wrap"/>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>