<Window x:Class="MemoryLane.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MemoryLane.Windows"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Memory Trail Version 1"
        Width="1560" Height="860"
        MinWidth="1240" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Arial Rounded MT Bold, Arial Rounded MT, Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#DCE6F2">
  <Window.Resources>
    <local:AppIconConverter x:Key="AppIconConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <Style x:Key="MetricCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C4D1E0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="11"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="MinHeight" Value="72"/>
    </Style>

    <Style x:Key="MetricIconTileStyle" TargetType="Border">
      <Setter Property="Width" Value="31"/>
      <Setter Property="Height" Value="31"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
    </Style>

    <Style x:Key="SummaryMetricValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#121A2B"/>
    </Style>

    <Style x:Key="SummaryMetricLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="Foreground" Value="#52637A"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="PrimarySidebarNavStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#0B1320"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="FilterNavStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="TimelineChipStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="PanelToggleButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D7DEE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#121A2B"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="PanelToggleChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PanelToggleChrome" Property="Background" Value="#FAFBFD"/>
                <Setter TargetName="PanelToggleChrome" Property="BorderBrush" Value="#C9D2DE"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PanelToggleChrome" Property="Background" Value="#F3F6F9"/>
                <Setter TargetName="PanelToggleChrome" Property="BorderBrush" Value="#C1CBD8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SummaryProgressStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Background" Value="#F3F7FB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
              <Border x:Name="PART_Indicator"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="5"
                      HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  
    <Style x:Key="MacCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Height" Value="41"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style x:Key="MacQuickFilterStyle" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D3DCE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#121A2B"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="QuickChrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="QuickChrome" Property="Background" Value="#F8FAFC"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- LEFT SIDEBAR: mirrors macOS MemoryTrailSidebar -->
    <Border Grid.Column="0" BorderBrush="#D0DAE7" BorderThickness="0,0,1,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#DFE7F1" Offset="0"/>
          <GradientStop Color="#C8D6E7" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid Margin="10,12,10,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,16">
          <Border Width="66" Height="66" CornerRadius="18" Background="#FFFFFF"
                  BorderBrush="#DDE6F0" BorderThickness="1" Padding="4">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.14" Color="#39506E"/>
            </Border.Effect>
            <Image x:Name="BrandLogo" Width="58" Height="58" Stretch="Uniform"
                   SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock Text="Memory Trail" FontSize="17" FontWeight="Bold" Foreground="#172238"
                     HorizontalAlignment="Center" Margin="0,8,0,0"/>
          <Border Background="#E9F7F1" BorderBrush="#D2ECDD" BorderThickness="1"
                  CornerRadius="10" Padding="7,3" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="#20C56A" Margin="0,0,5,0" VerticalAlignment="Center"/>
              <TextBlock Text="Private • Local" FontSize="11.5" FontWeight="SemiBold" Foreground="#34705A"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="TimelineNavButton" Tag="Timeline" Click="NavButton_Click"
                  Style="{StaticResource PrimarySidebarNavStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="11" Background="#EAF3FF" BorderBrush="#D5E6FF" BorderThickness="1" Margin="0,0,12,0">
                <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
                  <Rectangle Width="18" Height="17" Canvas.Left="3" Canvas.Top="4" RadiusX="3" RadiusY="3" Stroke="#2F7CF6" StrokeThickness="2"/>
                  <Path Data="M3,9 H21 M8,2.5 V6 M16,2.5 V6" Stroke="#2F7CF6" StrokeThickness="2" StrokeStartLineCap="Round"/>
                  <Ellipse Width="3.4" Height="3.4" Canvas.Left="10.3" Canvas.Top="12.3" Fill="#2F7CF6"/>
                </Canvas></Viewbox>
              </Border>
              <TextBlock Text="Today" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button x:Name="AskMemoryTrailNavButton" Tag="Ask" Click="NavButton_Click"
                  Style="{StaticResource PrimarySidebarNavStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="11" Background="#F0EDFF" BorderBrush="#DFD8FF" BorderThickness="1" Margin="0,0,12,0">
                <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
                  <Ellipse Width="10.5" Height="10.5" Canvas.Left="3" Canvas.Top="6" Stroke="#7357E8" StrokeThickness="2"/>
                  <Path Data="M11.3,14.2 L18.8,21" Stroke="#7357E8" StrokeThickness="2" StrokeStartLineCap="Round"/>
                  <Path Data="M18,2.5 L19,5 L21.5,6 L19,7 L18,9.5 L17,7 L14.5,6 L17,5 Z" Fill="#8E72F4"/>
                </Canvas></Viewbox>
              </Border>
              <TextBlock Text="Ask Memory Trail" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button x:Name="FavoritesNavButton" Tag="Favorites" Click="NavButton_Click"
                  Style="{StaticResource PrimarySidebarNavStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="11" Background="#FFF3E8" BorderBrush="#FFE0C2" BorderThickness="1" Margin="0,0,12,0">
                <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
                  <Path Data="M7,3.5 H17 C18.1,3.5 19,4.4 19,5.5 V21 L12,16.5 L5,21 V5.5 C5,4.4 5.9,3.5 7,3.5 Z" Stroke="#E58A2B" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
                  <Path Data="M12,7 L13.15,9.3 L15.7,9.65 L13.85,11.45 L14.3,14 L12,12.8 L9.7,14 L10.15,11.45 L8.3,9.65 L10.85,9.3 Z" Fill="#E58A2B"/>
                </Canvas></Viewbox>
              </Border>
              <TextBlock Text="Favorites" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button x:Name="ClipboardNavButton" Tag="Clipboard" Click="NavButton_Click"
                  Style="{StaticResource PrimarySidebarNavStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="11" Background="#EAF9F4" BorderBrush="#CFEEDF" BorderThickness="1" Margin="0,0,12,0">
                <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
                  <Rectangle Width="15" Height="16" Canvas.Left="4.5" Canvas.Top="5" RadiusX="2.8" RadiusY="2.8" Stroke="#2C9B72" StrokeThickness="2"/>
                  <Rectangle Width="8" Height="4" Canvas.Left="8" Canvas.Top="3" RadiusX="1.5" RadiusY="1.5" Fill="#EAF9F4" Stroke="#2C9B72" StrokeThickness="2"/>
                  <Path Data="M8,11 H16 M8,15 H14" Stroke="#2C9B72" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                </Canvas></Viewbox>
              </Border>
              <TextBlock Text="Clipboard History" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button x:Name="InsightsNavButton" Tag="Insights" Click="NavButton_Click"
                  Style="{StaticResource PrimarySidebarNavStyle}" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="11" Background="#EAF8FB" BorderBrush="#CFECF3" BorderThickness="1" Margin="0,0,12,0">
                <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
                  <Rectangle Width="19" Height="17" Canvas.Left="2.5" Canvas.Top="3.5" RadiusX="3" RadiusY="3" Stroke="#1596B2" StrokeThickness="1.8"/>
                  <Path Data="M5.5,16 L9.2,11.5 L12.4,13.7 L18.7,7.3" Stroke="#1596B2" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <Ellipse Width="3" Height="3" Canvas.Left="17.2" Canvas.Top="5.8" Fill="#1596B2"/>
                </Canvas></Viewbox>
              </Border>
              <TextBlock Text="Insights" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button x:Name="SettingsNavButton" Tag="Settings" Click="NavButton_Click"
                  Style="{StaticResource PrimarySidebarNavStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="11" Background="#F2F4F8" BorderBrush="#E0E5EC" BorderThickness="1" Margin="0,0,12,0">
                <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
                  <Path Data="M5,6 H19 M5,12 H19 M5,18 H19" Stroke="#65758B" StrokeThickness="2" StrokeStartLineCap="Round"/>
                  <Ellipse Width="4" Height="4" Canvas.Left="7" Canvas.Top="4" Fill="#F2F4F8" Stroke="#65758B" StrokeThickness="1.8"/>
                  <Ellipse Width="4" Height="4" Canvas.Left="13" Canvas.Top="10" Fill="#F2F4F8" Stroke="#65758B" StrokeThickness="1.8"/>
                  <Ellipse Width="4" Height="4" Canvas.Left="9" Canvas.Top="16" Fill="#F2F4F8" Stroke="#65758B" StrokeThickness="1.8"/>
                </Canvas></Viewbox>
              </Border>
              <TextBlock Text="Settings" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
          </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,8">
          <StackPanel>
            <Border Height="1" Background="#D0DAE7" Margin="6,0,6,16"/>
            <Grid Margin="8,0,8,7">
              <TextBlock Text="Filters" FontSize="12" FontWeight="SemiBold" Foreground="#44566F"/>
              <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" FontSize="11.5" Foreground="#8795A8"/>
            </Grid>

            <Button x:Name="AllAppsFilter" Tag="All" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="All" Width="32" Height="32" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="All Apps" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="AllAppsCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="BrowserFilter" Tag="Browser" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Browser" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Web Browsers" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="BrowserCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="EmailFilter" Tag="Email" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Email" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Email" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="EmailCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="ChatFilter" Tag="Chat" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Chat" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Chat &amp; Meetings" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="ChatCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="FilesFilter" Tag="Files" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Files" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Files &amp; Documents" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="FilesCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="OfficeFilter" Tag="Office" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Productivity" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Productivity" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="OfficeCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="DevelopmentFilter" Tag="Development" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Development" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Development" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="DevelopmentCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="MediaFilter" Tag="Media" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Media" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Media" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="MediaCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="DesignFilter" Tag="Design" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Design" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Design" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="DesignCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="RemoteFilter" Tag="Remote" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Remote" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Remote Access" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="RemoteCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="SystemFilter" Tag="System" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="System" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="System" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="SystemCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
            <Button x:Name="OtherFilter" Tag="Other" Click="Category_Click" Style="{StaticResource MacCategoryButtonStyle}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                <local:CategoryIcon Category="Other" Width="32" Height="32" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Other" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Border Grid.Column="2" Width="42" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#D3DCE8" BorderThickness="1" CornerRadius="13" Margin="6,0,0,0"><TextBlock x:Name="OtherCountText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#44566F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Button x:Name="PauseButton" Grid.Row="3" Click="PauseButton_Click"
                Background="#E7EEF5" BorderBrush="#C3D0DE" BorderThickness="1"
                Padding="11,9" HorizontalContentAlignment="Stretch">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,9,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="StatusText" Text="Capturing" FontSize="11" FontWeight="SemiBold" Foreground="#121A2B"/>
              <TextBlock x:Name="CaptureSubtext" Text="Your activity is stored locally" FontSize="11.5" Foreground="#44566F" Margin="0,1,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="#8795A8" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
        </Button>
      </Grid>
    </Border>

    <!-- MAIN CONTENT -->
    <Grid Grid.Column="1">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#E3EAF3" Offset="0"/>
          <GradientStop Color="#CCD9E8" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Grid x:Name="ActivityShell">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="DetailsSpacerColumn" Width="14"/>
          <ColumnDefinition x:Name="DetailsColumn" Width="330"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="18,16,16,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border Width="44" Height="44" CornerRadius="13" Background="#F7FAFE" BorderBrush="#D8E4F2" BorderThickness="1" Margin="0,0,12,0">
                <Grid>
                  <Viewbox x:Name="TodayHeaderIcon" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Rectangle Width="18" Height="17" Canvas.Left="3" Canvas.Top="4" RadiusX="3" RadiusY="3" Stroke="#2F7CF6" StrokeThickness="2"/>
                      <Path Data="M3,9 H21 M8,2.5 V6 M16,2.5 V6" Stroke="#2F7CF6" StrokeThickness="2" StrokeStartLineCap="Round"/>
                      <Ellipse Width="3.4" Height="3.4" Canvas.Left="10.3" Canvas.Top="12.3" Fill="#2F7CF6"/>
                    </Canvas>
                  </Viewbox>
                  <Viewbox x:Name="FavoritesHeaderIcon" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Canvas Width="24" Height="24">
                      <Path Data="M7,3.5 H17 C18.1,3.5 19,4.4 19,5.5 V21 L12,16.5 L5,21 V5.5 C5,4.4 5.9,3.5 7,3.5 Z" Stroke="#E58A2B" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
                      <Path Data="M12,7 L13.15,9.3 L15.7,9.65 L13.85,11.45 L14.3,14 L12,12.8 L9.7,14 L10.15,11.45 L8.3,9.65 L10.85,9.3 Z" Fill="#E58A2B"/>
                    </Canvas>
                  </Viewbox>
                  <Viewbox x:Name="ClipboardHeaderIcon" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Canvas Width="24" Height="24">
                      <Rectangle Width="15" Height="16" Canvas.Left="4.5" Canvas.Top="5" RadiusX="2.8" RadiusY="2.8" Stroke="#2C9B72" StrokeThickness="2"/>
                      <Rectangle Width="8" Height="4" Canvas.Left="8" Canvas.Top="3" RadiusX="1.5" RadiusY="1.5" Fill="#F7FAFE" Stroke="#2C9B72" StrokeThickness="2"/>
                      <Path Data="M8,11 H16 M8,15 H14" Stroke="#2C9B72" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Border>
              <StackPanel>
                <TextBlock x:Name="PageTitleText" Text="Today" FontSize="28" FontWeight="Bold" Foreground="#0D1422"/>
                <TextBlock x:Name="PageSubtitleText" Text="Your activity, files, and conversations at a glance."
                           FontSize="11.5" Foreground="#45566E" Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
              <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="16" Padding="12,7" Margin="0,0,10,0">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Ellipse x:Name="QuickCaptureDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="QuickCaptureText" Grid.Column="1" Text="Capturing" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" BaselineOffset="0"/>
                </Grid>
              </Border>
              <Border Background="#F6F9FC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="16">
                <StackPanel Orientation="Horizontal">
                  <Button Width="30" Height="34" Padding="0" BorderThickness="0" Background="Transparent" Click="PreviousDay_Click"><TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"/></Button>
                  <TextBlock x:Name="DayLabelText" Text="Today" MinWidth="112" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                  <Button x:Name="NextDayButton" Width="30" Height="34" Padding="0" BorderThickness="0" Background="Transparent" Click="NextDay_Click"><TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"/></Button>
                </StackPanel>
              </Border>
              <Button x:Name="RightSidebarToggleButton" Click="RightSidebarToggle_Click" Width="36" Height="34" Margin="9,0,0,0" Padding="0" ToolTip="Show or hide dashboard panels">
                <Grid x:Name="RightSidebarToggleIcon" Width="16" Height="14">
                  <Border BorderBrush="#27313F" BorderThickness="1.2" CornerRadius="2"/>
                  <Border Width="1.2" Background="#27313F" HorizontalAlignment="Right" Margin="0,2,5,2"/>
                </Grid>
              </Button>
              <TextBlock x:Name="PanelToggleText" Text="Hide Panels" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>

        <Grid Grid.Row="1" Grid.Column="0" Margin="18,0,0,18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <!-- Today at a glance -->
          <Border Grid.Row="0" Background="#F8FAFD" BorderBrush="#CAD7E6" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Today at a Glance" FontSize="15.5" FontWeight="Bold" Foreground="#111827"/>
              </StackPanel>
              <UniformGrid Columns="5">
                <Border Background="#E8F2FF" CornerRadius="13" Padding="12,9" Margin="0,0,8,0">
                  <StackPanel><TextBlock x:Name="TotalActivitiesText" Text="0" FontSize="20" FontWeight="Bold"/><TextBlock Text="Activities" FontSize="11.5" Foreground="#3B4A5E"/></StackPanel>
                </Border>
                <Border Background="#F0EDFF" CornerRadius="13" Padding="12,9" Margin="0,0,8,0">
                  <StackPanel><TextBlock x:Name="AppsUsedText" Text="0" FontSize="20" FontWeight="Bold"/><TextBlock Text="Apps Used" FontSize="11.5" Foreground="#3B4A5E"/></StackPanel>
                </Border>
                <Border Background="#E8F7FB" CornerRadius="13" Padding="12,9" Margin="0,0,8,0">
                  <StackPanel><TextBlock x:Name="ActiveTimeText" Text="0m" FontSize="20" FontWeight="Bold"/><TextBlock Text="Active Time" FontSize="11.5" Foreground="#3B4A5E"/></StackPanel>
                </Border>
                <Border Background="#FFF7E5" CornerRadius="13" Padding="12,9" Margin="0,0,8,0">
                  <StackPanel><TextBlock x:Name="FilesTodayText" Text="0" FontSize="20" FontWeight="Bold"/><TextBlock Text="Files &amp; Documents" FontSize="11.5" Foreground="#3B4A5E"/></StackPanel>
                </Border>
                <Border Background="#F0EDFF" CornerRadius="13" Padding="12,9">
                  <StackPanel><TextBlock x:Name="ClipboardItemsText" Text="0" FontSize="20" FontWeight="Bold"/><TextBlock Text="Clipboard Items" FontSize="11.5" Foreground="#3B4A5E"/></StackPanel>
                </Border>
              </UniformGrid>
            </StackPanel>
          </Border>

          <!-- Timeline -->
          <Border Grid.Row="1" Background="#F8FAFD" BorderBrush="#CAD7E6" BorderThickness="1" CornerRadius="18" Padding="14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Border Width="34" Height="34" CornerRadius="10" Background="#E5F0FF" Margin="0,0,9,0">
                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#1677FF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel>
                    <TextBlock Text="Today's Timeline" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="A chronological view of your activity." FontSize="11.5" Foreground="#3E5068"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="ActivityCountText" Text="0 activities" FontSize="12" Foreground="#35475E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button Click="TimelineBackToTop_Click" Padding="10,6" ToolTip="Jump to the newest activity">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/>
                      <TextBlock Text="Back to Top" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <ListView x:Name="TimelineList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.CanContentScroll="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        SelectionChanged="TimelineList_SelectionChanged"
                        MouseDoubleClick="TimelineList_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                          <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#DEE6EF" BorderThickness="1">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F8FAFC"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#E6F0FF"/><Setter TargetName="Row" Property="BorderBrush" Value="#78AEF8"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid Height="54" Margin="10,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/><ColumnDefinition Width="18"/><ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="30"/><ColumnDefinition Width="28"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}" FontSize="11" Foreground="#5A687B" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                      <Grid Grid.Column="1"><Border Width="2" Background="#76AEF7" HorizontalAlignment="Center"/><Ellipse Width="8" Height="8" Fill="#1677FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                      <Border Grid.Column="2" Width="32" Height="32" CornerRadius="9" Background="#FFFFFF" BorderBrush="#E0E7EF" BorderThickness="1" VerticalAlignment="Center">
                        <Image Source="{Binding Converter={StaticResource AppIconConverter}}" Width="25" Height="25" Stretch="Uniform"/>
                      </Border>
                      <StackPanel Grid.Column="3" Margin="8,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <Border Visibility="{Binding IsLiveActivity, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#E4F8EA" CornerRadius="9" Padding="6,2" Margin="7,0,0,0">
                            <TextBlock Text="● Live Activity" Foreground="#1F9D55" FontSize="8.5" FontWeight="SemiBold"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding TimelineSubtitle}" FontSize="12" Foreground="#3E5068" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Border x:Name="CategoryChip" Grid.Column="4" Background="#EAF2FF" CornerRadius="11" Padding="7,3" VerticalAlignment="Center">
                        <TextBlock x:Name="CategoryChipText" Text="{Binding ActivityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#3175C4"/>
                      </Border>
                      <Button Grid.Column="5" Width="28" Height="28" Padding="0" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="Favorite_Click"><TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets"/></Button>
                      <Button Grid.Column="6" Width="26" Height="28" Padding="0" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="MoreRow_Click"><TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"/></Button>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>

          <!-- Hidden compatibility controls retained for existing filtering logic. -->
          <StackPanel Visibility="Collapsed">
            <Grid x:Name="QuickFiltersBar"/>
            <Button x:Name="QuickAllFilter"/><TextBlock x:Name="QuickAllCountText"/>
            <Button x:Name="QuickBrowserFilter"/><TextBlock x:Name="QuickBrowserCountText"/>
            <Button x:Name="QuickEmailFilter"/><TextBlock x:Name="QuickEmailCountText"/>
            <Button x:Name="QuickChatFilter"/><TextBlock x:Name="QuickChatCountText"/>
            <Button x:Name="QuickFilesFilter"/><TextBlock x:Name="QuickFilesCountText"/>
            <Button x:Name="QuickOfficeFilter"/><TextBlock x:Name="QuickOfficeCountText"/>
            <Button x:Name="MoreFiltersButton"/>
            <Button x:Name="ShowDetailsButton"/>
            <Grid><Grid.RowDefinitions><RowDefinition x:Name="DetailsGapRow"/><RowDefinition x:Name="DetailsRow"/></Grid.RowDefinitions><Border x:Name="DetailsPanel"/></Grid>
          </StackPanel>
        </Grid>

        <Border x:Name="RightDivider" Grid.Row="1" Grid.Column="1" Width="1" Background="#C7D3E1" Margin="6,18,6,18"/>

        <ScrollViewer x:Name="RightSidebar" Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,0,16,18">
          <StackPanel>
            <StackPanel Visibility="Collapsed">
              <Ellipse x:Name="RightStatusDot"/><TextBlock x:Name="RightStatusText"/><TextBlock x:Name="RightDateText"/>
            </StackPanel>

            <Border Background="#F8FAFD" BorderBrush="#CAD7E6" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Width="34" Height="34" CornerRadius="10" Background="#E8F2FF" Margin="0,0,9,0">
                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#1677FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Top Apps Today" FontSize="15.5" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Most active apps in your timeline." FontSize="11.5" Foreground="#405169"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="TodayTopAppsPanel"/>
              </StackPanel>
            </Border>

            <Border Background="#F8FAFD" BorderBrush="#CAD7E6" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Key Takeaways" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="#EAF7FB" CornerRadius="11" Padding="10" Margin="0,0,0,7">
                  <StackPanel><TextBlock Text="Peak Focus" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="TodayPeakFocusText" Text="—" FontSize="11.5" Foreground="#405169" Margin="0,2,0,0"/></StackPanel>
                </Border>
                <Border Background="#EAF7FB" CornerRadius="11" Padding="10" Margin="0,0,0,7">
                  <StackPanel><TextBlock Text="Top Work Type" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="TodayTopWorkTypeText" Text="—" FontSize="11.5" Foreground="#405169" Margin="0,2,0,0"/></StackPanel>
                </Border>
                <Border Background="#FFF7E6" CornerRadius="11" Padding="10">
                  <StackPanel><TextBlock Text="App Switching" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="TodaySwitchingText" Text="—" FontSize="11.5" Foreground="#405169" Margin="0,2,0,0"/></StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Background="#F8FAFD" BorderBrush="#CAD7E6" BorderThickness="1" CornerRadius="18" Padding="14">
              <StackPanel>
                <TextBlock Text="Recent Files &amp; Documents" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel x:Name="TodayRecentFilesPanel"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <ScrollViewer x:Name="InsightsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="22">
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border Width="44" Height="44" CornerRadius="13" Background="#EAF8FB" BorderBrush="#CFECF3" BorderThickness="1" Margin="0,0,12,0">
                <Viewbox Width="23" Height="23"><Canvas Width="24" Height="24">
                  <Rectangle Width="19" Height="17" Canvas.Left="2.5" Canvas.Top="3.5" RadiusX="3" RadiusY="3" Stroke="#1596B2" StrokeThickness="1.8"/>
                  <Path Data="M5.5,16 L9.2,11.5 L12.4,13.7 L18.7,7.3" Stroke="#1596B2" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <Ellipse Width="3" Height="3" Canvas.Left="17.2" Canvas.Top="5.8" Fill="#1596B2"/>
                </Canvas></Viewbox>
              </Border>
              <StackPanel>
                <TextBlock Text="Insights" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="A visual summary of your activity, time, and focus." FontSize="11.5" Foreground="#3B4A5E"/>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#F6F9FC" BorderBrush="#D5E0EC" BorderThickness="1" CornerRadius="14" Padding="10,6" VerticalAlignment="Center">
              <TextBlock x:Name="InsightsDateText" Text="Today" FontSize="12" FontWeight="SemiBold"/>
            </Border>
          </Grid>

          <Border Background="#F8FAFD" BorderBrush="#CAD7E6" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Today at a Glance" FontSize="15.5" FontWeight="Bold" Margin="0,0,0,10"/>
              <UniformGrid Columns="4">
                <Border Background="#E8F2FF" CornerRadius="13" Padding="12" Margin="0,0,9,0"><StackPanel><TextBlock x:Name="InsightsTotalActivitiesText" Text="0" FontSize="20" FontWeight="Bold"/><TextBlock Text="Activities" FontSize="11.5" Foreground="#5D6A7C"/></StackPanel></Border>
                <Border Background="#F0EDFF" CornerRadius="13" Padding="12" Margin="0,0,9,0"><StackPanel><TextBlock x:Name="InsightsAppsUsedText" Text="0" FontSize="20" FontWeight="Bold"/><TextBlock Text="Apps Used" FontSize="11.5" Foreground="#5D6A7C"/></StackPanel></Border>
                <Border Background="#E8F7FB" CornerRadius="13" Padding="12" Margin="0,0,9,0"><StackPanel><TextBlock x:Name="InsightsActiveTimeText" Text="0m" FontSize="20" FontWeight="Bold"/><TextBlock Text="Active Time" FontSize="11.5" Foreground="#5D6A7C"/></StackPanel></Border>
                <Border Background="#FFF7E5" CornerRadius="13" Padding="12"><StackPanel><TextBlock x:Name="InsightsFavoritesText" Text="0" FontSize="20" FontWeight="Bold"/><TextBlock Text="Files &amp; Docs" FontSize="11.5" Foreground="#5D6A7C"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#F8FAFD" BorderBrush="#CAD7E6" BorderThickness="1" CornerRadius="18" Padding="14">
              <StackPanel>
                <TextBlock Text="Activity by App" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel x:Name="InsightsTopItemsPanel"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#F8FAFD" BorderBrush="#CAD7E6" BorderThickness="1" CornerRadius="18" Padding="14">
              <StackPanel>
                <TextBlock Text="Time Distribution" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel x:Name="InsightsDistributionPanel"/>
                <TextBlock x:Name="InsightsDistributionSummaryText" FontSize="11.5" Foreground="#405169" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#F8FAFD" BorderBrush="#CAD7E6" BorderThickness="1" CornerRadius="18" Padding="14">
              <StackPanel>
                <TextBlock Text="Activity Patterns" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                <UniformGrid Columns="2" Margin="0,0,0,10">
                  <Border Background="#EAF7FB" CornerRadius="11" Padding="10" Margin="0,0,7,0"><StackPanel><TextBlock Text="Peak Focus" FontSize="11.5" FontWeight="SemiBold"/><TextBlock x:Name="InsightsPeakTimeText" Text="—" FontSize="11.5" Foreground="#405169"/></StackPanel></Border>
                  <Border Background="#EAF7FB" CornerRadius="11" Padding="10"><StackPanel><TextBlock Text="Focus Streak" FontSize="11.5" FontWeight="SemiBold"/><TextBlock x:Name="InsightsFocusStreakText" Text="0m" FontSize="11.5" Foreground="#405169"/></StackPanel></Border>
                </UniformGrid>
                <Grid Height="110">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                  <UniformGrid x:Name="InsightsActivityChartPanel" Columns="24" Margin="0,2,0,4"/>
                  <TextBlock Grid.Row="1" Text="12 AM         4 AM         8 AM         12 PM         4 PM         8 PM" FontSize="8.5" Foreground="#46566B" TextAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#F8FAFD" BorderBrush="#CAD7E6" BorderThickness="1" CornerRadius="18" Padding="14">
              <StackPanel>
                <TextBlock Text="Key Takeaways" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="#EAF7FB" CornerRadius="11" Padding="10" Margin="0,0,0,7"><StackPanel><TextBlock Text="Most Active App" FontSize="11.5" FontWeight="SemiBold"/><TextBlock x:Name="InsightsMostActiveAppText" Text="—" FontSize="12"/><TextBlock x:Name="InsightsMostActiveAppSubtext" FontSize="11" Foreground="#405169"/></StackPanel></Border>
                <Border Background="#EEF2FF" CornerRadius="11" Padding="10" Margin="0,0,0,7"><StackPanel><TextBlock Text="Top Website / Work Type" FontSize="11.5" FontWeight="SemiBold"/><TextBlock x:Name="InsightsTopWebsiteText" Text="—" FontSize="12"/><TextBlock x:Name="InsightsTopWebsiteSubtext" FontSize="11" Foreground="#405169"/></StackPanel></Border>
                <Border Background="#FFF7E6" CornerRadius="11" Padding="10"><StackPanel><TextBlock Text="Quick Insight" FontSize="11.5" FontWeight="SemiBold"/><TextBlock x:Name="InsightsInsightText" Text="Your trail is still warming up." FontSize="11.5" Foreground="#405169" TextWrapping="Wrap"/></StackPanel></Border>
                <StackPanel Visibility="Collapsed">
                  <TextBlock x:Name="InsightsFocusTimeText"/><TextBlock x:Name="InsightsLongestSessionText"/>
