                <TextBox x:Name="AskMemoryTrailBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0"
                         FontSize="15" FontWeight="Normal" Foreground="#080D15"
                         KeyDown="AskMemoryTrailBox_KeyDown" ToolTip="What do you want to remember?"/>
                <Button x:Name="AskMemoryTrailButton" Grid.Column="2" Content="Search" Click="AskMemoryTrail_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Margin="12,0,0,0"/>
              </Grid>
            </Border>

            <TextBlock Text="Try asking" FontSize="12" FontWeight="SemiBold" Foreground="#35475E" Margin="0,13,0,9"/>
            <UniformGrid Columns="3" Rows="2">
              <Button Tag="What was I doing earlier today?" Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="12,10" HorizontalContentAlignment="Stretch">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="30" Height="30" CornerRadius="8" Background="#E8F2FF"><Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="M6,7 L2.8,10.2 L6,13.4" Stroke="#126FE8" StrokeThickness="2" Fill="Transparent"/><Path Data="M3.2,10.2 C4.8,5.8 10,3.5 14.5,5.3 C19,7.1 21,12.2 19.2,16.5 C17.8,19.8 14.6,21.5 11.4,21" Stroke="#126FE8" StrokeThickness="2" Fill="Transparent"/></Canvas></Viewbox></Border>
                  <TextBlock Grid.Column="1" Text="What was I doing earlier today?" FontSize="12.5" FontWeight="SemiBold" Foreground="#101827" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Tag="Show my activity from this week" Click="AskSuggestion_Click" Margin="0,0,8,8" Padding="12,10" HorizontalContentAlignment="Stretch">
