                  CornerRadius="19" Padding="21" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Local processing and storage" FontSize="17" FontWeight="SemiBold" Foreground="#121A2B"/>
              <TextBlock Text="Your activity history is sourced, processed, and stored locally on this PC. Memory Trail does not require a cloud account for its timeline."
                         Margin="0,6,0,0" Foreground="#31445F" TextWrapping="Wrap"/>
              <Border Background="#EAF7F0" BorderBrush="#CDE9D8" BorderThickness="1"
                      CornerRadius="12" Padding="11" Margin="0,12,0,0">
                <TextBlock Text="No timeline data is designed to be sent outside this computer."
                           Foreground="#247553" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </Border>
          <Border Background="#EDF3F8" BorderBrush="#C5D3E1" BorderThickness="1"
                  CornerRadius="19" Padding="21" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="No outside connectors" FontSize="17" FontWeight="SemiBold" Foreground="#121A2B"/>
              <TextBlock Text="Memory Trail's timeline is designed to operate locally and does not depend on external connectors or cloud services to capture, search, or display your activity."
