            <Border Width="48" Height="48" CornerRadius="14" Background="#F0EDFF" BorderBrush="#DFD8FF" BorderThickness="1" Margin="0,0,13,0">
              <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24">
