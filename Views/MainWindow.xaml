      <ScrollViewer x:Name="PrivacyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="Privacy" FontSize="31" FontWeight="Bold" Foreground="#121A2B"/>
