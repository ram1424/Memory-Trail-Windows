<Window x:Class="MemoryLane.Windows.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New in Memory Trail"
        Width="840" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#D7E4F3"
        FontFamily="Arial Rounded MT Bold, Arial Rounded MT, Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border Margin="18" CornerRadius="30" Padding="28" BorderBrush="#C7D6E7" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F3F8FF" Offset="0.55"/>
        <GradientStop Color="#E3EFFB" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Border Background="#F8FBFF" BorderBrush="#D7E3F0" BorderThickness="1" CornerRadius="22" Padding="18" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="68" Height="68" CornerRadius="18" Background="#FFFFFF" BorderBrush="#DBE6F0" BorderThickness="1">
            <Image x:Name="BrandLogo" Width="62" Height="62" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <Border Background="#E7F0FF" BorderBrush="#C7DBFA" BorderThickness="1" CornerRadius="10" Padding="9,4" HorizontalAlignment="Left">
              <TextBlock x:Name="VersionBadgeText" Text="VERSION 1.0" FontSize="11.5" FontWeight="Bold" Foreground="#2F72D8"/>
            </Border>
            <TextBlock Text="Your workday, remembered beautifully." FontSize="28" FontWeight="Bold" Foreground="#101827" Margin="0,7,0,0"/>
            <TextBlock x:Name="ReleaseSubtitleText" Text="The official Memory Trail 1.0 release" FontSize="14" Foreground="#405169" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <UniformGrid Columns="2" Margin="0,0,0,10">
            <Border Background="#EEF5FF" BorderBrush="#D2E2F7" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="TODAY" FontSize="10.5" FontWeight="Bold" Foreground="#2F7CF6"/>
                <TextBlock Text="See the trail as it happens" FontSize="16" FontWeight="Bold" Foreground="#101827" Margin="0,4,0,0"/>
                <TextBlock Text="A live, chronological view of apps, pages, emails, chats, files, and clipboard activity—with summaries and top apps." FontSize="12.5" Foreground="#405169" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#F2EFFF" BorderBrush="#DED7FB" BorderThickness="1" CornerRadius="18" Padding="16" Margin="6,0,0,0">
              <StackPanel>
                <TextBlock Text="ASK MEMORY TRAIL" FontSize="10.5" FontWeight="Bold" Foreground="#7357E8"/>
                <TextBlock Text="Search what you remember" FontSize="16" FontWeight="Bold" Foreground="#101827" Margin="0,4,0,0"/>
                <TextBlock Text="Find local history by time, app, subject, filename, page, or conversation. Results stay on your PC." FontSize="12.5" Foreground="#405169" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <UniformGrid Columns="3">
            <Border Background="#FFF6ED" BorderBrush="#F3DFC7" BorderThickness="1" CornerRadius="18" Padding="15" Margin="0,0,6,0">
              <StackPanel><TextBlock Text="Favorites" FontSize="15" FontWeight="Bold"/><TextBlock Text="Save important moments and return to them quickly." FontSize="12" Foreground="#405169" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="#ECF9F5" BorderBrush="#D2ECDF" BorderThickness="1" CornerRadius="18" Padding="15" Margin="6,0">
              <StackPanel><TextBlock Text="Clipboard History" FontSize="15" FontWeight="Bold"/><TextBlock Text="Keep copied text and links searchable when clipboard capture is enabled." FontSize="12" Foreground="#405169" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="#ECF8FB" BorderBrush="#D2EAF0" BorderThickness="1" CornerRadius="18" Padding="15" Margin="6,0,0,0">
              <StackPanel><TextBlock Text="Insights" FontSize="15" FontWeight="Bold"/><TextBlock Text="Understand activity patterns, app usage, active time, and focus from local history." FontSize="12" Foreground="#405169" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
            </Border>
          </UniformGrid>

          <Border Background="#F8FAFD" BorderBrush="#D6E0EA" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Privacy first" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Captured history is processed and stored locally. No Memory Trail account, analytics SDK, cloud timeline sync, or external data connector is required." FontSize="12" Foreground="#405169" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Built for daily use" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Pause capture, exclude apps, export local history, clear retention ranges, run from the tray, and optionally start with Windows." FontSize="12" Foreground="#405169" TextWrapping="Wrap" Margin="0,5,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ReleaseFooterText" Text="Memory Trail 1.0" Foreground="#52637A" FontSize="12" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="View Changelog" Click="ViewChangelog_Click" Margin="0,0,9,0"/>
        <Button Grid.Column="2" Content="Get Started" Style="{StaticResource PrimaryButtonStyle}" Click="GotIt_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>