<Window x:Class="MemoryLane.Windows.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New in Memory Trail"
        Width="760" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#DCE6F2"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border Margin="18" BorderBrush="#C3D0DE" BorderThickness="1" CornerRadius="26" Padding="26">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F5F8FC" Offset="0"/>
        <GradientStop Color="#E8EFF7" Offset="0.6"/>
        <GradientStop Color="#DCE7F4" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="74" Height="74" CornerRadius="20" Background="#FFFFFF" BorderBrush="#D8E3EE" BorderThickness="1">
          <Image x:Name="BrandLogo" Width="68" Height="68" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Border Background="#DCEBFF" BorderBrush="#B9D3F6" BorderThickness="1" CornerRadius="10" Padding="9,4" HorizontalAlignment="Left">
            <TextBlock x:Name="VersionBadgeText" Text="VERSION 1" FontSize="11.5" FontWeight="Bold" Foreground="#176DFF"/>
          </Border>
          <TextBlock Text="Fresh tracks, same trail." FontSize="30" FontWeight="Bold" Foreground="#121A2B" Margin="0,7,0,0"/>
          <TextBlock x:Name="ReleaseSubtitleText" Text="Latest Memory Trail release" FontSize="15" FontWeight="SemiBold" Foreground="#31445F" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="#EEF6FF" BorderBrush="#C9DDF6" BorderThickness="1" CornerRadius="15" Padding="14" Margin="0,0,0,9">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="12" Background="#DDEBFF"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#176DFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="Insights got a real dashboard" FontSize="15" FontWeight="SemiBold" Foreground="#121A2B"/><TextBlock Text="Insights now shows activity rhythm, peak time, focus streaks, top apps, category distribution, and a quick summary built from your real local timeline." FontSize="13" Foreground="#35475E" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0"/></StackPanel>
            </Grid>
          </Border>

          <Border Background="#F8FBFF" BorderBrush="#D9E5F0" BorderThickness="1" CornerRadius="15" Padding="14" Margin="0,0,0,9">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="12" Background="#E2EEFF"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#176DFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="Your data controls grew up" FontSize="15" FontWeight="SemiBold" Foreground="#121A2B"/><TextBlock Text="Settings now shows exactly where capture data lives, lets you open the folder, export your activity, and clear the last week, last month, or everything." FontSize="13" Foreground="#35475E" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0"/></StackPanel>
            </Grid>
          </Border>

          <Border Background="#F8FBFF" BorderBrush="#D9E5F0" BorderThickness="1" CornerRadius="15" Padding="14" Margin="0,0,0,9">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="12" Background="#E8EDFF"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#5E69DB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="Sharper signs along the trail" FontSize="15" FontWeight="SemiBold" Foreground="#121A2B"/><TextBlock Text="Typography and text contrast were tuned for crisper WPF rendering while keeping the Memory Trail look and colors intact." FontSize="13" Foreground="#35475E" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0"/></StackPanel>
            </Grid>
          </Border>

          <Border Background="#F8FBFF" BorderBrush="#D9E5F0" BorderThickness="1" CornerRadius="15" Padding="14" Margin="0,0,0,9">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="12" Background="#E7F5F0"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#29956E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="Startup finally listens" FontSize="15" FontWeight="SemiBold" Foreground="#121A2B"/><TextBlock Text="Memory Trail includes manual and optional automatic update checking, plus a What's New experience so future improvements are easy to discover." FontSize="13" Foreground="#35475E" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0"/></StackPanel>
            </Grid>
          </Border>

          <Border Background="#F8FBFF" BorderBrush="#D9E5F0" BorderThickness="1" CornerRadius="15" Padding="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="12" Background="#E4EEFF"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#5573ED" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1"><TextBlock Text="Updates learned a personality" FontSize="15" FontWeight="SemiBold" Foreground="#121A2B"/><TextBlock Text="Up-to-date, update-available, and post-update screens now have a little wit. Software maintenance does not have to sound like a printer manual." FontSize="13" Foreground="#35475E" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0"/></StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ReleaseFooterText" Text="Memory Trail" Foreground="#46566B" FontSize="12" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="View Changelog" Click="ViewChangelog_Click" Margin="0,0,9,0"/>
        <Button Grid.Column="2" Content="Get Started" Style="{StaticResource PrimaryButtonStyle}" Click="GotIt_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
