<Window x:Class="MemoryLane.Windows.HistoryClearWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Trail — Clear History"
        Width="610" Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#EEF3F9"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Border Margin="12" Background="#F8FAFD" BorderBrush="#CBD7E5" BorderThickness="1"
          CornerRadius="24" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="ConfirmPanel">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Width="142" Height="142" HorizontalAlignment="Center">
          <Ellipse Fill="#E5EEFF"/>
          <Ellipse Width="106" Height="106" Fill="#FFFFFF" Stroke="#D0DDF0" StrokeThickness="1"/>
          <TextBlock x:Name="GraphicGlyph" Text="7" FontSize="44" FontWeight="Bold" Foreground="#176DFF"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,8"
                  Background="#172238" CornerRadius="10" Padding="8,4">
            <TextBlock x:Name="GraphicBadgeText" Text="DAY SWEEP" Foreground="White" FontSize="8.5" FontWeight="Bold"/>
          </Border>
        </Grid>

        <TextBlock x:Name="PromptTitleText" Grid.Row="1" Text="Sweep the last week?"
                   FontSize="25" FontWeight="Bold" Foreground="#121A2B"
                   HorizontalAlignment="Center" Margin="0,17,0,0"/>
        <TextBlock x:Name="PromptBodyText" Grid.Row="2"
                   Text="Seven days of footprints are about to vanish. Tiny broom, big responsibility."
                   FontSize="12.5" Foreground="#52637A" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" MaxWidth="470" Margin="0,8,0,0"/>
        <Border Grid.Row="3" Background="#EEF4FB" BorderBrush="#D9E3EE" BorderThickness="1"
                CornerRadius="12" Padding="12" Margin="0,16,0,0" VerticalAlignment="Top">
          <TextBlock x:Name="CountText" Text="0 items will be removed."
                     FontSize="10.5" Foreground="#31445F" TextAlignment="Center"/>
        </Border>
      </Grid>

      <Grid x:Name="SuccessPanel" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center">
          <Grid Width="150" Height="150" HorizontalAlignment="Center">
            <Ellipse Fill="#E8F8EF"/>
            <Ellipse Width="108" Height="108" Fill="#34C57A"/>
            <TextBlock Text="✓" FontSize="56" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0"/>
            <TextBlock Text="✦" Foreground="#176DFF" FontSize="24"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,13,0,0"/>
            <TextBlock Text="✦" Foreground="#E3A629" FontSize="18"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,14"/>
          </Grid>

          <TextBlock x:Name="SuccessTitleText" Text="Trail swept clean."
                     FontSize="26" FontWeight="Bold" Foreground="#121A2B"
                     HorizontalAlignment="Center" Margin="0,16,0,0"/>
          <TextBlock x:Name="SuccessBodyText" Text="Last week is officially yesterday’s problem."
                     FontSize="12.5" Foreground="#52637A" TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center" MaxWidth="470" Margin="0,8,0,0"/>
          <Border Background="#EAF7F0" BorderBrush="#CDE9D8" BorderThickness="1"
                  CornerRadius="12" Padding="11" Margin="58,18,58,0">
            <TextBlock x:Name="RemovedText" Text="0 items removed." FontSize="10.5"
                       Foreground="#247553" FontWeight="SemiBold" TextAlignment="Center"/>
          </Border>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Width="105"
                Margin="0,0,9,0" Click="Cancel_Click"/>
        <Button x:Name="ConfirmButton" Grid.Column="2" Content="Clear last week" Width="145"
                Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click"/>
        <Button x:Name="DoneButton" Grid.Column="2" Content="Nice. Close this." Width="145"
                Style="{StaticResource PrimaryButtonStyle}" Click="Done_Click" Visibility="Collapsed"/>
      </Grid>
    </Grid>
  </Border>
</Window>
