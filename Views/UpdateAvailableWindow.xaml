<Window x:Class="MemoryLane.Windows.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Trail Update"
        Width="720" Height="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#DCE6F2"
        FontFamily="Segoe UI">
  <Border Margin="18" Background="#EEF3F8" BorderBrush="#C6D3E1" BorderThickness="1"
          CornerRadius="24" Padding="24"><Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="76"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Width="64" Height="64" CornerRadius="18" Background="#FFFFFF"
                BorderBrush="#D9E3EE" BorderThickness="1">
          <Image x:Name="BrandLogo" Width="58" Height="58" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Border Background="#DDEBFF" BorderBrush="#BCD5F5" BorderThickness="1"
                  CornerRadius="10" Padding="9,4" HorizontalAlignment="Left">
            <TextBlock Text="UPDATE AVAILABLE" FontSize="9.5" FontWeight="Bold" Foreground="#176DFF"/>
          </Border>
          <TextBlock x:Name="ReleaseNameText"
                     Text="A new Memory Trail update is available"
                     FontSize="22" FontWeight="Bold" Foreground="#121A2B" Margin="0,8,0,0"/>
          <TextBlock Text="Choose when you want Memory Trail to handle this release."
                     Foreground="#52637A" FontSize="11.5" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,20,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="34"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#E6EDF5" BorderBrush="#D1DDE9" BorderThickness="1"
                CornerRadius="14" Padding="14">
          <StackPanel>
            <TextBlock Text="Current version" FontSize="10.5" Foreground="#52637A"/>
            <TextBlock x:Name="CurrentVersionText" FontSize="16" FontWeight="SemiBold"
                       Foreground="#121A2B" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Grid.Column="1" Text="→" FontSize="19" Foreground="#52637A"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Border Grid.Column="2" Background="#E1EEFF" BorderBrush="#BDD5F6"
                BorderThickness="1" CornerRadius="14" Padding="14">
          <StackPanel>
            <TextBlock Text="Available" FontSize="10.5" Foreground="#4A6D9B"/>
            <TextBlock x:Name="LatestVersionText" FontSize="16" FontWeight="SemiBold"
                       Foreground="#176DFF" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="#F8FBFF" BorderBrush="#DCE6F0"
              BorderThickness="1" CornerRadius="16" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="What’s new" FontSize="13.5" FontWeight="SemiBold"
                     Foreground="#121A2B" Margin="0,0,0,10"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ReleaseNotesText" Foreground="#52647D" FontSize="12.2"
                       TextWrapping="Wrap" LineHeight="19"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Row="3" Background="#E9F4FF" BorderBrush="#C8DDF5"
              BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,14,0,0"
              ClipToBounds="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                     Foreground="#176DFF" VerticalAlignment="Top" Margin="0,1,0,0"/>

          <TextBlock Grid.Column="1"
                     Text="Update downloads quietly in the background. When it is ready, Memory Trail briefly restarts itself, installs the update, and opens again automatically."
                     Foreground="#31445F"
                     FontSize="11.5"
                     TextWrapping="Wrap"
                     TextTrimming="None"
                     LineHeight="17"
                     MaxWidth="600"
                     HorizontalAlignment="Stretch"/>
        </Grid>
      </Border>

      <Grid Grid.Row="4" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="Skip This Version"
                Click="Skip_Click" Margin="0,0,9,0"/>
        <TextBlock Grid.Column="1"
                   Text="You can always check again from Settings."
                   Foreground="#7A8798" FontSize="10.5"
                   VerticalAlignment="Center" Margin="4,0,12,0"/>
        <Button Grid.Column="2" Content="Remind Me in 24 Hours"
                Click="RemindLater_Click" Margin="0,0,9,0"/>
        <Button Grid.Column="3" Content="Update"
                Style="{StaticResource PrimaryButtonStyle}" Click="Update_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
