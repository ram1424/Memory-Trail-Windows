<Window x:Class="MemoryLane.Windows.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Trail Update"
        Width="650" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#DCE6F2"
        FontFamily="Segoe UI Variable Text">
  <Border Margin="18" Background="#EEF3F8" BorderBrush="#C6D3E1" BorderThickness="1"
          CornerRadius="24" Padding="24">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.15" Color="#30445F"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="64" Height="64" CornerRadius="18" Background="#FFFFFF" BorderBrush="#D9E3EE" BorderThickness="1">
          <Image x:Name="BrandLogo" Width="58" Height="58" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Border Background="#DDEBFF" BorderBrush="#BCD5F5" BorderThickness="1" CornerRadius="10" Padding="9,4" HorizontalAlignment="Left">
            <TextBlock Text="UPDATE AVAILABLE" FontSize="9.5" FontWeight="Bold" Foreground="#176DFF"/>
          </Border>
          <TextBlock x:Name="ReleaseNameText" Text="A new Memory Trail update is available" FontSize="22" FontWeight="Bold" Foreground="#1A2438" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,20,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#E6EDF5" BorderBrush="#D1DDE9" BorderThickness="1" CornerRadius="14" Padding="14">
          <StackPanel><TextBlock Text="Current version" FontSize="10.5" Foreground="#66778F"/><TextBlock x:Name="CurrentVersionText" FontSize="16" FontWeight="SemiBold" Foreground="#1A2438" Margin="0,3,0,0"/></StackPanel>
        </Border>
        <TextBlock Grid.Column="1" Text="→" FontSize="19" Foreground="#66778F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border Grid.Column="2" Background="#E1EEFF" BorderBrush="#BDD5F6" BorderThickness="1" CornerRadius="14" Padding="14">
          <StackPanel><TextBlock Text="Available" FontSize="10.5" Foreground="#4A6D9B"/><TextBlock x:Name="LatestVersionText" FontSize="16" FontWeight="SemiBold" Foreground="#176DFF" Margin="0,3,0,0"/></StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="2" Background="#F8FBFF" BorderBrush="#DCE6F0" BorderThickness="1" CornerRadius="16" Padding="16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Release notes" FontSize="13.5" FontWeight="SemiBold" Foreground="#1A2438" Margin="0,0,0,10"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReleaseNotesText" Foreground="#52647D" FontSize="12.2" TextWrapping="Wrap" LineHeight="19"/></ScrollViewer>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Downloads open through your default browser." Foreground="#7A8798" FontSize="10.5" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Later" Click="Later_Click" Margin="0,0,9,0"/>
        <Button Grid.Column="2" Content="Download Update" Style="{StaticResource PrimaryButtonStyle}" Click="Download_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
